:: Story Stylesheet [stylesheet]
/* ============================================================
   IMPORTS, FONTFACE & PALETTE
   ============================================================ */
@import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

@font-face {
  font-family: 'Pixelta';
  src: url('assets/fonts/Pixelta.ttf') format('truetype');
}

@font-face {
  font-family: 'Dico';
  src: url('assets/fonts/Dico.ttf') format('truetype');
}

@font-face {
  font-family: 'PokemonXY';
  src: url('assets/fonts/PokemonXandY.ttf') format('truetype');
}

@font-face {
  font-family: 'Pixely';
  src: url('assets/fonts/Pixely.ttf') format('truetype');
}

@font-face {
  font-family: 'ZX_Spectrum_7';
  src: url('assets/fonts/zx_spectrum-7.ttf') format('truetype');
}

@font-face {
  font-family: 'cozy-quill';
  src: url('assets/fonts/cozy-quill.ttf') format('truetype');
}

@font-face {
  font-family: 'leviwindows';
  src: url('assets/fonts/leviwindows.ttf') format('truetype');
}

@font-face {
  font-family: 'zeldadxt';
  src: url('assets/fonts/zeldadxt.ttf') format('truetype');
}

@font-face {
  font-family: 'reindeer-modern';
  src: url('assets/fonts/reindeer-modern.ttf') format('truetype');
}

@font-face {
  font-family: 'Game-Font';
  src: url('assets/fonts/Game-Font.ttf') format('truetype');
}

@font-face {
  font-family: 'NorthernSans';
  src: url('assets/fonts/NorthernSans.ttf') format('truetype');
}

@font-face {
  font-family: 'Wyvern';
  src: url('assets/fonts/Wyvern.TTF') format('truetype');
}

:root {
  --bg-main: #CEC19F;         /* creamy latte */
  --bg-panel: #d6bba2;        /* espresso shot */
  --text-main: #35241d;       /* warm cappuccino */
  --text-muted: #785136;      /* mocha bean */
  --accent-thought: #7f9b8a;  /* sage, kept as accent */
  --accent-thought-dim: #5e7364;
}

body.scene-night {
  --bg-main: #10151f;
  --bg-panel: #1b2433;
  --text-main: #c7ccd6;
  --text-muted: #8891a0;
}

/* ============================================================
   BASE / LAYOUT LOCK / CURSOR
   ============================================================ */
html, body {
  height: 100%;
  overflow: hidden;
}

body {
  background-color: var(--bg-main);
  color: var(--text-main);
  font-family: 'VT323', monospace;
  font-size: 1.4em;
  line-height: 1.6;
  cursor: url('https://i.imgur.com/wzWTLc0.png') 1 1, auto;
}

* {
  box-sizing: border-box;
}

a, .dialogue-prompt a, .chat-line a, .select-row a, .scene-nav a, .continue-link a {
  cursor: url('https://i.imgur.com/4IkfO8y.png') 8 2, pointer;
}

tw-story a.link-internal { text-decoration: none; }

body.title-mode .menu-screen {
  margin-left: 0;
  left: 50%;
}

body.title-mode #ui-bar {
  display: none !important;
}
body.title-mode #screen-clock {
  display: none !important;
}
body.title-mode #story {
  margin-left: 0 !important;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image: url('assets/ui/TitleScreen_V001.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0.15;
  z-index: -1;
  pointer-events: none;
}

/* ============================================================
   DEBUG PANEL
   ============================================================ */
#debug-panel {
  position: fixed;
  bottom: 1em;
  left: calc(clamp(10em, 13vw, 15em) + 1em);
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.6em 1em;
  border-radius: 6px;
  font-size: 0.75em;
  z-index: 9999;
  max-width: 260px;
  line-height: 1.5;
}
.debug-title {
  font-size: 0.85em;
  letter-spacing: 1px;
  color: var(--text-muted);
  margin-bottom: 0.3em;
  border-bottom: 1px dashed var(--text-muted);
  padding-bottom: 0.2em;
}
.debug-row {
  display: flex;
  justify-content: space-between;
  gap: 1em;
}

#debug-toggle {
  position: fixed;
  bottom: 1em;
  right: 8.5em;
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.4em 0.9em;
  border-radius: 6px;
  font-family: 'VT323', monospace;
  font-size: 0.85em;
  cursor: pointer;
  z-index: 9999;
  letter-spacing: 1px;
}
#debug-toggle.active {
  background-color: rgba(159, 184, 173, 0.3);
  border-color: var(--accent-thought);
}



/* ============================================================
   SIDEBAR / UI BAR / STORY TITLE / CONTINUE ARROW 
   ============================================================ */
#story-title {
  font-size: 0;
}
#story-title::after {
  content: "written & designed by titikormetsi studios";
  font-size: 1em;
  font-family: 'Pixelta', monospace;
}

#story {
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  margin: 0 !important;
  margin-left: clamp(10em, 13vw, 15em) !important;
  padding: 0.5em clamp(1em, 2vw, 2em);
  transition: none !important;
}

#menu a,
#menu-item-saves,
#menu-item-restart {
  font-family: 'Pixelta', monospace;
}

#ui-bar-toggle {
  display: none !important;
}

#ui-bar {
  width: clamp(10em, 13vw, 15em) !important;
  background-color: var(--bg-panel);
  background-image: none;
  background-size: 100% 100%;
  background-position: center;
  background-repeat: no-repeat;
  border-right: 1px solid var(--text-main);
  overflow-y: auto;
}

body.scene-night #ui-bar {
  background-image: url('assets/ui/UIBar_Night.png');
}

#angel-status {
  margin-top: 1.5em;
  padding-top: 1em;
  border-top: 1px solid var(--text-muted);
  text-align: left;
}

.status-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 0.8em;
}

.status-label {
  font-family: 'Pixelta', monospace;
  font-size: 0.7em;
  letter-spacing: 1px;
  color: rgb(53, 36, 29);
}

.status-value {
  font-family: 'Pixelta', monospace;
  font-size: 1em;
  color: rgb(53, 36, 29);
}

.status-sub {
  font-size: 0.75em;
  color: rgb(53, 36, 29);
}

.continue-arrow {
  display: inline-block;
  width: 7px;
  height: 14px;
  background-image: url('assets/ui/SkipArrowB_V001.png');
  background-size: 100% 100%;
  image-rendering: pixelated;
}

#dialoguePrompt > a, .dialogue-prompt a, .expand-continue {
  font-size: 0;
}
#dialoguePrompt > a::after, .dialogue-prompt a::after, .expand-continue::after {
  content: "";
  display: inline-block;
  width: 7px;
  height: 14px;
  background-image: url('assets/ui/SkipArrowB_V001.png');
  background-size: 100% 100%;
  image-rendering: pixelated;
}

#volume-panel {
  margin-top: 1em;
  padding-top: 1em;
  border-top: 1px solid var(--text-muted);
}
.volume-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 0.6em;
}
.volume-row label {
  font-size: 0.7em;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  margin-bottom: 0.2em;
}
.volume-row input[type="range"] {
  width: 100%;
  accent-color: var(--text-main);
}

/* ============================================================
   TOP-RIGHT SCREEN CLOCK
   ============================================================ */
#screen-clock {
  position: fixed;
  top: 1em;
  right: 1.5em;
  text-align: right;
  z-index: 100;
  pointer-events: none;
}

#screen-clock .clock-time {
  font-size: 1.3em;
  color: var(--text-main);
  letter-spacing: 1px;
}

#screen-clock .clock-date {
  font-size: 0.75em;
  color: var(--text-muted);
  margin-top: 0.1em;
}

/* ============================================================
   TITLE / MENU SCREENS
   ============================================================ */
.menu-screen {
  font-family: 'Pixelta', monospace;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin-left: clamp(6em, 7.5vw, 10em);
  width: 90%;
  max-width: 700px;
}

.menu-text {
  min-height: 3em;
}

.menu-text p {
  max-width: 32em;
  margin: 0 0 1.2em 0;
}

.menu-title {
  font-size: 2em;
  letter-spacing: 1px;
  margin-bottom: 0.5em;
}

.menu-subtitle a, .continue-link a {
  font-size: 1.3em;
  color: var(--text-main);
}

.menu-subtitle a:hover, .continue-link a:hover {
  color: var(--text-muted);
}

.title-lines {
  text-align: center;
}
.title-line {
  font-size: 1em;
  margin-bottom: 0.8em;
}
.title-line-main {
  font-size: 2em;
  letter-spacing: 1px;
}

#dialogueLine {
  display: block;
  text-align: center;
}

#dialoguePrompt {
  display: block;
  text-align: center;
  margin-top: 1.5em;
}

@keyframes talk-wobble {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-2px) rotate(-1deg); }
  75% { transform: translateY(1px) rotate(1deg); }
}
.speaker-box img.talking {
  animation: talk-wobble 0.15s steps(2) infinite;
}

#titleBackdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('https://imgur.com/q0uNbFy.png');
  background-size: cover;
  background-position: center;
  opacity: 0;
  transition: opacity 2.5s ease;
  z-index: -1;
}

#titleBackdrop.visible {
  opacity: 1;
}

.title-highlight {
  display: inline-block;
  background-color: #CEC19F;
  padding: 0.3em 0.8em;
  border-radius: 4px;
  position: relative;
}

.title-highlight::before {
  content: "";
  position: absolute;
  inset: 0;
  background-color: #CEC19F;
  opacity: 0.4;
  border-radius: 4px;
  z-index: -1;
}
/* ============================================================
   QUOTE BOX (AA Big Book passages)
   ============================================================ */
.quote-box {
  width: 100%;
  max-width: 650px;
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: 1.5em 2em;
  margin: 0 auto;
  text-align: left;
  line-height: 1.5;
  max-height: 60vh;
  overflow-y: auto;
}

.quote-box p {
  margin: 0 0 0.9em 0;
}

.quote-box .quote-prompt {
  text-align: center;
  margin-top: 0.75em;
}

.book-wrapper {
  display: flex;
  justify-content: center;
  padding: 1.5em 0;
}

.book {
  display: flex;
  width: 100%;
  max-width: 850px;
  min-height: 420px;
  background-color: var(--bg-panel);
  border: 4px solid var(--text-main);
  box-shadow:
    inset 0 0 0 2px var(--bg-main),
    inset 0 0 0 4px var(--text-main);
}

.book-page {
  flex: 1;
  padding: 2em 1.8em;
  box-sizing: border-box;
}

.book-page-left {
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0px,
    transparent 26px,
    rgba(205, 193, 159, 0.08) 26px,
    rgba(205, 193, 159, 0.08) 27px
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.book-page-left::before {
  content: "❧";
  font-size: 2.5em;
  color: var(--accent-thought-dim);
  opacity: 0.5;
}

.book-spine {
  width: 14px;
  flex-shrink: 0;
  background-image: repeating-linear-gradient(
    to bottom,
    var(--text-main) 0px,
    var(--text-main) 8px,
    var(--bg-main) 8px,
    var(--bg-main) 16px
  );
}

.book-page-right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: left;
  line-height: 1.5;
}

.book-page-right p {
  margin: 0 0 0.9em 0;
}

/* ============================================================
   MEMBER SELECTION (split-screen carousel)
   ============================================================ */
.split-screen {
  display: flex;
  gap: clamp(0.5em, 1.5vw, 1.5em);
  justify-content: flex-start;
  align-items: flex-start;
  margin: clamp(1em, 2vh, 2em) 0 clamp(1em, 2vh, 2em) clamp(1em, 2vw, 2em);
}

.scene-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.scene-box {
  width: clamp(500px, 82vh, 950px);
  height: clamp(350px, 70vh, 820px);
  border: 3px dashed var(--text-main);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 1em;
  text-align: center;
  background-image: url('assets/AASEAT_V003.png');
  background-size: cover;
  background-position: center;
}

.scene-box img, .speaker-box img {
  width: 80%;
  max-width: 200px;
  image-rendering: pixelated;
  margin-bottom: 0.5em;
}

.scene-nav {
  margin-top: 1em;
  display: flex;
  justify-content: center;
  gap: 3em;
}

.scene-nav a {
  font-size: 1.6em;
  color: var(--text-main);
  text-decoration: none;
}

.scene-nav a:hover {
  color: var(--text-muted);
}

.card-box {
  width: clamp(500px, 82vh, 950px);
  height: clamp(450px, 70vh, 700px);
  border: 3px dashed var(--text-main);
  padding: clamp(0.5em, 1vw, 0.8em);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.card-box {
  overflow-y: auto;
  overflow-x: hidden;
}

.card-box .card-field {
  font-family: 'Pixelta', monospace;
  flex-shrink: 0;
  border-bottom: 1px dashed var(--text-muted);
  padding: 0.03em 0;
  margin: 0 -0.6em;
  padding-left: 0.3em;
  padding-right: 0.3em;
  color: var(--text-muted);
  font-size: 0.7em;
  line-height: 1.2;
}

.card-box .card-field br {
  display: none;
}

.card-box .card-story {
  font-family: 'Pixelta', monospace;
  font-size: 0.78em;
  line-height: 1.25;
  flex-shrink: 1;
  flex-grow: 1;
  min-height: 80px;
  border-top: 1px dashed var(--text-muted);
  margin-top: 0.4em;
  padding-right: 0.5em;
  padding-top: 0.3em;
  box-sizing: border-box;
  overflow-y: auto;
  overflow-x: hidden;
}

/* .card-box .card-story::-webkit-scrollbar {
  width: 8px;
} */

/* .card-box .card-story::-webkit-scrollbar-track {
  background: transparent;
} */

/* .card-box .card-story::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
} */

.card-label {
  font-family: 'Pixelta', monospace;
  font-size: 0.75em;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0em;
}

.select-row {
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 0.5em;
  text-align: center;
}

.select-row a {
  color: var(--text-main);
  font-size: 1.1em;
}

.select-row a:hover {
  color: var(--text-muted);
}

.select-row-inline {
  display: inline-flex;
  align-items: center;
}
.select-row-inline a {
  font-family: 'Pixelta', monospace;
  font-size: 0.7em;
  color: var(--text-main);
}
.select-row-inline a:hover {
  color: var(--text-muted);
}

.locked-label {
  color: #666;
  font-size: 1em;
  letter-spacing: 1px;
}

.card-new-badge {
  display: inline-block;
  width: 16px;
  height: 16px;
  background-image: url('assets/UnreadDot_V002.png');
  background-size: contain;
  background-repeat: no-repeat;
  margin-left: 0.5em;
  vertical-align: middle;
}

/* ============================================================
   OPENING LAYOUT WRAPPER + NARRATIVE BOX (shared by scenes)
   ============================================================ */
.opening-layout {
  width: calc(100% - 2em);
  max-width: 1700px;
  height: calc(100vh - 1em);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

.opening-meeting {
  width: 95%;
  max-width: 1400px;
}

.narrative-box {
  width: 100%;
  max-width: 650px;
  margin: 0 auto 0.5em;
  flex-shrink: 0;
  padding: clamp(0.4em, 1vh, 0.7em) clamp(1em, 2vw, 2em);
  text-align: center;
   font-size: 0.6em;
  font-family: 'PokemonXY', monospace;
  border-style: solid;
  border-width: 20px;
  border-color: transparent;
  border-image-source: url('assets/ui/DialogueBoxA_V004.png');
  border-image-slice: 33 fill;
  border-image-width: 20px;
  border-image-repeat: stretch;
  image-rendering: pixelated;
}

.narrative-box .chapter-heading {
  font-size: 1em;
  letter-spacing: 2px;
  font-family: 'Pixelta', monospace;
  color: var(--text-main);
  margin-bottom: 0.3em;
}

.narrative-box .meeting-time {
  font-size: 1em;
  letter-spacing: 1px;
  font-family: 'Pixelta', monospace;
  color: var(--text-muted);
  margin-bottom: 0.5em;
}

/* ============================================================
   CONVERSATION ROW (two-speaker face-to-face scenes)
   ============================================================ */
.conversation-row {
  display: flex;
  align-items: stretch;
  gap: clamp(0.5em, 1.5vw, 1.5em);
  flex: 1 1 auto;
  min-height: 0;
}

.conversation-row.solo {
  justify-content: center;
}

.conversation-row.solo .chat-log {
  width: 700px;
  flex-grow: 0;
}

.speaker-box {
  width: clamp(90px, 12vw, 260px);
  height: 100%;
  border: 3px dashed var(--text-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: clamp(0.65em, 1vw, 0.9em);
  text-align: center;
  flex-shrink: 0;
  opacity: 0.4;
  transition: opacity 0.3s ease;
}

.speaker-box.speaking {
  opacity: 1;
}

.speaker-name {
  color: inherit;
}

.chat-log {
  flex-grow: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  gap: 1em;
  padding: clamp(0.8em, 1.5vw, 1.5em);
  border-style: solid;
  border-width: 40px;
  border-color: transparent;
  border-image-source: url('assets/ui/DialogueBoxB_V004.png');
  border-image-slice: 40 fill;
  border-image-width: 40px;
  border-image-repeat: stretch;
  image-rendering: pixelated;
}

.chat-log::-webkit-scrollbar {
  width: 8px;
}

.chat-log::-webkit-scrollbar-track {
  background: transparent;
}

.chat-log::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
}

/* ============================================================
   CHAT LINE TYPES (dialogue / action / thought / spacer / citation)
   ============================================================ */
.chat-line {
  max-width: 85%;
  padding: 0.6em 1em;
  border-radius: 8px;
}

.chat-line a {
  color: inherit;
  text-decoration: none;
}

.chat-line a:hover {
  color: var(--text-muted);
}

.chat-line.player {
  font-family: 'reindeer-modern', monospace;
  font-size: 0.8em;
  align-self: flex-start;
  text-align: left;
  background-color: rgba(42, 61, 20, 0.6);
  border: 1px solid var(--text-main);
}

.chat-line.character {
  align-self: flex-end;
  text-align: right;
  background-color: rgba(205, 193, 159, 0.1);
}

.font-guardian-angel {
  font-family: 'reindeer-modern', monospace;
  font-size: 0.8em;
}

.chat-line.character.font-guardian-angel {
  font-family: 'reindeer-modern', monospace;
}

.chat-line.font-erin {
  font-family: 'Game-Font', monospace;
  font-size: 1.5em;  
}

.chat-line.font-anesu {
  font-family: 'NorthernSans', monospace;
  font-size: 1em;
}

.chat-line.font-mama {
  font-family: 'Wyvern', monospace;
}

.chat-line.font-dad {
  font-family: 'Dico', monospace;
}

.chat-line.font-micah {
  font-family: 'ZX_Spectrum_7', monospace;
}

#namePromptBox input[type="text"] {
  font-family: 'reindeer-modern', monospace;
  font-size: 0.8em;
  background-color: transparent;
  border: none;
  border-bottom: 1px solid var(--text-main);
  color: var(--text-main);
}

.chat-choices {
  margin-top: 1em;
  text-align: center;
}

.chat-action {
  align-self: center;
  max-width: 90%;
  text-align: center;
  font-family: 'LeviWindows', monospace;
  color: var(--text-muted);
  font-size: 0.85em;
  margin: 0.3em 0;
}
.chat-action.action-italic {
  font-family: 'ZeldaDX', monospace;
  font-style: italic;
}
.chat-spacer {
  height: 1.5em;
}

.chat-citation {
  align-self: center;
  max-width: 90%;
  text-align: center;
  font-style: italic;
  color: var(--text-muted);
  font-size: 0.75em;
  letter-spacing: 0.5px;
  margin: 1.5em 0 0 0;
}

.chat-timestamp {
  font-size: 0.65em;
  color: var(--text-muted);
  margin-top: 0.2em;
  opacity: 0.7;
}

.continue-link {
  align-self: center;
  text-align: center;
  margin-top: 1.5em;
  padding-top: 1em;
}

.continue-link a {
  color: var(--text-main);
  font-size: 1.1em;
  text-decoration: underline;
  text-decoration-color: var(--accent-thought-dim);
  text-underline-offset: 3px;
}

.continue-link a:hover {
  color: var(--text-muted);
}


/* ============================================================
  HYPERLINK COLOURS
   ============================================================ */
.chat-line a, .dialogue-prompt a {
  color: var(--text-main);
  text-decoration: underline;
  text-decoration-color: var(--accent-thought-dim);
  text-underline-offset: 3px;
}

.chat-line a:hover, .dialogue-prompt a:hover {
  color: var(--accent-thought);
}

.expand-text {
  border-bottom: 1px dotted var(--accent-thought-dim);
}

.choice-reveal-group {
  display: flex;
  flex-direction: column;
  gap: 0.3em;
}

.choice-summary {
  padding: 0.4em 0.8em;
  transition: opacity 0.5s ease;
}

/* ============================================================
   THOUGHT BUBBLES (wavy animation)
   ============================================================ */
.chat-thought {
  font-family: 'zeldadxt', monospace;
  font-size: 0.7em;
  align-self: flex-start;
  text-align: left;
  font-style: italic;
  color: var(--accent-thought);
  max-width: 75%;
  padding: 0 1em;
  position: relative;
}

.chat-thought .thought-label {
  font-family: 'zeldadxt', monospace;
  font-size: 0.75em;
  font-style: normal;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0.2em;
  display: block;
}

.chat-thought .thought-text {
  display: inline-block;
}

.chat-thought .thought-text span {
  display: inline-block;
  animation: thought-wave 2.2s ease-in-out infinite;
}

@keyframes thought-wave {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

/* ============================================================
   PHONE / TEXTING SCENE
   ============================================================ */
.phone-frame {
  width: 400px;
  background-color: var(--bg-panel);
  background-image: url('assets/ui/PhoneScreenB_V004.png');
  background-size: 100% 100%;
  background-repeat: no-repeat;
  border: 3px solid var(--text-main);
  border-radius: 12px;
  padding: 2em 1.5em;
  display: flex;
  flex-direction: column;
  gap: 0.6em;
  min-height: 700px;
  max-height: 700px;
  overflow-y: auto;
}

.phone-frame > .continue-link {
  position: static;   /* ignore the general continue placement */
  margin-top: auto;   /* push to the bottom of the phone */
  margin-bottom: 1em; /* sit above the home bar */
  align-self: center;
}

.phone-scene-row {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 1.5em;
  flex: 1 1 auto;
  min-height: 0;
}

.side-log {
  width: 260px;
  max-height: 700px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.8em;
  padding-top: 1em;
}

#leftLog {
  align-items: flex-start;
}

#rightLog {
  align-items: flex-end;
}

.phone-overlay {
  display: flex;
  justify-content: center;
  margin: 1em 0;
}
.phone-frame-inline {
  width: 320px;
  min-height: 500px;
  max-height: 500px;
  background-color: var(--bg-panel);
  background-image: url('assets/ui/PhoneScreenB_V004.png');
  background-size: 100% 100%;
  background-repeat: no-repeat;
  border: 3px solid var(--text-main);
  border-radius: 12px;
  padding: 1.5em 1em;
  display: flex;
  flex-direction: column;
  gap: 0.5em;
  overflow-y: auto;
}

.phone-frame::-webkit-scrollbar {
  width: 8px;
}

.phone-frame::-webkit-scrollbar-track {
  background: transparent;
}

.phone-frame::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
}

.text-sender {
  font-size: 0.65em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.15em;
}

.text-bubble {
  max-width: 65%;
  padding: 0.6em 1em;
  border-radius: 16px;
  font-size: 0.95em;
  line-height: 1.4;
}

.text-bubble.them {
  align-self: flex-start;
  background-color: rgba(205, 193, 159, 0.15);
  border-bottom-left-radius: 4px;
}

.text-bubble.them .text-sender {
  text-align: left;
}

.text-bubble.me {
  align-self: flex-end;
  background-color: rgba(42, 61, 20, 0.85);
  border: 1px solid var(--text-main);
  border-bottom-right-radius: 4px;
}

.text-bubble.me .text-sender {
  text-align: right;
}

.text-bubble .chat-timestamp {
  margin-top: 0.3em;
}

.text-bubble.me .chat-timestamp {
  text-align: right;
}

.ga-interject {
  align-self: center;
  max-width: 85%;
  text-align: center;
  font-style: italic;
  color: var(--accent-thought);
  font-size: 0.85em;
  margin: 0.5em 0;
  padding: 0.4em 0;
  border-top: 1px dashed var(--accent-thought-dim);
  border-bottom: 1px dashed var(--accent-thought-dim);
}

.ga-interject .ga-label {
  display: block;
  font-size: 0.75em;
  font-style: normal;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0.2em;
}

/* ============================================================
   PLAYLIST 
   ============================================================ */
.playlist-screen {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4em;
  overflow: hidden;
  margin-top: 0;
  flex: 1 1 auto;   /* fill the phone between the top and continue */
  min-height: 0;    /* lets it shrink so the songs can scroll */
}

.playlist-title {
  font-size: 0.9em;
  font-style: italic;
  color: #785136;   /* mocha bean */
  margin: 1.5em 0 0;
  text-align: center;
  padding: 0.3em 1em;                          /* space inside the block */
  border-radius: 999px;                        /* pill shape */
  background-color: rgba(53, 36, 29, 0.12);   /* cappuccino tint */
}

.playlist-subtitle {
  font-size: 0.7em;
  color: #785136;        /* mocha bean */
  opacity: 0.8;          /* a touch softer than the title */
  letter-spacing: 0.5px;
  text-align: center;
  margin: 0 0 0.6em;     /* space before the songs */
}

.playlist-tracks {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 0.5em;
  flex: 1 1 auto;   /* take up the leftover space */
  min-height: 0;
  overflow-y: auto; /* scroll the songs when there are too many */
}

.playlist-track {
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;   /* keep full height so the list scrolls instead of squashing */
  padding: 0.5em 0.8em;
  border-radius: 8px;
  color: #35241d;   /* warm cappuccino */
  background-color: rgba(53, 36, 29, 0.08);   /* soft cappuccino tint */
  font-size: 0.85em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.playlist-track.playing {
  color: #CEC19F;   /* creamy latte on the green */
  background-color: rgba(42, 61, 20, 0.6);
  border: 1px solid #35241d;
}

/* same scrollbar look as the texting phone */
.playlist-tracks::-webkit-scrollbar {
  width: 8px;
}

.playlist-tracks::-webkit-scrollbar-track {
  background: transparent;
}

.playlist-tracks::-webkit-scrollbar-thumb {
  background-color: #785136;   /* mocha bean */
  border-radius: 4px;
}

.phone-frame > .continue-link {
  position: static;
  margin-top: auto;
  margin-bottom: 1em;
  align-self: center;
}

.phone-frame > .continue-link a {
  color: #35241d;          /* warm cappuccino */
  border-color: #35241d;
}

/* ============================================================
   TYPED CHOICE / FREE TYPE INPUT
   ============================================================ */

.type-input-row {
  display: flex;
  align-items: center;
  gap: 0.3em;
  padding: 0.6em 1em;
  align-self: flex-start;
  max-width: 85%;
}

.type-caret {
  color: var(--text-main);
  animation: caret-blink 1s step-end infinite;
}

@keyframes caret-blink {
  50% { opacity: 0; }
}

.type-preview {
  font-family: 'reindeer-modern', monospace;
  color: var(--text-main);
  font-size: 0.75em;

}

.type-hint {
  align-self: flex-start;
  font-size: 0.75em;
  font-family: 'leviwindows', monospace;
  color: var(--text-muted);
  font-style: italic;
  padding-left: 1em;
}

.dialogue-prompt {
  text-align: center;
  margin-top: auto;
  padding-top: 1em;
}

/* ============================================================
   EXPANDABLE (click-to-reveal truth)
   ============================================================ */

.expand-hint {
  font-size: 0.75em;
  color: var(--accent-thought-dim);
  font-style: italic;
}

.expand-text {
  cursor: pointer;
}

.expand-text.expand-locked {
  cursor: default;
  opacity: 0.85;
}

.expand-layers {
  display: flex;
  flex-direction: column;
  gap: 0.3em;
}
.expand-layer-old {
  opacity: 0.5;
  text-decoration: line-through;
  font-size: 0.9em;
}
.expand-layer-current.expand-clickable {
  cursor: pointer;
}
.expand-hint {
  font-size: 0.75em;
  color: var(--accent-thought-dim);
  font-style: italic;
  margin-top: 0.2em;
  display: block;
}

/* ============================================================
   BREATHING SCREEN
   ============================================================ */
@keyframes screen-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.015); }
}

.breathing {
  animation: screen-breathe 4s ease-in-out infinite;
}

/* ============================================================
   MEMORY BANK — TOAST, DIALOG, UNREAD DOT
   ============================================================ */
#memory-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.95);
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.6em 1.2em;
  border-radius: 6px;
  font-size: 0.9em;
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.4s ease;
  z-index: 9999;
}
#memory-toast.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.unread-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background-image: url('assets/ui/UnreadDot_V002.png');
  background-size: 100% 100%;
  image-rendering: pixelated;
  margin-left: 0.4em;
  vertical-align: middle;
  animation: dot-pulse 1.5s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.memory-tabs {
  display: flex;
  gap: 1.5em;
  border-bottom: 1px solid var(--text-muted);
  margin-bottom: 1em;
  padding-bottom: 0.5em;
}

.memory-tab {
  cursor: pointer;
  color: var(--text-muted);
  font-size: 0.95em;
  letter-spacing: 0.5px;
}

.memory-tab.active {
  color: var(--text-main);
  border-bottom: 2px solid var(--text-main);
  padding-bottom: 0.3em;
}

.family-status {
  font-size: 0.85em;
  color: var(--text-muted);
  font-style: italic;
  margin-top: 0.2em;
}

#memory-bank-dialog .memory-person {
  border-bottom: 1px dashed var(--text-muted);
  padding: 1em 0;
}

#memory-bank-dialog .memory-person:last-child {
  border-bottom: none;
}

#memory-bank-dialog .memory-person-name {
  font-size: 1.1em;
  color: var(--text-main);
  margin-bottom: 0.3em;
}

#memory-bank-dialog .memory-entry {
  color: var(--text-main);
}

#memory-bank-dialog .memory-date {
  font-size: 0.7em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

#memory-bank-dialog .memory-text {
  margin-top: 0.2em;
  font-style: italic;
}

#memory-bank-dialog .memory-history-toggle {
  font-size: 0.75em;
  color: var(--accent-thought-dim);
  cursor: pointer;
  margin-top: 0.5em;
}

#memory-bank-dialog .memory-history {
  margin-top: 0.5em;
  padding-left: 1em;
  border-left: 1px dashed var(--text-muted);
}

#memory-bank-empty {
  color: var(--text-muted);
  font-style: italic;
}

#memory-bank-dialog .quote-entry {
  border-bottom: 1px dashed var(--text-muted);
  padding: 0.8em 0;
}

#memory-bank-dialog .quote-entry:last-child {
  border-bottom: none;
}

#memory-bank-dialog .quote-text {
  font-style: italic;
  color: var(--text-main);
}

#memory-bank-dialog .quote-source {
  font-size: 0.75em;
  color: var(--text-muted);
  margin-top: 0.3em;
}

#memory-bank-dialog .quote-entry {
  cursor: pointer;
}
#memory-bank-dialog .quote-entry:hover .quote-text {
  color: var(--accent-thought);
}
#quote-modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  transition: opacity 0.3s ease;
}
#quote-modal-overlay.visible {
  opacity: 1;
}
#quote-modal {
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: 2em 2.5em;
  max-width: 600px;
  width: 90%;
  text-align: left;
  line-height: 1.7;
  transform: scale(0.95);
  transition: transform 0.3s ease;
}
#quote-modal-overlay.visible #quote-modal {
  transform: scale(1);
}
.quote-modal-text {
  font-style: italic;
  color: var(--text-main);
  margin-bottom: 1em;
}
.quote-modal-source {
  font-size: 0.8em;
  color: var(--text-muted);
  margin-bottom: 0.3em;
}
.quote-modal-date {
  font-size: 0.7em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 1.5em;
}
.quote-modal-close {
  cursor: pointer;
  text-align: center;
  color: var(--text-main);
  border-top: 1px dashed var(--text-muted);
  padding-top: 1em;
}
.quote-modal-close:hover {
  color: var(--text-muted);
}

.memory-entry.superseded .memory-text {
  text-decoration: line-through;
  opacity: 0.5;
}

.memory-entry.superseded .memory-date {
  opacity: 0.5;
}

/* ============================================================
   CLOCK SCENE (Meeting_SerenityPrayer time-skip)
   ============================================================ */
.clock-scene {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  gap: 1.5em;
}

.clock-label {
  font-size: 1.2em;
  color: var(--text-muted);
  letter-spacing: 1px;
}

.clock-face {
  width: 140px;
  height: 140px;
  border: 4px solid var(--text-main);
  background-color: var(--bg-panel);
  position: relative;
  image-rendering: pixelated;
  box-shadow:
    inset 0 0 0 2px var(--bg-main),
    inset 0 0 0 4px var(--text-main);
}

.clock-hand {
  position: absolute;
  bottom: 50%;
  left: 50%;
  transform-origin: bottom center;
  background-color: var(--text-main);
  image-rendering: pixelated;
}

.clock-hand.hour {
  width: 6px;
  height: 36px;
  margin-left: -3px;
  transform: rotate(210deg);
  transition: transform 2.5s steps(8, end);
}

.clock-hand.minute {
  width: 4px;
  height: 55px;
  margin-left: -2px;
  transform: rotate(90deg);
  transition: transform 2.5s steps(12, end);
}

.clock-hand.hour.advance {
  transform: rotate(240deg);
}

.clock-hand.minute.advance {
  transform: rotate(450deg);
}

.clock-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 10px;
  background-color: var(--text-main);
  transform: translate(-50%, -50%);
}

.clock-tick {
  position: absolute;
  width: 4px;
  height: 4px;
  background-color: var(--text-muted);
}


/* ============================================================
  SKIP BUTTON (PLAYTESTING)
   ============================================================ */

#skip-toggle {
  position: fixed;
  bottom: 1em;
  right: 1.5em;
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.4em 0.9em;
  border-radius: 6px;
  font-family: 'VT323', monospace;
  font-size: 0.85em;
  cursor: pointer;
  z-index: 9999;
  letter-spacing: 1px;
}

#skip-toggle.active {
  background-color: rgba(192, 69, 63, 0.3);
  border-color: #c0453f;
}

/* ============================================================
  AURA
   ============================================================ */
.speaker-box.anesu-glow-low {
  
  box-shadow: 0 0 12px 2px rgba(159, 184, 173, 0.4);
}

.speaker-box.anesu-glow-mid {
  box-shadow: 0 0 16px 4px rgba(192, 150, 80, 0.5);
}

.speaker-box.anesu-glow-high {
  box-shadow: 0 0 20px 6px rgba(192, 69, 63, 0.55);
}


:: Story JavaScript [script]
window.updateDebugPanel = function() {
  if ($('#debug-panel').length === 0) {
    $('<div id="debug-panel"></div>').appendTo('body');
  }
  if (!window.debugPanelOn) {
    $('#debug-panel').hide();
    return;
  }
  $('#debug-panel').show();
  var v = State.variables;
  var awareness = v.familyAwareness || 0;
  var tier = awareness >= 6 ? "aware" : awareness >= 3 ? "uncertain" : "blind";
  var html = '<div class="debug-title">DEBUG — LIVE VARIABLES</div>';
  html += '<div class="debug-row">guard: ' + (v.anesuGuard !== undefined ? v.anesuGuard.toFixed(1) : '—') + ' (' + guardAdjective(v.anesuGuard) + ')</div>';
  html += '<div class="debug-row">awareness: ' + (v.familyAwareness !== undefined ? v.familyAwareness.toFixed(1) : '—') + ' (' + awarenessAdjective(v.familyAwareness) + ')</div>';
  html += '<div class="debug-row">mamaTrust: ' + (v.mamaTrust !== undefined ? v.mamaTrust.toFixed(1) : '—') + ' (' + trustAdjective(v.mamaTrust) + ')</div>';
  html += '<div class="debug-row">dadTrust: ' + (v.dadTrust !== undefined ? v.dadTrust.toFixed(1) : '—') + ' (' + trustAdjective(v.dadTrust) + ')</div>';
  html += '<div class="debug-row">micahTrust: ' + (v.micahTrust !== undefined ? v.micahTrust.toFixed(1) : '—') + ' (' + trustAdjective(v.micahTrust) + ')</div>';
  html += '<div class="debug-row">endingZone: ' + getEndingZone() + '</div>';
  html += '<div class="debug-row">wentToElias: ' + v.wentToElias + '</div>';
  html += '<div class="debug-row">eliasBlocked: ' + v.eliasBlocked + '</div>';
  $('#debug-panel').html(html);
};

window.debugPanelOn = true;
window.setupDebugToggle = function() {
  if ($('#debug-toggle').length) return;
  var $btn = $('<div id="debug-toggle">🐞</div>');
  $('body').append($btn);
  $btn.on('click', function() {
    window.debugPanelOn = !window.debugPanelOn;
    $(this).text('🐞' + (window.debugPanelOn ? 'ON' : 'OFF'));
    $(this).toggleClass('active', window.debugPanelOn);
    updateDebugPanel();
  });
};

$(document).on(':passagedisplay', function() {
  setupDebugToggle();
});

$(document).on(':passagedisplay', function(ev) {
  var titlePassages = ["P_01_Opening_Monologue", "P_02_Title_Screen"];
  if (titlePassages.indexOf(ev.passage.title) !== -1) {
    $('body').addClass('title-mode');
  } else {
    $('body').removeClass('title-mode');
  }
});

window.characterSpeeds = {
  "Erin": 45,
  "Higher Power": 20,
  "Mama": 15,
  "Anesu": 25,
  "Dad": 30,
  "Micah": 20
};

window.guardAdjective = function(g) {
  g = g || 0;
  if (g >= 7) return "volatile";
  if (g >= 5) return "walled off";
  if (g >= 3) return "wary";
  return "open";
};

window.awarenessAdjective = function(a) {
  a = a || 0;
  if (a >= 8) return "lucid";
  if (a >= 6) return "stirring";
  if (a >= 3) return "uncertain";
  return "blind";
};

window.trustAdjective = function(t) {
  t = t || 0;
  if (t >= 8) return "close";
  if (t >= 5) return "steady";
  if (t >= 3) return "strained";
  return "distant";
};

window.getTypeSpeed = function(speaker, override) {
  if (override) return override;
  if (window.characterSpeeds[speaker]) return window.characterSpeeds[speaker];
  return 25;
};

$(document).on(':passagedisplay', function () {
  $('#story-title').text('created by titikormetsi studios');
});

$(document).on(':passagestart', function() {
  if (window.titleScreenTimers) {
    window.titleScreenTimers.forEach(function(t){ clearTimeout(t); });
    window.titleScreenTimers = [];
  }
});

window.scrollAllLogs = function() {
  ['#chatLog', '#leftLog', '#rightLog'].forEach(function(sel){
    var el = document.querySelector(sel);
    if (el) el.scrollTop = el.scrollHeight;
  });
};

window.typewriterEffect = function(el, text, speed, speaker, onComplete) {
  console.log("typewriterEffect called with speaker:", speaker, "fastMode:", window.fastMode);
  speed = speed || 25;
  var $portrait = $('.speaker-box.speaking img');
  $portrait.addClass('talking');
  if (window.fastMode) {
    el.textContent = text;
    $portrait.removeClass('talking');
    if (typeof onComplete === "function") onComplete();
    return;
  }
  var i = 0;
  el.textContent = "";
  (function tick() {
    if (i < text.length) {
      el.textContent += text.charAt(i);
    if (i % 3 === 0 && text.charAt(i) !== ' ') {
      console.log("calling talkBlip with:", speaker);
      talkBlip(speaker);
}
      i++;
      setTimeout(tick, speed);
    } else {
      $portrait.removeClass('talking');
      if (typeof onComplete === "function") onComplete();
    }
  })();
};

window.typePlain = function(el, text, speed, onComplete) {
  speed = speed || 45;
  if (window.fastMode) {
    el.textContent = text;
    if (typeof onComplete === "function") onComplete();
    return;
  }
  var i = 0;
  el.textContent = "";
  (function tick() {
    if (i < text.length) {
      el.textContent += text.charAt(i);
      i++;
      setTimeout(tick, speed);
    } else if (typeof onComplete === "function") {
      onComplete();
    }
  })();
};

window.typeSequenceLines = function(containerId, lines, speed, onComplete) {
  speed = speed || 45;
  var container = document.getElementById(containerId);
  var idx = 0;
  function next() {
    if (idx >= lines.length) {
      if (typeof onComplete === "function") onComplete();
      return;
    }
    var item = lines[idx];
    var text = typeof item === "string" ? item : item.text;
    var cls = typeof item === "string" ? "title-line" : ("title-line " + (item.className || ""));
    var lineEl = document.createElement('div');
    lineEl.className = cls;
    lineEl.style.display = "block";
    lineEl.style.color = "inherit";
    if (typeof item === "object" && item.fontSize) {
      lineEl.style.fontSize = item.fontSize;
    }
    container.appendChild(lineEl);
    typePlain(lineEl, text, speed, function(){
      idx++;
      next();
    });
  }
  next();
};

window.talkBlip = function(speaker) {
  var options = window.talkBlipSounds && window.talkBlipSounds[speaker]
    ? window.talkBlipSounds[speaker]
    : ["audio/bleeps/bleep001.mp3"];
  var src = options[Math.floor(Math.random() * options.length)];
  var blip = new Audio(src);
  blip.volume = 0.3 * (window.gameVolumes ? window.gameVolumes.sfx : 1);
  blip.playbackRate = 0.9 + Math.random() * 0.3;
  blip.play();
  setTimeout(function() {
    blip.pause();
    blip.currentTime = 0;
  }, 120);
};

window.talkBlipSounds = {
  "Higher Power": ["audio/bleeps/bleep001.mp3", "audio/bleeps/bleep002.mp3", "audio/bleeps/bleep003.mp3", "audio/bleeps/bleep004.mp3", "audio/bleeps/bleep005.mp3", "audio/bleeps/bleep006.mp3", "audio/bleeps/bleep007.mp3", "audio/bleeps/bleep008.mp3", "audio/bleeps/bleep009.mp3", "audio/bleeps/bleep010.mp3"],
  "Guardian Angel": ["audio/bleeps/bleep001.mp3", "audio/bleeps/bleep002.mp3", "audio/bleeps/bleep003.mp3", "audio/bleeps/bleep004.mp3", "audio/bleeps/bleep005.mp3", "audio/bleeps/bleep006.mp3", "audio/bleeps/bleep007.mp3", "audio/bleeps/bleep008.mp3", "audio/bleeps/bleep009.mp3", "audio/bleeps/bleep010.mp3"]
};

$(document).on('keydown.spacebarAdvance', function(e) {
  if (e.code === 'Space' || e.key === ' ') {
    var $prompt = $('.dialogue-prompt a, .type-input-row, [id^="freeTypeBubble"]');
    if ($('.dialogue-prompt a').length && !$('.type-input-row').length) {
      e.preventDefault();
      $('.dialogue-prompt a').first().trigger('click');
    }
  }
});
$(document).on(':scene-typing-done', function() {
  var $log = $('#chatLog');
  if (State.variables.beatIndex < State.variables.sceneBeats.length) {
    $log.append('<div class="dialogue-prompt"></div>');
    var $prompt = $log.find('.dialogue-prompt').last();
    var $link = $('<a class="link-internal">▼</a>').appendTo($prompt);
    $link.on('click', function() {
      $prompt.remove();
      Wikifier.wikifyEval('<<advanceScene>>');
    });
  } else if ($('#memberDisplay').length && $('#memberDisplay').css('display') === 'none') {
    $('#memberDisplay').slideDown(400, function() {
