:: B2C1_04_Transition {"position":"400,850","size":"100,100"}
<<run $('body').addClass('scene-night')>>
<<set $sceneBeats to [
  {type: "action", text: "It's another late evening, but instead of her making dinner, she's missing it — hammered in her room... too drunk to have dinner with her family."},
  {type: "action", text: "But it's been two weeks."},
  {type: "action", text: "Gotta come out at some point."},
  {type: "action", text: "Erin takes a deep breath, licking her lips sloppily, dribbling down her front, and \"composes\" herself, making her way to the dining room."},
  {type: "action", text: "She hears her loved ones chat away, no one bothering to turn around at the click of the door."},
  {type: "action", text: "Mhmm — Robert flinched a little."},
  {type: "action", text: "She thumps to the table, attempting to drag it out with discretion, but topples it instead."},
  {type: "action", text: "Mackenzie sighs and flares her nostrils, trying to continue her chat with Hazel about the concert that weekend."},
  {type: "action", text: "They all continue. Eating, chewing, chatting."},
  {type: "action", text: "It's as if she doesn't exist."},
  {type: "action", text: "She sits herself at the table and groans at the sight of greasy steak and garlicky, buttery potatoes."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Wwwwwhooo made this??"},
  {type: "action", text: "Robert winces sheepishly and looks to his wife."},
  {type: "dialogue", side: "character", speaker: "Robert", text: "I did, honey. The steak was about to go bad."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "I clearly say that it was me going to be COOKING. I bought that for me to make."},
  {type: "action", text: "Erin looks annoyed and disgusted, and it was a lot of emotion for a warm meal."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "You didn't even make it right! That's why I should do it!"},
  {type: "action", text: "Erin begins to tear up, perceived to be misunderstood, but the family knew she was in a blackout."},
  {type: "dialogue", side: "character", speaker: "Hazel", text: "Dad made us a nice meal, Mum. Get off his back. You're just drunk."},
  {type: "action", text: "Erin glares at her daughter and holds a burp."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Drunk? You don't even know anything, Kenz."},
  {type: "action", text: "Hazel scoffs and pushes her seat back, grabbing her plate."},
  {type: "dialogue", side: "character", speaker: "Hazel", text: "I'll be finishing this in my room. Thank you, Dad."},
  {type: "action", text: "She looks to her father and then across the table."},
  {type: "dialogue", side: "character", speaker: "Hazel", text: "Erin."},
  {type: "action", text: "She clutches her pearls as if she's been wounded and whips to Robert."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "YOU see how SHE SpeaKS to me?"},
  {type: "action", text: "Robert sighs and rubs his temple, fidgeting with his wedding band."},
  {type: "dialogue", side: "character", speaker: "Robert", text: "Now isn't the time, Erin, you've been drinking."},
  {type: "action", text: "And that's when shit hits the fan."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Drinking? I'VE BEEN FUCKING DRINKING? ALL I DO IS WORK AND WORK AND WORK AND WORK. THIS IS THE THANKS I GIVE? I GET?"},
  {type: "action", text: "Mackenzie quickly grabs Oscar's hand and darts with him out of the room."},
  {type: "action", text: "They obviously can't deal with this again."},
  {type: "dialogue", side: "character", speaker: "Robert", text: "Erin, please don't do this, love, it's ok—"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "OKAY? YOU THINK BEING DISRESPECTED IS OKAY?? YOU ARE SO OKAY WITH—"},
  {type: "action", text: "Erin stands up and swipes her hands across the table, sending the food crashing and splattering all over the floor. An hour of cooking gone in an instant."},
  {type: "action", text: "Tears fall rapidly down Robert's cheeks, blurring his frames, bottom lip quivering."},
  {type: "action", text: "He's so afraid... so afraid of the one he loves most. Oh Robert, I'm so sorry."},
  {type: "action", text: "He goes to pick up the mess, yet Erin keeps on screaming."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "ALL YOU DO IS DEFEND THEIR TERRIBLE BEHAVIOUR, WHAT ABOUT YOUR WIFE?"},
  {type: "action", text: "All he does is think about you, Erin."},
  {type: "dialogue", side: "character", speaker: "Robert", text: "I work so h-h-h-ard. I made you dinner for you and the kids."},
  {type: "action", text: "Footsteps pound down the hallway and the shit is smeared even further round the home."},
  {type: "dialogue", side: "character", speaker: "Mackenzie", text: "GET OUT!"},
  {type: "action", text: "Mackenzie beelines for her mother, grabbing her shoulders and directing her to the door. The force was heavy and almost sent Erin flying, too drunk to keep her balance."},
  {type: "dialogue", side: "character", speaker: "Robert", text: "Kenzie, please, just go to your ro—"},
  {type: "dialogue", side: "character", speaker: "Mackenzie", text: "NO! I'VE HAD IT! SHE IS SO MEAN TO YOU AND MEAN TO US."},
  {type: "action", text: "Mackenzie keeps pushing Erin down the hall, keeping one arm on her as she unlocks the door."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Get YOUR HAANDS offMEEE."},
  {type: "action", text: "She begins to flail but she has no strength, unable to fight against her 16 year old. Mackenzie continues to push past the threshold and shoves her onto the nature strip."},
  {type: "action", text: "This is terrible."},
  {type: "dialogue", side: "character", speaker: "Mackenzie", text: "DO NOT COME BACK, ERIN. GET THE FUCK AWAY!!"},
  {type: "action", text: "The door slams shut and the chirp of the summer crickets ring in Erin's skull."},
  {type: "action", text: "Grass in her ear, gravel on her palms and scraped shins..."},
  {type: "action", text: "She stays lying there, her world still spinning."},
  {type: "action", text: "And spinning"},
  {type: "action", text: "and spinning"},
  {type: "action", text: "and spinning"},
  {type: "action", text: "and spinning"},
  {type: "action", text: "and spinning."}
]>>
<<set $beatIndex to 0>>

