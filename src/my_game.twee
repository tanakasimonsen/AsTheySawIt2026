<<set $currentDate to "Wed, 1 May 2024">>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "text", side: "them", text: "Hey, you free tonight? 😉", time: "9:40pm"},
  {type: "text", side: "me", text: "Maybe... what's in it for me?", time: "9:41pm"},
  {type: "text", side: "them", text: "You spending the night with me... taking care of you", time: "9:42pm"},
  {type: "text", side: "me", text: "And what makes you think i want that ;)", time: "9:43pm"},
  {type: "text", side: "them", text: "From the way you were moaning for me", time: "9:44pm"},
  {type: "thought", text: "My heart beats throughout my body. I haven't seen him in a while."},
  {type: "interject", text: "You do some background research on this guy. He does not seem like a nice guy in any way."},
  {type: "interject", text: "Didn't he ghost you like twice? I don't think you should see him..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Well he said he was going through something, I mean I guess it's fair?"},
  {type: "interject", text: "You don't seem too sure about that, Anesu. Just stay home, hang out with Micah or something."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Micah? He wants nothing to do with me. He's still mad at me."},
  {type: "interject", text: "So spending it with this asshole is better? At least you know Micah loves you."},
  {type: "text", side: "them", text: "Come over tonight babe", time: "9:52pm"},
  {type: "text", side: "me", text: "I don't have my car tonight :((", time: "9:53pm"},
  {type: "text", side: "me", text: "Come and get me?", time: "9:53pm"},
  {type: "interject", text: "You HAVE no car, NO LICENSE might I add? And what exactly are you gonna tell Mama?"},
  {type: "expandable", side: "player", speaker: "Anesu", shortText: "Telling her nothing, no guy is ever allowed in my life.", layers: [
    "[PLACEHOLDER — first push, partial truth]",
    "If I tell her, she'll say I told you so, and I can't hear that right now — not when I already know she's right."
  ], partialImpacts: {anesuGuard: -0.3}, nudgeImpacts: {anesuGuard: -0.5}, skipImpacts: {anesuGuard: 0.5}},
  {type: "interject", text: "And with good reason! They've all been dicks and only want you for sex."},
  {type: "expandable", side: "player", speaker: "Anesu", shortText: "Well I want them for just sex too...", layers: [
    "[PLACEHOLDER — first push, partial truth]",
    "I don't, actually. I just want someone to look at me like I matter, and sex is the only version of that I know how to ask for."
  ], partialImpacts: {familyAwareness: 0.3}, nudgeImpacts: {familyAwareness: 0.5}, skipImpacts: {anesuGuard: 0.5}},
  {type: "interject", text: "Then why do you get so upset when they disappear?"},
  {type: "breathe", text: "The silence grows despicably loud.", duration: 2500},
  {type: "thought", text: "It was an awful chase of cat and mouse. It was the same result over and over. Insanity manifested. It says it right on the walls at Mirabel — repeating the same behaviours, expecting the same result."},
  {type: "text", side: "them", text: "What time?", time: "10:02pm"},
  {type: "text", side: "me", text: "10pm??", time: "10:03pm"},
  {type: "text", side: "them", text: "I'll see you then gorgeous", time: "10:04pm"},
  {type: "expandable", side: "player", speaker: "Anesu", shortText: "See? He thinks I'm gorgeous.", layers: [
    "[PLACEHOLDER — first push, partial truth]",
    "I need someone to think that right now. I don't care that it's him. I just need it to be true from somebody."
  ], partialImpacts: {anesuGuard: -0.2}, nudgeImpacts: {anesuGuard: -0.5}, skipImpacts: {anesuGuard: 0.5}},
  {type: "interject", text: "Correction, he thinks your tits are gorgeous."},
  {type: "interject", text: "And I thought you didn't like sex? I thought you came to that conclusion with Sheryl?"},
