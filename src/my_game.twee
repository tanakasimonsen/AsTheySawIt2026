<</link>>
<<else>>
<span class="locked-label">Locked</span>
<</if>>
</div>
</div>
</div>
<</widget>>


:: SceneEngine [widget] {"position":"1350,0","size":"100,100"}
<<widget "advanceScene">>
<<if $beatIndex lt $sceneBeats.length>>
<<set _beat to $sceneBeats[$beatIndex]>>
<<run $('.dialogue-prompt').remove()>>
<<if _beat.impacts>>
<<run (function(){
  var imp = _beat.impacts;
  for (var key in imp) {
    if (key === "wobble") continue;
    var current = State.variables[key] || 0;
    var wobble = imp.wobble ? (Math.random() * 1.4 - 0.7) : 0;
    var next = current + imp[key] + wobble;
    State.variables[key] = Math.max(0, Math.min(10, next));
  }
  updateAngelStatus();
  var g = State.variables.anesuGuard || 0;
  var leftBoxEl = $('.speaker-box').first();
  leftBoxEl.removeClass('anesu-glow-low anesu-glow-mid anesu-glow-high');
  if (g >= 7) { leftBoxEl.addClass('anesu-glow-high'); }
  else if (g >= 4) { leftBoxEl.addClass('anesu-glow-mid'); }
  else { leftBoxEl.addClass('anesu-glow-low'); }
})()>>
<</if>>
<<if _beat.time>>
<<run (function(){
  State.variables.currentTime = _beat.time;
  updateAngelStatus();
})()>>
<</if>>
<<if _beat.memoryEntry>>
<<run addMemory(_beat.memoryEntry.who, _beat.memoryEntry.text)>>
<</if>>
<<if _beat.type is "narrative">>
<<replace "#sceneNarrative">>
<div class="meeting-time">_beat.heading</div>
_beat.text
<</replace>>
<<if _beat.night is true>>
<<run $('body').addClass('scene-night')>>
<<elseif _beat.night is false>>
<<run $('body').removeClass('scene-night')>>
<</if>>
<<set $beatIndex += 1>>
<<if _beat.quoteUnlock>>
<<run addQuote(_beat.quoteUnlock.text, _beat.quoteUnlock.source)>>
<</if>>
<<elseif _beat.type is "action">>
<<append "#chatLog">><div class="chat-action">_beat.text</div><</append>>
<<set $beatIndex += 1>>
<<elseif _beat.type is "thought">>
<<append "#chatLog">><div class="chat-thought"><span class="thought-label">Anesu (thinking)</span><span class="thought-text"></span></div><</append>>
<<run (function() {
  var thoughtEl = $('#chatLog .thought-text').last();
  var text = _beat.text;
  var words = text.split(/(\s+)/);
  var html = "";
  var charIndex = 0;
  for (var w = 0; w < words.length; w++) {
    var word = words[w];
    if (/^\s+$/.test(word)) {
      html += word;
    } else {
      html += '<span style="display:inline-block;white-space:nowrap;">';
      for (var i = 0; i < word.length; i++) {
        html += '<span style="animation-delay:' + (charIndex * 0.04) + 's">' + word.charAt(i) + '</span>';
        charIndex++;
      }
      html += '</span>';
    }
  }
  thoughtEl.html(html);
})()>>
<<set $beatIndex += 1>>
<<elseif _beat.type is "spacer">>
<<append "#chatLog">><div class="chat-spacer"></div><</append>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "breathe">>
<<run $('.chat-log').addClass('breathing')>>
<<append "#chatLog">><div class="chat-action">_beat.text</div><</append>>
<<set $beatIndex += 1>>
<<run setTimeout(function(){ $('.chat-log').removeClass('breathing'); }, window.fastMode ? 50 : (_beat.duration ? _beat.duration : 3000))>>
<<elseif _beat.type is "text">>
<<set _sender to _beat.side is "them" ? (_beat.senderName ? _beat.senderName : "Elias") : ($playerName isnot "" ? $playerName : "You")>>
<<append "#chatLog">><div @class="'text-bubble ' + _beat.side"><div class="text-sender">_sender</div>_beat.text<<if _beat.time>><div class="chat-timestamp">_beat.time</div><</if>></div><</append>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "interject">>
<<append "#chatLog">><div class="ga-interject"><span class="ga-label">you</span>_beat.text</div><</append>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "continueTo">>
<<append "#chatLog">><div class="continue-link"><<link "continue" _beat.dest>><</link>></div><</append>>
<<set $beatIndex += 1>>
<<elseif _beat.type is "dialogue" or _beat.type is "choice">>
<<set _label to _beat.label ? _beat.label : (_beat.speaker is "You" and $playerName isnot "" ? $playerName : _beat.speaker)>>
<<if _beat.side is "character">>
<<replace "#rightSpeakerName">>_label<</replace>>
<<run $('#rightSpeakerImg').attr('src', $characterImages[_beat.speaker])>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('#rightSpeaker').addClass('speaking')>>
<<else>>
<<replace "#leftSpeakerName">>_label<</replace>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('.speaker-box').first().addClass('speaking')>>
<</if>>
<<if _beat.setVar>><<run State.variables[_beat.setVar] = _beat.setValue>><<run updateAngelStatus()>><</if>>
<<if _beat.type is "dialogue">>
<<append "#chatLog">><div @class="'chat-line ' + _beat.side"><div class="chat-speaker">_label</div><span class="type-target"></span></div><</append>>
<<set $beatIndex += 1>>
<<run typewriterEffect($('#chatLog .type-target').last()[0], _beat.text, 25, function() {
  $(document).trigger(':scene-typing-done');
})>>

<<else>>
<<set _thisDest to _beat.dest>>
<<append "#chatLog">><div @class="'chat-line ' + _beat.side"><div class="chat-speaker">_label</div></div><</append>>
<<run (function(){
  var dest = _thisDest;
  var linkEl = $('<a class="link-internal">' + _beat.text + '</a>');
  linkEl.on('click', function(){ Engine.play(dest); });
  $('#chatLog .chat-line').last().append(linkEl);
})()>>
<<set $beatIndex += 1>>
<</if>>

<<elseif _beat.type is "choices">>
<<append "#chatLog">>\
<<for _i to 0; _i lt _beat.options.length; _i++>>\
<div class="chat-line player"><div class="chat-speaker">$playerName</div><<link _beat.options[_i].text>><<goto _beat.options[_i].dest>><</link>></div>\
<</for>>\
<</append>>
<<set $beatIndex += 1>>
<<elseif _beat.type is "namePrompt">>
<<append "#chatLog">>
<div class="chat-line player" id="namePromptBox">
<div class="chat-speaker">You</div>
<<textbox "$playerName" "" autofocus>>
<<link "Submit">>
<<if $playerName is "">><<set $playerName to "Anesu">><</if>>
<<replace "#leftSpeakerName">>$playerName<</replace>>
<<replace "#namePromptBox">><div class="chat-speaker">You</div>$playerName<</replace>>
<<run updateAngelStatus()>>
<<run $('.dialogue-prompt').remove()>>
<<set $beatIndex += 1>>
<<showNextPrompt>>
<</link>>
</div>
<</append>>
<<elseif _beat.type is "typedChoice">>
<<set _opts to _beat.options>>
<<append "#chatLog">>
<div class="type-hint">Tab to cycle · Enter to send</div>
<div class="type-input-row" id="typeInputRow">
<span class="type-caret">▌</span>
<span id="typePreview" class="type-preview"></span>
</div>
<</append>>
<<run (function(){
  var opts = _opts;
  var i = 0;
  function render(){ $('#typePreview').text(opts[i].text); }
  render();
  $(document).off('keydown.typedChoice').on('keydown.typedChoice', function(e){
    if (e.key === 'Tab') {
      e.preventDefault();
      i = (i + 1) % opts.length;
      render();
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      $(document).off('keydown.typedChoice');
      $('#typeInputRow').prev('.type-hint').remove();
      $('#typeInputRow').remove();
      var chosen = opts[i];
      if (chosen.setVar) { State.variables[chosen.setVar] = chosen.setValue; updateAngelStatus(); }
      State.variables.beatIndex += 1;
      var label = State.variables.playerName !== "" ? State.variables.playerName : "You";
      $('#chatLog').append('<div class="chat-line player"><div class="chat-speaker">' + label + '</div><span class="type-target"></span></div>');
      typewriterEffect($('#chatLog .type-target').last()[0], chosen.text, 25, function(){
        if (chosen.dest) {
          Wikifier.wikifyEval('<<goto "' + chosen.dest + '">>');
        } else {
          $(document).trigger(':scene-typing-done');
        }
      });
    }
  });
})()>>
<<elseif _beat.type is "freeType">>
<<if _beat.side is "character">>
<<set _label to _beat.label ? _beat.label : _beat.speaker>>
<<replace "#rightSpeakerName">>_label<</replace>>
<<run $('#rightSpeakerImg').attr('src', $characterImages[_beat.speaker])>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('#rightSpeaker').addClass('speaking')>>
<<else>>
<<set _label to (_beat.speaker is "You" and $playerName isnot "") ? $playerName : _beat.speaker>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('.speaker-box').first().addClass('speaking')>>
<</if>>
<<set _bubbleId to "freeTypeBubble" + $beatIndex>>
<<set _revealId to "freeTypeReveal" + $beatIndex>>
<<append "#chatLog">>
<div class="chat-line" @id="_bubbleId">
<div class="chat-speaker">_label</div>
<span @id="_revealId"></span><span class="type-caret">▌</span>
</div>
<</append>>
<<run (function(){
  var scriptedText = _beat.text;
  var side = _beat.side;
  var bubbleSel = "#" + _bubbleId;
  var revealSel = "#" + _revealId;
  var revealed = 0;
  $(bubbleSel).attr('class', 'chat-line ' + side);
  $(document).off('keydown.freeType').on('keydown.freeType', function(e){
    if (e.key === 'Tab' || e.key === 'Shift' || e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta' || e.key === 'CapsLock' || e.key === 'Escape') return;
    e.preventDefault();
    if (window.fastMode) {
      revealed = scriptedText.length;
    } else if (revealed < scriptedText.length) {
      revealed++;
    }
    if (revealed <= scriptedText.length) {
      $(revealSel).text(scriptedText.substring(0, revealed));
      $('#chatLog').scrollTop($('#chatLog')[0].scrollHeight);
    }
    if (revealed >= scriptedText.length) {
      $(document).off('keydown.freeType');
      $(bubbleSel).find('.type-caret').remove();
      State.variables.beatIndex += 1;
      $(document).trigger(':scene-typing-done');
    }
  });
})()>>


<<elseif _beat.type is "expandable">>
<<if _beat.side is "character">>
<<set _label to _beat.label ? _beat.label : (_beat.speaker is "Higher Power" and $playerName isnot "" ? $playerName : _beat.speaker)>>
<<replace "#rightSpeakerName">>_label<</replace>>
<<run $('#rightSpeakerImg').attr('src', $characterImages[_beat.speaker])>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('#rightSpeaker').addClass('speaking')>>
<<else>>
<<set _label to (_beat.speaker is "You" and $playerName isnot "") ? $playerName : _beat.speaker>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('.speaker-box').first().addClass('speaking')>>
<</if>>
<<run (function(){
  var layers = _beat.layers || (_beat.fullText ? [_beat.fullText] : []);
  var label = _label;
  var bubbleEl = $('<div class="chat-line ' + _beat.side + '"></div>');
  var speakerEl = $('<div class="chat-speaker"></div>').text(label);
  var textEl = $('<span class="expand-text"></span>').text(_beat.shortText);
  var hintEl = $('<span class="expand-hint"> (nudge)</span>');
  var continueEl = $('<div class="dialogue-prompt"><a class="link-internal expand-continue">▼</a></div>');
  var layerIndex = 0;

  textEl.on('click', function(){
    if (layerIndex < layers.length) {
      textEl.text(layers[layerIndex]);
      layerIndex++;
      if (layerIndex >= layers.length) {
        hintEl.remove();
      }
    }
  });

  bubbleEl.append(speakerEl).append(textEl).append(hintEl);
  $('#chatLog').append(bubbleEl);
  $('#chatLog').append(continueEl);
  $('#chatLog').scrollTop($('#chatLog')[0].scrollHeight);

  continueEl.find('.expand-continue').on('click', function(){
    continueEl.remove();
    textEl.off('click');
    textEl.addClass('expand-locked');
    hintEl.remove();
    var imp;
    if (layerIndex === 0) {
      imp = _beat.skipImpacts;
    } else if (layerIndex >= layers.length) {
      imp = _beat.nudgeImpacts;
    } else {
      imp = _beat.partialImpacts;
    }
    if (imp) {
      for (var key in imp) {
        if (key === "wobble") continue;
        var current = State.variables[key] || 0;
        var wobble = imp.wobble ? (Math.random() * 1.4 - 0.7) : 0;
        var next = current + imp[key] + wobble;
        State.variables[key] = Math.max(0, Math.min(10, next));
      }
      updateAngelStatus();
    }
    State.variables.beatIndex += 1;
    Wikifier.wikifyEval('<<advanceScene>>');
  });
})()>>

})()>>

<</if>>

<<if _beat.type isnot "dialogue" and _beat.type isnot "namePrompt" and _beat.type isnot "typedChoice" and _beat.type isnot "freeType" and _beat.type isnot "expandable" and _beat.type isnot "continueTo">>
<<showNextPrompt>>
<</if>>

<<else>>
