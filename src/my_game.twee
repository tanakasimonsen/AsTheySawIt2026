:: B1C1_04_Comply {"position":"1200,325","size":"100,100"}
<<set $sceneBeats to [
  {type: "thought", text: "I swallow the boulder of pride and a little bit of tar loogies in the back of my throat, blow hard into the plastic tubing, flaring spit up and towards mama."},
  {type: "action", text: "It beeps and Ruby yanks it away from her lips, scowling as she reads the numbers."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're sober..."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "See?"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "...What a surprise!", impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Hun, that's not entirely fai—", interrupted: true},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "WOW! So that's how we're gonna play it? I've been sober for 6 months! Been following ALL your meticulous and may I say, BULL rules. I canno—", impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Language!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I. DIDN'T. SWEAR!"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "It's almost 9:30, let's start heading off t—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Why must you always defend her? She is an addict! And here you are enabling her be—", impacts: {anesuGuard: 0.5}},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I am not enabling, I am just trying to have both perspectives being heard between you two. You both talk at each other, but not one of you is actually bloody listening.", impacts: {familyAwareness: 1, dadTrust: 0.5}, memoryEntry: {who: "Dad", text: "He's the only one who ever says it plainly — that neither of us is actually listening. I don't think Mama's ever going to hear that. I don't know if I really have either."}},
  {type: "thought", text: "I try so fucking hard and this bitch keeps fucking with me! I'm staying sober for this? Nah, fuck this."},
  {type: "action", text: "Anesu balls her fists up behind her back, gnawing on her lip piercing, she turns on her heel and—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Who said you could leave?", impacts: {anesuGuard: 1}},
  {type: "action", text: "Dad inhales deeply, headphones now out of his ear and swinging against his chest. Anesu stops dead in her tracks, also inhaling deeply. Growing up, everyone has said Dad and I are much alike. Facial features, mannerisms, temper, alcohol... through gritted teeth..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "May I go to bed?"},
  {type: "action", text: "The three stare deeply at one another, reading if there will be an explosion tonight or if we can back away slowly. Mama turns around and leaves, leaving Dad and Anesu in the hall."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Your wife is insane. You gotta get her in control."},
  {type: "action", text: "Dad sighs, hating that Anesu keeps referring to her as his wife."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "She's insane about you."},
  {type: "action", text: "They keep staring at one another, wondering if more should be said. If it needs to be said."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm going to bed."},
  {type: "action", text: "Dad stays in the hallway, watching Anesu trudge away slowly, shoulders slumped."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I love you Anesu. I know you're trying.", impacts: {anesuGuard: -1}, memoryEntry: {who: "Dad", text: "He said he knows I'm trying. He's the only one who says that out loud. I don't know why that's the thing that almost breaks me."}},
  {type: "continueTo", dest: "B1C1_05_Transition"}

]>>
<<set $beatIndex to 0>>

