:: V2_04_Argument {"position":"625,550","size":"100,100"}
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "action", text: "As soon as her keys kiss the lock on the flyscreen, the door swings open — the matriarchal pair staring daggers into one another."},
  {type: "thought", text: "Deja vu in the hallway, huh?"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Where the bloody hell were you?"},
  {type: "action", text: "Her arms fold hard across her chest — still in her boxers, shirt, and bonnet."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I was out."},
  {type: "action", text: "Dad walks from the kitchen down the hall and scoffs, rolling his eyes."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Yes, Su, clearly you were out. Out where? With who?"},
  {type: "action", text: "Anesu's grip tightens on her bag. Her heart rate spikes, thinking about last night and the worst that's yet to come."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I was with a friend."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "You don't have any friends, hey. Unless all of a sudden you made some."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "And you would've said something. So I'm not going to ask you again. Who. Were. You. With?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Oh yeah Mama, I was out getting my brains fucked out at some guy's house."},
  {type: "thought", text: "Jesus, Anesu. Okay, let's think of something quickly. I'm not enabling, but we need to de-escalate. And readjust your hoodie, for Christ's sake."},
  {type: "action", text: "Anesu fixes her hoodie, ensuring the monster of a hickey is covered."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I really was with a friend, her name is Tilly, we—"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "And where, pray tell, did you meet this Tilly?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Uni. We're in a group assignment."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "You hate group assignments."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah, well, this one wasn't optional. Had to be with her."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "And why did you have to stay the night? Knowing very well you're not allowed.", time: "8:18am"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "We got caught up watching some movies."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I thought you were studying."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Yes, we studied, and then we watched some movies."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "What movies?"},
  {type: "thought", text: "God, she's quick."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Clue and Train to Busan."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "But you've seen those movies before."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What, so I'm not allowed to watch them again? Am I suddenly banned from rewatching films?"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Don't be smart, Su."},
  {type: "action", text: "Micah's voice echoes from the living room down the hall. He clears his throat."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "If you're wanting to catch her out on something, asking about movies is not the move."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Shut UP, Micah, with that nonsense, Micah."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Hey! If anyone is shutting up with their nonsense, it's you! So why was your location off?"},
  {type: "thought", text: "Did we think of an answer for this?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "iCloud signed out."},
  {type: "action", text: "Dad squints slightly at his daughter, knowing full well that isn't true. But he isn't going to tell Mama that. What she doesn't know won't hurt her."},
  {type: "action", text: "Because Mama knows nothing about phones, let alone iPhones, she's stumped."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "So you signed out on purpose?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Nope. It just does that sometimes."},
  {type: "action", text: "Dad knows that's true — it just seems to happen at awfully convenient times. Mama continues to seethe, looking her daughter up and down."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I do not know how many fucking times I have told you. YOU ARE NOT ALLOWED OUT PAST 9PM. And yet you continue to undermine what me and your father have said.", time: "8:22am"},
  {type: "thought", text: "Yeah, Dad wanted a bit more restriction on where I was — but the open door, and not being allowed out at all anymore, was never something he fully agreed with."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "How long is this going to go on for? Are we actually serious right now?"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I'm as serious as a heart attack. We will continue to do what's best for you, since you can't make THOSE DECISIONS FOR YOURSELF!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Ahhh, okay — so I now have no inhibitions, no drive, no direction. I'm some DOPEY FUCK who can't do anything for herself!"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "LANGUAGE! WATCH YOUR MOUTH!"},
  {type: "action", text: "Micah sighs, then what sounds like the click of his laptop closing — she watches her brother cross the hall and disappear into his room.", impacts: {familyAwareness: 0.5}},
  {type: "thought", text: "Fair response. It is the FUCKING MORNING."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I LEFT REHAB 6 MONTHS AGO! Have I NOT SHOWN ANY TYPE OF RESPONSIBILITY?", time: "8:25am"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "You have, Anesu. It's great that you're going to those meetings, going to the gym. You got a new job at the—"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "AH YES! THE BARE MINIMUM OF BEING AN ADULT.", impacts: {familyAwareness: 1}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Wooooowww. You know what, Mama? You're absolutely fucking full of it."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Do NOT speak to me that way!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Then DON'T SPEAK TO ME THAT WAY! WHAT ARE YOU ON RIGHT NOW? I mean, Jesus Christ."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "LANGUAGE!!!!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "JE. SUS. CHRIST!!!"},
  {type: "action", text: "Mama steps forward and slaps her daughter across the face. All three stand frozen in the hallway. A door creaks — Micah stands there, mouth agape. Anesu's eyes water, and for a moment Mama's expression falters — but she hardens up right away.", time: "8:27am"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I've been sober for 6 months. I have done EVERYTHING IN MY POWER to make shit right. I've followed every RULE."},
  {type: "action", text: "Dad nods in agreement, but keeps his eyes on Mama."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I will NEVER be able to make you happy. So yes — I went out and SPENT TIME WITH MY FRIEND, which you SHIT ON ME ABOUT FOR NOT HAVING."},
  {type: "breathe", text: "Silence, again, in the hallway. A ballad this house keeps repeating.", duration: 2500},
  {type: "thought", text: "Okay — but you weren't with a friend."},
  {type: "thought", text: "Anesu — not now."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So now I go out — YES I SHOULD'VE LET YOU KNOW — but geez, Mama. I'M HERE. AT HOME. AT 8 IN THE MORNING. Made my friend rush me home because my mama is freaking out."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Do not put this on me."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "OH, SO I'M ARGUING BY MYSELF? LOOK AT ME, EVERYONE! I'VE CREATED AN ARGUMENT ALL ON MY OWN."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "That's enough."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "NO — you SLAPPED ME! YOU started it."},
  {type: "thought", text: "I will NEVER be able to make you happy. I try so hard."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Stop yelling."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "MAKE ME."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Come on, Ne. Please."},
  {type: "action", text: "She listens to Dad, and only Dad. She takes the biggest breath she can and locks eyes with him — still speaking to Mama."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Sober for how long? And for what — for this? Nah. I don't need this, Mama.", time: "8:31am"},
  {type: "breathe", text: "Another stand-off. Silence.", duration: 2500},
  {type: "dialogue", side: "character", speaker: "Micah", text: "So... are we done?"},
  {type: "action", text: "They all turn to face him — three solemn expressions."},
  {type: "action", text: "Anesu slips her shoes off and tightens her grip on her bag."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I was done a long time ago.", time: "8:33am", impacts: {anesuGuard: 2}, memoryEntry: {who: "Mama", text: {blind: "She slapped me and somehow it's still my fault. That's who she is.", uncertain: "She hit me. My own mama hit me. I don't know what to do with that yet.", aware: "She hit me because she has no other language left for how scared she is. It doesn't make it okay. It just makes it clearer — she hasn't moved, and maybe she can't."}}},
  {type: "continueTo", dest: "V2_05_Blocked"}

]>>
