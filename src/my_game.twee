:: B1C1_05_Transition {"position":"1075,450","size":"100,100"}
<<run $('body').addClass('scene-night')>>
<<set $currentTime to "10:15pm">>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
{type: "action", text: "Anesu waits till Mama has gone to sleep, then checks Dad's Xbox room — he seems to be extremely locked in. She stands and stares, watching him."},
{type: "action", text: "Dad pulls out an earphone and looks to Anesu."},
{type: "dialogue", side: "character", speaker: "Dad", text: "You having a filthy cigarette?"},
{type: "action", text: "Anesu nods."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Want one of my disgusting foul smokes?"},
{type: "action", text: "Dad shakes his head."},
{type: "dialogue", side: "character", speaker: "Dad", text: "Nah, I'm good. You need to stop smoking."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah yeah, it's on the agenda."},
{type: "thought", text: "He thinks I'm smoking straight tobacco, but my smokes are always a little happy."},
{type: "action", text: "Anesu turns on her heel and walks to the back door, stopping at the pantry to grab some plain tuna."},
{type: "action", text: "She slides it open ever so slightly, the creaking obnoxiously loud."},
{type: "thought", text: "Normally Dad would've fixed this by now. Maybe I should do it... no expectations, hey?"},
{type: "thought", text: "Yeah, Dad knows I smoke, but I don't really like Micah knowing. I mean, yeah, he's a grown man, but still."},
{type: "action", text: "Anesu walks around the corner, following the brick path Dad made when he realised they had spare bricks in the garage."},
{type: "action", text: "Anesu squeezes herself between two bricks, the perfect width apart for a makeshift seat, and sparks up.", sound: "audio/spark_up.mp3"},
{type: "action", text: "Meow meow."},
{type: "showCharacter", speaker: "Julian"},
{type: "thought", text: "I hate cats... the way they run, how they have to be all over you, that they could kill me. Slowly. But it would be the worst fucking death."},
{type: "thought", text: "But for some reason, this cat is growing on me. Like a cancer."},
{type: "freeType", side: "character", speaker: "Higher Power", text: "He's walking along the colourbond fence, eyeing you carefully. Pretty sure he's a stray. Or maybe he just loves the smell of weed..."},
{type: "action", text: "She's named him Julian."},
{type: "thought", text: "He doesn't touch me, he keeps his distance — almost as if he knows I'm allergic to him."},
{type: "spacer"},
{type: "expandable", side: "character", speaker: "Higher Power", shortText: "Smoking again?", layers: ["Maybe we take Dad's advice."], nudgeImpacts: {anesuGuard: -0.5}, skipImpacts: {anesuGuard: 0.5}},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah, I gotta stop at some point. Of course that's what Mama wants."},
{type: "breathe", text: "Anesu inhales and exhales deeply, flicking the butt.", duration: 3000},
{type: "freeType", side: "character", speaker: "Higher Power", text: "What she wants?"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "It's always what she wants. She said homeless OR rehab. What am I just gonna walk out onto the street and say okay BYE? It's almost ALWAYS exactly what she fucking wants."},
{type: "freeType", side: "character", speaker: "Higher Power", text: "And so what? That didn't help you? Let's be 100% honest if we're talking in absolutes — those Woolies bags were growing pretty big in that closet.", impacts: {anesuGuard: 0.5}},
{type: "action", text: "The world goes quiet. Anesu stares blankly at the trimmed bushes, arm's length away."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Let's do absolutes, yeah? I was drinking for 8 mon—"},
{type: "freeType", side: "character", speaker: "Higher Power", text: "You and I both know that time doesn't matter. It's that hole in the soul you were trying to fill.", impacts: {familyAwareness: 1}},
{type: "breathe", text: "Inhale and exhale.", duration: 2500},
{type: "dialogue", side: "player", speaker: "Anesu", text: "God forbid a girl get hammered — isn't that the point of drinking? To get drunk?"},
{type: "expandable", side: "character", speaker: "Higher Power", shortText: "Not exactly.", layers: ["Yes, there are certain individuals who think the same — but their reason behind drinking is different. I mean, why do you want to be drunk?"], nudgeImpacts: {anesuGuard: -0.5, familyAwareness: 0.5}, skipImpacts: {anesuGuard: 0.5}},
{type: "dialogue", side: "player", speaker: "Anesu", text: "It's better than living sober."},
{type: "breathe", text: "Inhale and exhale.", duration: 2500},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Being sober is awful, becau—"},
{type: "freeType", side: "character", speaker: "Higher Power", text: "You feel more?"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "A whole lot fucking more."},
{type: "breathe", text: "Inhale and exhale.", duration: 2500},
{type: "freeType", side: "character", speaker: "Higher Power", text: "But isn't it sort of fantastic, though? We get to feel — to love and lose, to experience triumph and failure, to learn from such. As far as I'm concerned, we're the only animals in the universe that can do that.", impacts: {familyAwareness: 1}},
{type: "breathe", text: "Inhale and exhale.", duration: 2500},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Well, you and I both know that there are aliens."},
