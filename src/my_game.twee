<<elseif _beat.type is "action">>
<<set _actionClass to _beat.italic ? ' action-italic' : ''>>
<<set _target to (_beat.anesuSide and $('#leftLog').length) ? "#leftLog" : "#chatLog">>
<<append _target>><div class="chat-action">_beat.text</div><</append>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "thought">>
<<run (function(){
  var target = $('#leftLog').length ? $('#leftLog') : $('#chatLog');
  var thoughtEl = $('<div class="chat-thought"><span class="thought-label">Anesu (thinking)</span><span class="thought-text"></span></div>');
  target.append(thoughtEl);
  var textEl = thoughtEl.find('.thought-text');
  var text = _beat.text;
  var words = text.split(/(\s+)/);
  var html = "";
  var charIndex = 0;
  for (var w = 0; w < words.length; w++) {
    var word = words[w];
    if (/^\s+$/.test(word)) {
      html += word;
    } else {
      html += '<span style="display:inline-block;white-space:nowrap;">';
      for (var i = 0; i < word.length; i++) {
        html += '<span style="animation-delay:' + (charIndex * 0.04) + 's">' + word.charAt(i) + '</span>';
        charIndex++;
      }
      html += '</span>';
    }
  }
  textEl.html(html);
  target.scrollTop(target[0].scrollHeight);
})()>>
<<set $beatIndex += 1>>
<<if _beat.interrupted>>
<<run setTimeout(function(){ Wikifier.wikifyEval('<<advanceScene>>'); }, 600)>>
<</if>>

<<elseif _beat.type is "namePrompt">>
