:: B2C1_02_HomeAlone {"position":"400,400","size":"100,100"}
<<set $sceneBeats to [
  {type: "action", text: "She turns the car off and slams the door behind her, walking to the door ever so slowly."},
  {type: "action", text: "Her key hits the cold silver hole and she pauses, inhaling deeply."},
  {type: "action", text: "The ridges slide through as she exhales shakily, turning it with an echoing click."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Honey, I'm home."},
  {type: "action", text: "She croaks it out, eyes dragging to the end of the hallway."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "This hurts my heart. I know I can't feel it, but geez."},
  {type: "action", text: "Erin hangs her purse on the hook, not before grabbing her deck of smokes and lavender lighter her eldest got for her many moons ago. The label has faded since then. Her thumb grazes over the non-existent typography."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "What did it used to say?"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Oh, this?"},
  {type: "action", text: "She chuckles and sighs."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Mackenzie and Oscar got it for me for Mother's Day. She was 13 and he was 9... I apparently smoked so often they got me a personalised lighter saying \"best mama in the world.\" Ever since they left, I've been thumbing over the engraving. It's smoothed out and faded now."},
  {type: "action", text: "Erin keeps her slippers on, and makes her way to a mantle in the centre of the hall. She picks up an extravagant jade urn, holding it tightly, walking to the back to smoke by the empty fire pit."},
  {type: "action", text: "She sits in her chair — a much larger one sits next to hers, looking as if it hasn't been sat in in years."},
  {type: "action", text: "She lights it haphazardly and inhales hard, staring deeply at the chair, placing the jade piece, nestled in the blanket that never moves. Rain or shine."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "How was your day?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Is she talking to me?"},
  {type: "action", text: "Erin nods and exhales, raising her brow as if she is agreeing to something."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Yeah, it can be like that sometimes."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Oohhh."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Did you make it to work on time? Those works can be a real bitch."},
  {type: "action", text: "She inhales again, knee bouncing up and down."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "I'm glad you made it. Were there many orders today? You sounded busy on the phone this morning."},
  {type: "action", text: "..."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Oh, Erin..."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Oh no, it's okay, I understand. Work can be like that sometimes. Did you manage to speak to Ethan?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Who is Ethan?"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Oh, his boss. He can be a bit of a dick sometimes."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Ahh, okay."},
  {type: "action", text: "..."},
  {type: "action", text: "The cigarette burns out between her fingers, staining and burning her index."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Might want to put that out."},
  {type: "action", text: "She jolts out of the way before the ash falls on her skirt, and watches the whole thing fall."},
  {type: "action", text: "Without hesitation she lights another one, nodding."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Well, I'm glad you stood up to him, Robert. It was about time."},
  {type: "action", text: "She chuckles and bites her lip."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Is Robert okay?"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Yeah, he's just been going back and forth with his boss for weeks now. He deserves a pay rise but apparently it's \"not in the budget.\" Typical."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Yeah, that's where they get you! How long has he been working there for?"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "10 years! Can you believe it? And he hasn't asked for a raise till now!"},
  {type: "action", text: "Her nails tap and crackle against the arm of her chair, emphasising the decade-long achievement."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "So what does he do?"},
  {type: "dialogue", side: "player", speaker: "Erin", text: "He works at a manufacturing company, specifically for smart watches. He calibrates and maintains the machines that make them. He's very smart. Way smarter than me."},
  {type: "action", text: "Ash falls onto her skirt and seeps into the grooves of the knitted wool."},
  {type: "action", text: "She watches it burn a hole and fall through to her skin, burning out slowly."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Sorry, what did you say, honey?"},
  {type: "action", text: "..."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Ah yes, the children are fine. You know how it goes."},
  {type: "action", text: "You wander around the yard as Erin chats with Robert. The dead roses and patches of dirt in the grass... the old swing and tattered rope. A dilapidated dog house with a bowl full of dirt."},
  {type: "action", text: "Her yard, her home, reflected her soul. Melancholy and suffering. Pure detriment and hopelessness."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Well, I have to go put supper on for us. Sweet potato or potato?"},
  {type: "action", text: "..."},
  {type: "dialogue", side: "player", speaker: "Erin", text: "Potato it is."},
  {type: "action", text: "She throws the butt into the fire pit, orange filters piled high. She scoops Robert up and walks them both inside, her grip ever so tight on the love of her life."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "I loved potato."},
  {type: "continueTo", dest: "B2C1_03_FamilyDinner"}
]>>
<<set $beatIndex to 0>>

