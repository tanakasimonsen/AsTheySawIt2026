</div>


:: V3_02_Opening_MyFeelingsHurt {"position":"250,750","size":"100,100"}
<<set $sceneBeats to [
  {type: "interject", text: "That is true, but it's not about you this morning, I'm afraid."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I seriously don't know how you've made this about yourself. Micah was just telling us something amazing and you've come in and ruined it."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Okay I wouldn't say ruined it..."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "That's a bit much mum."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "It's the truth! We were all having such a lovely morning, hearing about your successes and here she comes bulldozing it all over. I mean come on!"},
  {type: "action", text: "Micah looks over to Su and shakes his head slightly.", memoryEntry: {who: "Micah", text: "He knows exactly what Mama's like when she gets going. I think he knows why I'm annoyed too. He just also knows now isn't the time to say so."}},
  {type: "action", text: "Dad takes his glasses off and clears his throat, interlacing his hands at the edge of the table."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I don't think she's ruining it hun."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm really not trying to."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Su, wait."},
  {type: "action", text: "Su grabs the kettle and pours it over the instant coffee and 1 tsp of sugar, watching some chunks of coffee burn."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "All she is saying is that she has the right to know what's happening in her little brother's life. That's all. You can't forget that they're close. Micah? Will you be able to update Su on what's happened later?"},
  {type: "action", text: "Micah nods firmly and sips his tea."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Of course."},
  {type: "action", text: "He turns to Anesu."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Can I finish telling Mum and Dad what I was saying? Then we can chat?"},
  {type: "action", text: "Anesu nods softly as she stirs in the granules. She looks to Mama and she refuses to look back."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm gonna go to the gym."},
  {type: "action", text: "Anesu pours off the milk as tears build in her eyes, feeling the snot build on her upper lip."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Good. You do that."},
  {type: "interject", text: "Okay well, now she's just being rude."},
  {type: "action", text: "Anesu looks up at her mother, yet she remains looking to Micah."},
  {type: "interject", text: "It's okay Su, he's going to tell you. Remember what Sheryl taught us? While you were away at her stay in rehab, and learning all these tools and ways of navigating life and thinking, it doesn't mean the people we've left at home are growing with you. They may, and most likely still, think of you as your addicted and selfish self. You must be able to balance that in your responses and ways of communicating.", impacts: {familyAwareness: 1.5}, memoryEntry: {who: "Sheryl", text: "Her lesson again, right on time. Growing doesn't mean they grew too. I know that. Knowing it and living inside it are two different things."}},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Well you don't need to be like that."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "No, I'm not being like anything."},
  {type: "action", text: "Micah and Dad look to each other and then to Anesu, who remains stirring her coffee."},
  {type: "action", text: "Her grip tigthens on the mug, slowly bringing it to her lips for a sip. She dumps the spoon in the sink, and pours her coffee onto a keep cup."},
    {type: "choice", side: "player", speaker: "Anesu", text: "I'm gonna go catch the bus...", impacts: {anesuGuard: -1}, dest: "V3_Transition_Gym"}
]>>
<<set $beatIndex to 0>>

