<<elseif _beat.type is "choices">>
<<append "#chatLog">>\
<<for _i to 0; _i lt _beat.options.length; _i++>>\
<div class="chat-line player"><div class="chat-speaker">$playerName</div><<link _beat.options[_i].text>><<goto _beat.options[_i].dest>><</link>></div>\
<</for>>\
<</append>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "typedChoice">>
<<set _opts to _beat.options>>
<<append "#chatLog">>
<div class="type-hint">Tab to cycle · Enter to send</div>
<div class="type-input-row" id="typeInputRow">
<span class="type-caret">▌</span>
<span id="typePreview" class="type-preview"></span>
</div>
<</append>>
<<run (function(){
  var opts = _opts;
  var i = 0;
  function render(){ $('#typePreview').text(opts[i].text); }
  render();
  $(document).off('keydown.typedChoice').on('keydown.typedChoice', function(e){
    if (e.key === 'Tab') {
      e.preventDefault();
      i = (i + 1) % opts.length;
      render();
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      $(document).off('keydown.typedChoice');
      $('#typeInputRow').prev('.type-hint').remove();
      $('#typeInputRow').remove();
      var chosen = opts[i];
      if (chosen.setVar) { State.variables[chosen.setVar] = chosen.setValue; updateAngelStatus(); }
      State.variables.beatIndex += 1;
      var label = State.variables.playerName !== "" ? State.variables.playerName : "You";
      $('#chatLog').append('<div class="chat-line player"><div class="chat-speaker">' + label + '</div><span class="type-target"></span></div>');
      typewriterEffect($('#chatLog .type-target').last()[0], chosen.text, getTypeSpeed(label, chosen.speed), label, function(){
        if (chosen.dest) {
          Wikifier.wikifyEval('<<goto "' + chosen.dest + '">>');
        } else {
          $(document).trigger(':scene-typing-done');
        }
      });
    }
  });
})()>>

<<elseif _beat.type is "freeType">>
<<set _target to ($('#leftLog').length and _beat.side is "player") ? "#leftLog" : (($('#rightLog').length and _beat.side is "character") ? "#rightLog" : "#chatLog")>>
<<if _beat.side is "character">>
<<set _label to _beat.label ? _beat.label : (_beat.speaker is "Higher Power" and $playerName isnot "" ? $playerName : _beat.speaker)>>
<<if $('#rightSpeakerName').length>>
<<replace "#rightSpeakerName">>_label<</replace>>
<<run $('#rightSpeakerImg').attr('src', $characterImages[_beat.speaker])>>
<</if>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('#rightSpeaker').addClass('speaking')>>
<<else>>
<<set _label to (_beat.speaker is "You" and $playerName isnot "") ? $playerName : _beat.speaker>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('.speaker-box').first().addClass('speaking')>>
<</if>>
<<set _bubbleId to "freeTypeBubble" + $beatIndex>>
<<set _revealId to "freeTypeReveal" + $beatIndex>>
<<append _target>>
<div class="chat-line" @id="_bubbleId">
<div class="chat-speaker">_label</div>
<span @id="_revealId"></span><span class="type-caret">▌</span>
</div>
<</append>>
<<run (function(){
  var scriptedText = _beat.text;
  var side = _beat.side;
  var target = _target;
  var bubbleSel = "#" + _bubbleId;
  var revealSel = "#" + _revealId;
  var revealed = 0;
  $(bubbleSel).attr('class', 'chat-line ' + side);
  $(document).off('keydown.freeType').on('keydown.freeType', function(e){
    if (e.key === 'Tab' || e.key === 'Shift' || e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta' || e.key === 'CapsLock' || e.key === 'Escape') return;
    e.preventDefault();
    if (window.fastMode) {
      revealed = scriptedText.length;
    } else if (revealed < scriptedText.length) {
      revealed++;
    }
    if (revealed <= scriptedText.length) {
      $(revealSel).text(scriptedText.substring(0, revealed));
      $(target).scrollTop($(target)[0].scrollHeight);
    }
    if (revealed >= scriptedText.length) {
      $(document).off('keydown.freeType');
      $(bubbleSel).find('.type-caret').remove();
      State.variables.beatIndex += 1;
      $(document).trigger(':scene-typing-done');
    }
  });
})()>>

<<elseif _beat.type is "phoneMessages">>
<<run (function(){
  var wrapEl = $('<div class="phone-overlay"></div>');
  var frameEl = $('<div class="phone-frame-inline"></div>');
  wrapEl.append(frameEl);
  _beat.messages.forEach(function(msg){
    var bubble = $('<div class="text-bubble ' + msg.side + '"></div>');
    bubble.append('<div class="text-sender">' + msg.sender + '</div>');
    bubble.append(document.createTextNode(msg.text));
    frameEl.append(bubble);
  });
  $('#chatLog').append(wrapEl);
  $('#chatLog').scrollTop($('#chatLog')[0].scrollHeight);
})()>>
<<set $beatIndex += 1>>

<<elseif _beat.type is "expandable">>
<<set _target to ($('#leftLog').length and _beat.side is "player") ? "#leftLog" : (($('#rightLog').length and _beat.side is "character") ? "#rightLog" : "#chatLog")>>
<<if _beat.side is "character">>
<<set _label to _beat.label ? _beat.label : (_beat.speaker is "Higher Power" and $playerName isnot "" ? $playerName : _beat.speaker)>>
<<if $('#rightSpeakerName').length>>
<<replace "#rightSpeakerName">>_label<</replace>>
<<run $('#rightSpeakerImg').attr('src', $characterImages[_beat.speaker])>>
<</if>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('#rightSpeaker').addClass('speaking')>>
<<else>>
<<set _label to (_beat.speaker is "You" and $playerName isnot "") ? $playerName : _beat.speaker>>
<<run $('.speaker-box').removeClass('speaking')>>
<<run $('.speaker-box').first().addClass('speaking')>>
<</if>>
<<run (function(){
  var layers = _beat.layers || (_beat.fullText ? [_beat.fullText] : []);
  var label = _label;
  var side = _beat.side;
  var target = _target;
  var bubbleEl = $('<div class="chat-line ' + side + '"></div>');
  var speakerEl = $('<div class="chat-speaker"></div>').text(label);
  var layersWrap = $('<div class="expand-layers"></div>');
  var firstLineEl = $('<div class="expand-layer expand-layer-current"></div>').text(_beat.shortText);
  layersWrap.append(firstLineEl);
  var hintText = side === "player" ? "(push further)" : "(press further)";
  var hintEl = $('<span class="expand-hint"></span>').text(hintText);
  var continueEl = $('<div class="dialogue-prompt"><a class="link-internal expand-continue">▼</a></div>');
  var layerIndex = 0;
  var currentLineEl = firstLineEl;

  function attachClick() {
    currentLineEl.addClass('expand-clickable').on('click', function(){
      if (layerIndex < layers.length) {
        currentLineEl.removeClass('expand-layer-current expand-clickable').addClass('expand-layer-old').off('click');
        var newLineEl = $('<div class="expand-layer expand-layer-current"></div>').text(layers[layerIndex]);
        layersWrap.append(newLineEl);
        currentLineEl = newLineEl;
        layerIndex++;
        $(target).scrollTop($(target)[0].scrollHeight);
        if (layerIndex >= layers.length) {
          hintEl.remove();
        } else {
          attachClick();
        }
      }
    });
  }
  if (layers.length > 0) {
    attachClick();
  } else {
    hintEl.remove();
  }

  bubbleEl.append(speakerEl).append(layersWrap).append(hintEl);
  $(target).append(bubbleEl);
  $(target).append(continueEl);
  $(target).scrollTop($(target)[0].scrollHeight);

  continueEl.find('.expand-continue').on('click', function(){
    continueEl.remove();
    currentLineEl.off('click').removeClass('expand-clickable');
    hintEl.remove();
    var imp;
    if (layerIndex === 0) {
      imp = _beat.skipImpacts;
    } else if (layerIndex >= layers.length) {
      imp = _beat.nudgeImpacts;
    } else {
      imp = _beat.partialImpacts;
    }
    if (imp) {
      for (var key in imp) {
        if (key === "wobble") continue;
        var current = State.variables[key] || 0;
        var wobble = imp.wobble ? (Math.random() * 1.4 - 0.7) : 0;
        var next = current + imp[key] + wobble;
        State.variables[key] = Math.max(0, Math.min(10, next));
      }
      updateAngelStatus();
    }
    State.variables.beatIndex += 1;
    Wikifier.wikifyEval('<<advanceScene>>');
  });
})()>>

<<elseif _beat.type is "showPlaylist">>
<<run (function(){
  var wrap = $('<div class="playlist-screen"></div>');
  wrap.append('<div class="playlist-title">' + _beat.title + '</div>');
  var list = $('<div class="playlist-tracks"></div>');
  _beat.tracks.forEach(function(t, i){
    var track = $('<div class="playlist-track' + (i === 0 ? ' playing' : '') + '"></div>');
    track.append('<div class="track-name">' + t + '</div>');
    list.append(track);
  });
  wrap.append(list);
  $('#chatLog').append(wrap);
  $('#chatLog').scrollTop($('#chatLog')[0].scrollHeight);
})()>>
<<set $beatIndex += 1>>
<<showNextPromptText>>

<</if>>

<<if _beat.type isnot "dialogue" and _beat.type isnot "namePrompt" and _beat.type isnot "typedChoice" and _beat.type isnot "freeType" and _beat.type isnot "expandable" and _beat.type isnot "continueTo" and _beat.type isnot "showPlaylist" and not (_beat.type is "thought" and _beat.interrupted)>>
<<showNextPrompt>>
