:: B1C1_03_AnesuDoorstep {"position":"900,200","size":"100,100"}   
<<run stopAmbience()>>        
<<set $sceneBeats to [
  {type: "action", text: "They jolt with a halt, a little too close to the garage door.", sound: "audio/engine_stop.mp3", stopSoundId: "engine"},
  {type: "dialogue", side: "character", speaker: "Erin", text: "Have a good rest of your week hun! Remember, your mother loves you very much.", memoryEntry: {who: "Erin", text: "My sponsor. Drives me home every week whether I ask or not. Sweet, but she talks about my mama like she knows her, which she very much does not."}},
  {type: "action", text: "Erin flashes her lights and drives off, her home a few kms down the road."},
  {type: "thought", text: "Okay, just shoes off and straight to your room, don't even hesitate."},
  {type: "action", text: "Unlocking the door was a success but now comes the shoes...", sound: "audio/door_unlock.mp3"},
  {type: "action", text: "As Anesu fumbles with her boots, the first door in the hallway cracks open."},
