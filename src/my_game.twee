:: B1C1_04_Compromise {"position":"950,325","size":"100,100"}
<<set $sceneBeats to [
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm only doing it if Dad does it."},
  {type: "action", text: "Anesu stares daggers into her father, but he looks straight to Mama."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "No, your father is tired. I'm doing this.", impacts: {anesuGuard: 0.5}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "He doesn't look very tired, if he was tired he wouldn't have come out of bed to see me."},
  {type: "thought", text: "What this nigga can't speak for himself? Let the man speak for himself."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Yeah, I can do it. Let me get my gla—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're not doing it Gerald. She does not get to have her way all the time.", impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I'm pretty sure she can decide who is gonna test her. I don't even know why we're doing it, I just saw Erin drive off.", impacts: {familyAwareness: 0.5}},
  {type: "dialogue", side: "character", speaker: "Mama", text: "And how do we know that was Erin?"},
  {type: "action", text: "Dad looks at her with bewilderment, looking back between Anesu and Ruby."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I saw her car and the license plate. She waved at our bedroom window."},
  {type: "action", text: "Dad goes to reach for the breathalyser but her grip stays stagnant. She continues to stare hard at Anesu."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "It doesn't matter who does it hun."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What, he's gonna spoof the numbers of this Amazon dud?"},
  {type: "thought", text: "This woman has lost it, officially."},
  {type: "action", text: "Mama lets go reluctantly, and steps a centimeter to the side. Dad approaches Anesu softly, raising his arm slowly and nods solemnly. Anesu maintains eye contact till it beeps, Mama's arms crossed a little too hard."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "So what's the difference between him doing it and me doing it?", impacts: {familyAwareness: 0.5}},
  {type: "thought", text: "She needs to let this the fuck go. I am not in the mood."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Because I wanted him to. THAT should be enough."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "All 0's. Well done sisi.", memoryEntry: {who: "Dad", text: "All zeros, and he actually says well done. He's the only one who ever treats the number itself like something worth being proud of, not just something to check off."}},
  {type: "action", text: "Mama rolls her eyes but remains incredibly still."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So you wanted me to come in fucked up? Would that have made this better? For you to catch me out?", impacts: {anesuGuard: 1}},
  {type: "action", text: "The three stand silently in the hallway, Mama and Anesu staring coldly at one another and Dad in the middle, unsure of where to look."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "She is sober and that's all that matters. Right Ruby?", impacts: {familyAwareness: 0.5}},
  {type: "thought", text: "She couldn't care fucking less. She just wants to catch me out and then scream at me."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I'm going to bed.", impacts: {anesuGuard: 1, mamaTrust: -1}, memoryEntry: {who: "Mama", text: {
    blind: "She just left. Didn't even try. Typical.",
    uncertain: "She walked away instead of fighting for once. I don't know if that's worse or better than the yelling.",
    aware: "She didn't storm off because she doesn't care. She left because staying would've meant admitting something she's not ready to admit. I've done the same thing to people. I recognize it now."
  }}},
  {type: "action", text: "Mama turns on her heel, and storms to bed, closing the door behind her, leaving Anesu and Dad in the hallway. Tears begin to well in Anesu's eyes. Dad opens his arms but Anesu just walks into him, arms by her side."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I love you Anesu. I know you're trying.", impacts: {anesuGuard: -1, dadTrust: 1}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "..."},
  {type: "action", text: "Anesu stays being held, not really one for hugs but knows that's how Dad shows his love, his attention, his concern. They stay for what feels like hours. He was waiting for her to raise her arms."},
  {type: "thought", text: "Fine, you got me."},
  {type: "action", text: "Anesu wraps her arms around her father, and feels his heart skip a beat. He tightens his grip and breathes in her hair."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "My little girl...", impacts: {anesuGuard: -1, dadTrust: 1.5}, memoryEntry: {who: "Dad", text: "He called me his little girl. I'm nineteen. I let it happen anyway, because for once it didn't feel like a cage, it felt like something I'd been missing."}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "..."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I love you so much."},
  {type: "continueTo", dest: "B1C1_05_Transition"}
]>>
<<set $beatIndex to 0>>

