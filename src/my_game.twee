:: B2C1_03_FamilyDinner {"position":"400,600","size":"100,100"}
<<set $sceneBeats to [
  {type: "action", text: "The engulfing scent of steak paired with garlic potatoes fills the house, the kitchen lively with dancing hands, bouncing from the sink to stove to benchtop."},
  {type: "action", text: "Erin plates the food with care and love. Two plates for two guests."},
  {type: "action", text: "Her feet drag along the floor as she holds the plates with care, looking back at Robert, giving him a wink. She manages the feat and pours them both a glass of orange juice."},
  {type: "action", text: "She places Robert beside her and grabs her knife and fork..."},
  {type: "action", text: "...just to put it down again. To sit and stare..."},
  {type: "action", text: "Her face falls slowly and the colour drains from her face ever so more."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Erin?"},
  {type: "action", text: "Tears begin to well and threaten to fall, her nose scrunching as if she's holding them up and in."},
  {type: "action", text: "She holds herself, tense and rigid."},
  {type: "action", text: "You look out to where she's staring and hold the vision."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Let's take a look..."},
  {type: "choices", options: [
    {text: "You can cry, Erin...", dest: "B2C1_03a_YouCanCry"},
    {text: "Oh Erin, breathe.", dest: "B2C1_03b_Breathe"},
    {text: "You're safe, Erin...", dest: "B2C1_03c_YoureSafe"}
  ]}
]>>
<<set $beatIndex to 0>>

