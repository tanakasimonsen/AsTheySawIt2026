:: B1C2_05_Blocked {"position":"750,550","size":"100,100"}
<<set $currentDate to "Wed, 24 April 2024">>
<<set $currentTime to "6:11pm">>
<<run updateAngelStatus()>>
<<set $eliasBlocked to true>>
<<run State.variables.anesuGuard = Math.min(10, State.variables.anesuGuard + 1)>>
<<set $sceneBeats to [
  {type: "text", side: "me", text: "hey sorry i didn't message you much today, things at home were a little hectic.", time: "6:12pm"},
  {type: "text", side: "me", text: "thank you so much for last night. i had such a great time!", time: "6:12pm"},
  {type: "action", text: "Sending... sending... sending..."},
  {type: "action", text: "ERROR: message couldn't be received."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Huh?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Lemme just try again."},
  {type: "text", side: "me", text: "sorry for not messaging today, but thank you so much for last night. i had such a great time with you. see you sooon?", time: "6:14pm"},
  {type: "action", text: "Sending... sending... sending..."},
  {type: "action", text: "ERROR: this message couldn't be received."},
  {type: "action", text: "The world goes black. Her heart drops to the pit of her stomach. The screen goes blurry, mouth instantly dry.", anesuSide: true, impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No no no."},
  {type: "action", text: "Anesu opens the app they met on, watching his profile disappear.", impacts: {anesuGuard: 1}, memoryEntry: {who: "Elias", text: "He's a fucking prick. He only wanted me for sex. I don't know why I ever thought it was more."}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No no no no no no no."},
  {type: "action", text: "Her heart pounds. She chews on her lip ring, unsure what to do with her hands.", anesuSide: true},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Anesu, take a deep breath."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "NO NO NO NO NO NO NO."},
  {type: "action", text: "She keeps messaging, watching each one bounce back."},
  {type: "text", side: "me", text: "um hey! did i do something wrong? we had such a nice time last night... maybe we can talk???", time: "6:19pm"},
  {type: "action", text: "Sending... sending..."},
  {type: "text", side: "me", text: "can we talk about it??", time: "6:20pm"},
  {type: "action", text: "Sending... sending..."},
  {type: "text", side: "me", text: "you had such a good time! at least i thought you did...", time: "6:21pm"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Anesu, he's blocked you. He can't see these—", interrupted: true},
  {type: "text", side: "me", text: "can we talk this out? maybe i can fix what i did?", time: "6:22pm"},
  {type: "action", text: "Sending... sending..."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "You didn't do anything, Ne. He's just an—", interrupted: true},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "MAYBE I DID DO SOMETHING."},
  {type: "text", side: "me", text: "i can come over tonight???? we can talk about it???", time: "6:23pm"},
  {type: "action", text: "Sending... sending... sending..."},
  {type: "action", text: "ERROR: your message cannot be received."},
  {type: "action", text: "The tears stream and pour, pooling in her socks.", anesuSide: true, impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Oh, Su. It's okay, love."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What did I do wrong? I just don't get it... why did he have to block me? He couldn't have just said it straight up? WHY DO I ALWAYS DO SOMETHING WRONG?"},
  {type: "freeType", side: "character", speaker: "Higher Power", text: "Anesu, you cannot be so quick to blame yourself. You didn't do anything wrong."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "It was such a loving night. I mean the way he touched me — who does that?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Someone with severe issues, that's who."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I mean, what's wrong with me... am I not pretty enough?"},
  {type: "action", text: "Anesu stares at herself in the mirror across the room, eyes bloodshot, nose puffy. She turns side to side, looking at all angles.", anesuSide: true, impacts: {familyAwareness: 0.5}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I mean, I finally got my skin clear!! Maybe I should wear more makeup, or lose more weight."},
  {type: "freeType", side: "character", speaker: "Higher Power", text: "This is madness, Anesu. We need to take a step back.", impacts: {anesuGuard: 1, familyAwareness: 1}},
  {type: "continueTo", dest: "B1C2_CS_ThePlaylist"}
]>>
<<set $beatIndex to 0>>

