:: B1C1_04_Deny {"position":"1075,325","size":"100,100"}
<<set $sceneBeats to [
{type: "dialogue", side: "player", speaker: "Anesu", text: "No, I'm not doing it."},
  {type: "action", text: "Dad winces, waiting for hell to break loose for this one."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "What did you say?"},
  {type: "thought", text: "Mama loves to do the \"what did you say?\" To scare you into second guessing your response. So you will change it."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I said, I am not doing a breath test. I'm an adult, it is my body."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're an adult in the eyes of the law, yes. In this house, in THIS HOME, you will do what I say.", impacts: {anesuGuard: 1}},
  {type: "thought", text: "There's the famous speech. IN MY HOUSE BLAH FUCKING BLAH BLAH. NO ONE CARES."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "She's done a test every night this week hun. I think it's time we sta—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "THERE WILL BE NO SUCH THING!"},
  {type: "action", text: "She raises her voice and shakes her arm. Micah comes out into the hallway, wondering what's going on. Anesu eyes him but darts back to Mama."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "YOU LOST THE OPPORTUNITY TO BE AN ADULT WHEN YOU DECIDED TO DRINK LUDICROUSLY. YOU HAVE LOST THE PRIVILEGE OF YOUR PRIVACY, YOUR AGENCY AND INDEPENDENCE.", impacts: {anesuGuard: 1.5, mamaTrust: -1.5}, memoryEntry: {who: "Mama", text: {
    blind: "She says I lost the right to be an adult. Fine. Maybe she's right. Maybe I did. But I never wanted to be an adult, I shouldn't have lived for this long",
    uncertain: "She says I lost my privacy,my independence — like flipping a switch. As if six months doesn't count for anything.",
    aware: "She still talks about it like it's a punishment she's handing down, not love she's trying to give. I think that's just how it comes out of her, care disguised as instruction, warmth turned into contro. I don't know if she knows how to do it any other way."}}},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Ruby hun, it's ok—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "IT IS NOT OKAY! WHY MUST YOU ALWAYS SIDE WITH HER."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "There are no sides. We're a team. We all are!"},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Do we really have to yell though?"},
  {type: "action", text: "The three of them look to Micah down the hall, standing in his boxers."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Just do the test Su, get it over and done with.", memoryEntry: {who: "Micah", text: "He tells me to just do the test. Not defending me, not against me. Just tired. I don't think he's picked a side — I think he's stopped believing there's a side worth picking."}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No! She does not get to dictate what I can and cannot do. I already have my door open, I already have a 9pm curfew and I HAVE MY LOCATION ON CONSTANTLY."},
  {type: "thought", text: "I've lost all independence! Rehab or be kicked out? Of course I went to fucking rehab. I HAD NO CHOICE.", impacts: {anesuGuard: 1}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "And go to fucking bed Micah, I mean Jesus Christ man."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Micah is a part of this family.", impacts: {familyAwareness: 1, dadTrust: 0.5}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "But he doesn't need to be all up in my business!"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "YES! IF IT'S HIS SISTER DRINKING HER LIFE AWAY!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'M NOT AN ADDICT!", impacts: {anesuGuard: 1}},
  {type: "action", text: "The house falls silent, the yelling too much for a Sunday evening. They all stare at each other, unsure of where to go from here."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "I'm going to bed."},
  {type: "thought", text: "This fucking prick."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah good idea."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Anesu if you walk to your room, so help me!"},
  {type: "action", text: "Anesu whips around, holding a rude stare."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What else could you possibly do!? I'VE DONE EVERYTHING YOU ASKED!"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Stop yelling Su."},
  {type: "thought", text: "Shut the fuck up Dad."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I've done everything you've asked. I went to rehab, I go to meetings. My door is open, and I comply to every strip search and breath test. Tonight I am saying no. Good night."},
  {type: "thought", text: "Keep walking, keep walking, keep walking."},
  {type: "action", text: "Anesu walks swiftly to her room and closes the door ever so softly."},
  {type: "thought", text: "Cannot give her a reason to come back here."},
  {type: "action", text: "Ruby and Gerald stand in the hallway staring blankly at one another.", impacts: {familyAwareness: 1}},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I try so hard Gerald. I just want her to be her best self."},
  {type: "action", text: "A tear falls and she holds her face, trying to push them back in."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I know hun hun.", memoryEntry: {who: "Dad", text: "He didn't come find me tonight. He stayed with her. I get it..."}},
  {type: "action", text: "The two hold each other in the hallway, standing in embrace. In frustration.", impacts: {anesuGuard: 1}} ,
  {type: "continueTo", dest: "B1C1_05_Transition"}
]>>
