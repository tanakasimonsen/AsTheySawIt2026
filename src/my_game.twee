:: B1C3_Transition_Gym {"position":"375,900","size":"100,100"}
<<run $('body').removeClass('scene-night')>>
<<set $currentTime to "11:30am">>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "So what are you hitting today?"},
  {type: "action", text: "Anesu dumps her bag in one of the empty pigeon holes and fills her water bottle."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Back and biceps. Missed a session last week."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Oh nice."},
  {type: "action", text: "She storms to the treadmill, connecting her headphones."},
  {type: "action", text: "Power on, battery low."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "For fuck's sake."},
  {type: "action", text: "Connected."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Oh, thank goodness."},
  {type: "action", text: "Now playing: Get JACKed, playlist created by Su."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Are we just not going to talk about what happened?"},
  {type: "action", text: "Anesu increases the incline and adjusts her bodysuit. She shrugs her shoulders."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm never gonna be able to be a part of the family again. Micah is never gonna let me in. I don't know what else I can possibly do..."},
  {type: "action", text: "Anesu checks the clock, 2 out of 5 minutes."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I ask how he is, how class is. If there are any girls in his life... how his friends are. If he wants to hang out with me... if I can join him and his friends."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "It's never enough!"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "It just takes time, Su."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "But how much time?! I did my amends but that clearly wasn't enough. So where does it end? When can the new chapter begin?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "It will begin when he is ready..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "But how much more time will we waste? Will he waste? We'll just drift further and further apart until he won't even give me the time of day."},
  {type: "action", text: "Anesu hops off the treadmill and makes her way to the free weights, grabbing a 10kg dumbbell. She kneels her left leg on a bench and begins to row the weight."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Never seen you do this exercise before."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah, learnt it from a gym friend a few weeks ago. Apparently it's better than the cable row."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "But why do you have to prove to Micah that you're better?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Because I want my brother back! I want him to tell me things, involve me in his life. Doesn't he want me in his life?"},
  {type: "action", text: "Set one done."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "He does, Su, it's just hard for him."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What is so fucking hard? What could possibly be so difficult?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "He doesn't know if you're going to go back, Su. He needs stability, just as much as you do. If not more. You're his big sister, the rock that finally rolled over.", impacts: {familyAwareness: 1, micahTrust: 0.5}},
  {type: "action", text: "Set three done."},
  {type: "action", text: "Anesu re-racks her weights and walks over to the lat pulldown."},
  {type: "action", text: "Set one."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Lord, we're only 2 years apart. It's not like I'm some huge figure in his life."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "He's still the baby you were waiting for from the hospital."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Now we need to start managing our expectations, otherwise you're gonna be hurt over and over."},
  {type: "action", text: "Set two."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Not this again."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Well, it's the truth, you expected Micah to start telling you things and letting you in. But then he didn't, the realisation and disappointment is what's crushing you. So we need to manage that. Because he will not change overnight."},
  {type: "action", text: "Set three."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So what am I supposed to do now? Push my feelings aside?"},
  {type: "action", text: "Anesu lumbers over to the cable machine and attaches the double ropes. She sets the weight and pulls the rope down with her into a sitting position."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Not push your feelings aside... Clean your side of the street. You acknowledge your feelings. That's great. They now need to go somewhere while we wait for those we love to grow alongside us.", impacts: {anesuGuard: -0.5}},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "We write them down, or hand it over to your Higher Power. Like we're doing right now."},
  {type: "action", text: "Set one."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Acknowledge the feelings, but don't push them down, hand them over to me so it doesn't weigh you down and come out in heated moments. And come out with the wrong words."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "How long do I have to do that for? Hide and filter my feelings."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "No one said hide or filter, it's just managing them so you don't drown."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "It'll take as long as it takes. Remember you only have to do it for a day."},
  {type: "action", text: "Set two."},
  {type: "action", text: "Anesu pauses before she begins, looking at her reflection in the mirror ahead."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "A day?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Yep. Just one more day.", impacts: {anesuGuard: -1}},
  {type: "action", text: "Anesu sighs and readjusts her grip."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Now finish your workout, you don't need me in your ear for the rest of it."},
  {type: "continueTo", dest: "B1C4_ErinCheckIn"}
]>>
<<set $beatIndex to 0>>

