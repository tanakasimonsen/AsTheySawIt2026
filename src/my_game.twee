:: B1C1_02_FirstNightwithAnesu {"position":"425,225"}
<<run $('body').removeClass('scene-night')>>
<<set $currentDate to "Sun, 21 Apr 2024">>
<<set $currentTime to "8:45pm">>
<<run setAmbience('audio/meeting_exterior.mp3')>>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "dialogue", side: "character", speaker: "Erin", text: "Well that was a lovely meeting! Andy finally shared."},
  {type: "thought", text: "I never know how to respond to someone saying a \"good meeting\", they can be so depressing sometimes, and so was Andy's share. And Jordan! God man you're 40 something years old, get your shit together!"},
  {type: "action", text: "Erin's door thuds shut.", sound: "audio/car_door.mp3"},
  {type: "action", text: "With Anesu a beat after.", sound: "audio/car_door.mp3"},
  {type: "action", text: "The engine turns over.", sound: "audio/engine_start.mp3", soundId: "engine", soundPersist: true},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Mhmm, yeah, a great meeting. Thank you for driving me home Erin."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "You know it's no trouble love. Soon you can drive me! When you get your P's!"},
  {type: "action", text: "Erin flashes Anesu a smile and pulls out of the carpark, forgetting to put her seatbelt on.", sound: "audio/seatbelt_ding.mp3"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Doesn't the dinging bother you?"},
  {type: "choice", side: "character", speaker: "Erin", text: "What dinging?", dest: "B1C1_03_AnesuDoorstep"}
]>>

