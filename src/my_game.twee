:: B1C2_02_GoingToSeeElias {"position":"500,550","size":"100,100"}
<<set $currentDate to "Tue, 23 April 2024">>
<<set $currentTime to "10:00pm">>
<<set $wentToElias to true>>
<<run updateAngelStatus()>>
<<run $('body').addClass('scene-night')>>
<<set $sceneBeats to [
{type: "narrative", heading: "10:00PM", text: "The night ages and Anesu climbs into his car.", night: true, time: "10:00pm"},
{type: "dialogue", side: "character", speaker: "Elias", text: "So did you miss me?"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Hmmm not really, you kinda disappeared on me..."},
{type: "dialogue", side: "character", speaker: "Elias", text: "Yeah yeah I know, I'm sorry baby. I just get so busy..."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "But you said that..."},
{type: "dialogue", side: "character", speaker: "Elias", text: "But tonight is all about you okay? Just us. I've been thinking about you, you know?"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Then why don't you message?"},
{type: "action", text: "Elias gives her a look. The \"don't start now\" type of stare."},
{type: "action", text: "Anesu bites her lip and picks at her nails."},
{type: "dialogue", side: "character", speaker: "Elias", text: "Your nails look gorgeous by the way."},
{type: "interject", text: "He didn't even look up."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Oh really? Thank you! I got them just las—", interrupted: true},
{type: "dialogue", side: "character", speaker: "Elias", text: "They're very nice."},
{type: "action", text: "Elias turns up the volume on the radio, one hand on the wheel, the other on the gear stick..."},
{type: "interject", text: "The car's automatic, buddy. Just put a hand on her thigh or something."},
{type: "action", text: "The two sit in silence, excitement oozing out of Anesu."},
{type: "thought", text: "I can't believe he's finally seeing me!"},
{type: "interject", text: "Neither can I..."},
{type: "continueTo", dest: "B1C2_03_MorningWithElias"}
]>>
<<set $beatIndex to 0>>

