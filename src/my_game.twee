  {type: "dialogue", side: "character", speaker: "???", label: "Mabel", text: "My name is Mabel, a Guardian Angel of this meeting. Now I have help!", setVar: "bossName", setValue: "Mabel"},
  {type: "dialogue", side: "character", speaker: "Guardian Angel", label: "Mabel", text: "I'm assuming you're new?"},
  {type: "dialogue", side: "character", speaker: "Guardian Angel", label: "Mabel", text: "What can I call you?"},
