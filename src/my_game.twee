:: V3_03_Opening_LeftOut {"position":"500,750","size":"100,100"}
<<set $sceneBeats to [
  {type: "interject", text: "You're right, it's not nice. But maybe we can have this discussion another time. I think Micah is trying to relay genuine information."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "I seriously don't know how you've made this about yourself. Micah was just telling us something amazing and you've come in and ruined it."},
  {type: "action", text: "Anesu stops stirring and looks to her mother instead of the pouring milk."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Make it about myself? All I'm asking is why hadn't I been told?! I feel like that's a fair question to freaking ask."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "But you've come in and made Micah's conversation about you."},
  {type: "action", text: "Her coffee stays steaming on the bench, like some people in this room. "},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Me asking a question is making it about me? Oh okay."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Ru, Su. Let's not right now, okay."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No no, Mama said I'm making it about me, let's take it all the way there!!", impacts: {anesuGuard: 1.5}},
  {type: "action", text: "The fresh cup made to perfection, fizzling out. Maybe this would go differently if it was drunk first"},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Come on Su."},
  {type: "thought", text: "I look at Micah and watch his jaw clench and unclench profusely. I can't let Mama win, but I can't ruin this for Micah."},
  {type: "choice", side: "player", speaker: "Anesu", text: "I'm going to the gym.", impacts: {anesuGuard: 1}, memoryEntry: {who: "Mama", text: {
    blind: "She said I make everything about myself. She isn't 100% right.",
    uncertain: "I don't know why I couldn't just let it go this time. I usually can.",
    aware: "She just knows what will set me off. She's too good. As soon as she said ruined, I saw red.",
  }}, dest: "V3_Transition_Gym"}
]>>
