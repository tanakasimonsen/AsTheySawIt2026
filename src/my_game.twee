:: V2_Transition {"position":"900,550","size":"100,100"}
<<run $('body').addClass('scene-night')>>
<<set $currentDate to "Thu, 2 May 2024">>
<<set $currentTime to "11:40pm">>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "action", text: "Anesu lies in bed, trying to get to sleep. Her mind races."},
  {type: "thought", text: "His hand on my jaw before he even said anything. Like he already knew."},
  {type: "thought", text: "The way he said my name like it meant something. Not like the others."},
  {type: "thought", text: "I don't even remember what we talked about after. Just that I didn't want it to stop."},
  {type: "thought", text: "He looked at me like—"},
  {type: "action", text: "She stops the thought before it finishes."},
  {type: "thought", text: "God, I actually let myself believe it. For one night."},
  {type: "breathe", text: "She stares at the ceiling.", duration: 2500},
  {type: "thought", text: "I never really liked romance films... I mean, I did when I was a child and had my celebrity crushes and fantasised like the naive child that I was."},
  {type: "thought", text: "But then I realised, at some point, I'm not going to have... that. I mean, don't get me wrong, a girl dreams and hopes and wishes."},
  {type: "thought", text: "But seeing it happen — that cropped landscape frame, the swelling score, dialogue that hits too close to home... I've grown to feel jealousy. To feel envy."},
  {type: "thought", text: "Imagination and the feel-good, dissipated with every foul action some man has decided to douse on me, and I'm left dripping cold and wet every time."},
  {type: "breathe", text: "She stares at the ceiling.", duration: 2500},
  {type: "thought", text: "Romance makes me awfully sad. I become ill, green, and freeze up. Rendered helpless. Unable to see the beauty in love without feeling such envy."},
  {type: "thought", text: "It's quite selfish and self-absorbed, but it's the truth!"},
  {type: "breathe", text: "She doesn't finish the thought. Not yet.", duration: 3000},
  {type: "thought", text: "So I just went the opposite route. There's something brilliant in the grotesque and the macabre. The outcast and misunderstood."},
  {type: "thought", text: "Of course I'm not appeasing and justifying the killers created and depicted in the film, but it's familiar. Somewhat home."},
  {type: "thought", text: "I feel as if my soul may be displaced. I know what went wrong on the way... I think."},
  {type: "thought", text: "The yearn for being a lover, a mother, someone's other... but it won't come true."},
  {type: "breathe", text: "Her breathing catches. Quiet, almost nothing.", duration: 3000},
  {type: "thought", text: "It would be unfair on myself to hope and wish, to then fall so deeply and never be caught."},
  {type: "action", text: "A tear slips, then another. She doesn't wipe them."},
  {type: "breathe", text: "She lies still, letting it happen.", duration: 3500},
  {type: "thought", text: "So let's remain rational."},
  {type: "action", text: "Anesu sits up sharply, wiping her face with the back of her hand."},
  {type: "thought", text: "Let's stop dreaming and gallivanting among ridiculous ideas..."},
  {type: "thought", text: "I guess I can just be."},
  {type: "continueTo", dest: "V3_01_Opening"}
]>>
<<set $beatIndex to 0>>
