:: B1C2_StayingHome{"position":"700,750","size":"100,100"}
<<set $currentDate to "Wed, 24 April 2024">>
<<set $currentTime to "8:35pm">>
<<run $('body').removeClass('scene-night')>>
<<run updateAngelStatus()>>
<<set $eliasBlocked to false>>
<<set $wentToElias to false>>
<<run State.variables.familyAwareness = Math.min(10, State.variables.familyAwareness + 0.5)>>
<<set _baseBeats to [
  {type: "action", text: "Anesu keeps her eyes down as her headphones drown out that yapper, hanging out at the back of her skull."},
  {type: "thought", text: "He's now found someone else. Poof, just like that. You don't matter anymore."},
  {type: "freeType", side: "character", speaker: "Higher Power" , text: "Hey! Shush! You aren't helping."},
  {type: "action", text: "Anesu scoffs as she moves the fruit bowl out of the way, wiping away dust and dirt."},
  {type: "action", text: "Ruby looks up from her book, peering over the edge from the couch across the room."},
  {type: "thought", text: "Why did you say no?! This was your chance! You could've been his!"},
  {type: "thought", text: "We don't know that now, do we?"},
  {type: "thought", text: "YES WE DO! Did you not see what he said when she said she wasn't coming over?"},
  {type: "thought", text: "..."},
  {type: "thought", text: "..."},
  {type: "thought", text: "..."},
  {type: "thought", text: "But he was only like that 'cause we said no."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "YEAH, he was a PRICK after setting a BASIC BOUNDARY? That's someone we want for Anesu?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Guys, not now..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "He's just gonna block me now... I can feel it. Once they stop messaging for"},
  {type: "action", text: "Anesu checks her phone to see the delivered signage."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "this long, it's game over."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Idk how to describe it. It's this sinking feeling. My heart is eating my stomach. My intestines are knotting and engulfing my liver and kidneys..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "My bones begin to rattle and my blood stream grinds to a halt. It's an awful sickening feeling of intense incurable rejection and it happens every time..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "It's like a sixth sense... kinda like when deers know when a storm is coming before the wind changes. The first thought that comes to mind is to block them first before they do... but then there's the what if? What if they are different... what if they change this time?"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Then why do it, Anesu?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Idk bec—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Su? I think that spot is clean."},
  {type: "action", text: "Ruby has been watching her mid-wipe the same spot for the past 10 minutes, staring straight ahead, stare never wavering."},
  {type: "action", text: "Anesu shakes it off and clears her throat, swallowing the despair."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "What's wrong, sisi? Something's obviously troubling you."},
  {type: "freeType", side: "character", speaker: "Higher Power", text: "Tell her, Su."},
  {type: "thought", text: "No don't, she's just going to bag you and sink her nails in further. You can smoke about it later."},
  {type: "action", text: "Anesu takes a deep shaky breath, ringing out the cloth for the seventh time."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Why don't guys want me?"},
  {type: "action", text: "Ruby watches her face crack and tears spill over, the whites of her eyes turned bloodshot. Ruby stays still, watching for the next sentence."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Why can't I just have a date?"},
  {type: "action", text: "And there it all goes. The floodgates are shattered and the salt dries her out."},
  {type: "action", text: "Ruby stays still, her arms twitch a little to instinctively give a hug, but she remains stoic."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Because men are assholes. Especially at this age. They are unable to see outside of themse—", interrupted: true},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "But why can't I just have it ONE TIME! I don't understand what's so horrible about me!"},
  {type: "action", text: "Ruby's face falters and she scowls at her daughter."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Uh oh."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Why is it automatically your fault? Are you actively picking dickheads?"},
  {type: "action", text: "Anesu licks the tears and snot building up on her lips, wiping away the uncontrollable jealousy and resentment she now felt."},
  {type: "thought", text: "See? You're a fucking mess, girl. Crying over a man who doesn't care."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No I'm no—"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "So then why is it that YOU'RE the issue? I clearly must be missing something."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'm the common denominator."},
  {type: "action", text: "She spits it out."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I do everything right. And I just can't seem to be wanted by anyone!"},
  {type: "action", text: "She continues to sob in the kitchen, silently as to be sure Micah and Dad don't come out to see the commotion."},
  {type: "thought", text: "They always need to know what's going on."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "We want you..."},
  {type: "thought", text: "Yeah, fucking right."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "You know what I mean..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "What is so horrible about me? Am I that ugly? Am I that unlovable? That undesriable? What else do I have to fix??"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Oh Su, it's not you."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "It's not about you, sisi, it's these awful terrible men that cannot think outside themselves. I do not agree with anything that you're saying. It's completely absurd."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You are such a kind girl, sisi. Too kind for that matter. You've been through too much for some man, some WHITE man, to diminish your light and render you feeling like this."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "Okay I don't think ethnicity has anything to do with this but I like where she's going."},
  {type: "thought", text: "Eh, Mama has a thing about white people. Doesn't like them, yet she married one."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "It absolutely breaks my heart seeing and hearing you determine your worth and value off what some man says and thinks about you. Because it is most likely ridiculously untrue."},
  {type: "action", text: "Ruby has tried so hard to build her daughter up to never even consider, to never even think twice about what a man could possibly say about her."},
  {type: "action", text: "But it's hard when the outside world tells her everything but."},
  {type: "thought", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Am I really that terrible, Mama? What did I possibly do to be treated like this?"},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Oh Su, it's hard... you also don't really help yourself... these men you find on dating apps are not the ones you want to be with."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So where do I meet them? A bar?? A club?! They're all drunk and sloppy and I can taste the alcohol on them."},
  {type: "thought", text: "..."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Then clearly your Higher Power has something else in store for you."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "*wink*"},
  {type: "thought", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I'd make such a good partner."},
  {type: "action", text: "She breaks one more time, eyes scrunching up hard. And all Ruby can see is her 4 year old Anesu, standing alone in the kinder yard, finding someone to share her flowers with."},
  {type: "action", text: "Ruby tip toes over to Anesu and places her hand on her shoulder, leaning her head forward to touch her daughter's."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You'd be an incredible partner. The man you choose to be your husband will be the luckiest man alive."},
  {type: "thought", text: "..."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Then why does no one want me?"},
]>>

<<if $v1Ending is "Deny">>
<<set _endingBeats to [
  {type: "action", text: "The two stand in the kitchen together, but Ruby doesn't lean for her forehead this time. She reaches for her hand instead, holding it a tad too tight, still not sure it'll be allowed."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "We want you all the time. All the fights, all the bickering. All the growth."},
  {type: "action", text: "Her hand... it's always been cold. It's not smooth. It's not soft. But it's true, and Anesu can feel the determination, dripping down her knuckles."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're one of the best things that ever happened to me, sisi. I don't always say it right."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Thank you, Mama."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text:"See? She really does care for you."},
  {type: "continueTo", dest: "B1C2_Transition"}
]>>
<<elseif $v1Ending is "Comply">>
<<set _endingBeats to [
  {type: "action", text: "The two stand in the kitchen together, foreheads pressed, heat and unconditional love being shared."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "We want you all the time. Of every day."},
  {type: "action", text: "Anesu stiffens, just slightly, at the closeness. Some part of her still braced a backhanded comment, the aftertaste of the breathalyser."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're one of the best things that ever happened to me, sisi."},
  {type: "action", text: "She exhales shakily, an unnoticed weight alleviated somewhat."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I am??"},
  {type: "action", text: "She almost doesn't let herself believe it. Almost."},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "You truly are, Anesu."},
  {type: "continueTo", dest: "B1C2_Transition"}
]>>
<<else>>
<<set _endingBeats to [
  {type: "action", text: "The two stand in the kitchen together, foreheads pressed, heat and unconditional love being shared."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "We want you all the time. Of every day."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You're one of the best things that ever happened to me, sisi."},
  {type: "action", text: "She exhales shakily, an unnoticed weight alleviated somewhat."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I am??"},
  {type: "dialogue", side: "character", speaker: "Higher Power", text: "You truly are, Anesu."},
  {type: "continueTo", dest: "B1C2_Transition"}
]>>
<</if>>

<<set $sceneBeats to _baseBeats.concat(_endingBeats)>>
<<set $beatIndex to 0>>

