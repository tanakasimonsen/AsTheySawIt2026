<</if>>
<<run $('#chatLog').scrollTop($('#chatLog')[0].scrollHeight)>>
<</widget>>

:: V3_01_Opening {"position":"375,625","size":"100,100"}
<<run $('body').removeClass('scene-night')>>
<<set $currentDate to "Sat, 4 May 2024">>
<<set $currentTime to "10:52am">>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
  {type: "action", text: "The sun bleeds through the beige curtains, tickling Anesu's eyelids."},
  {type: "thought", text: "Mhmmmmm."},
  {type: "interject", text: "Yeah it is a little bright hey? But gosh it's so warm. Isn't it glorious? I wouldn't mind being able to feel sun again."},
  {type: "action", text: "She opens an eye, darting around to find the alarm clock. 10:52am."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "How the hell is it 10:52??"},
  {type: "interject", text: "This is why we shouldn't be up and out smoking. We should start reading again or something."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Yeah yeah, smoking is fun."},
  {type: "action", text: "Anesu coughs hard, nose flaring with each inhale and exhale."},
  {type: "interject", text: "Is it though?"},
  {type: "action", text: "Anesu rolls her eyes, hawking back the phlegm, scraping eye boogies out. She sits up higher and focuses in on the noises in her home."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Damn, everyone's already at it."},
  {type: "action", text: "She whips off the warm sage covers and slips on her uggs, scratching her tummy as she trods down the stairs."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Oh Micah, that is so cool! So when do you start?"},
  {type: "dialogue", side: "character", speaker: "Micah", text: "First class is next week! They accepted my grades for the last few semesters and that test I did last week was the final \"round\" to get in."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Oh, so that's where I was taking you."},
  {type: "action", text: "Mama rolls her eyes."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "How did you not realise you were taking him to the exam hall?"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Well idk, he told me the address and I took him!"},
  {type: "thought", text: "I wonder what they're talking about..."},
  {type: "action", text: "Su yawns aggressively and smiles as she walks into the living room, passing the dining table to make a cup of coffee."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So what's so cool?"},
  {type: "action", text: "Anesu grabs the kettle, and clicks open the lid, filling it up at the sink."},
  {type: "action", text: "Mama, Dad, and Micah look at each other for a second too long, and Micah clears his throat."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Oh yeah, just my new study program, I got accepted into the elite extensive program for applied physics. It'll go towards my masters.", impacts: {familyAwareness: 1}},
  {type: "action", text: "Anesu's eyes shoot up and the kettle begins to overflow."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Careful there."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Um, since when?! You've expanded to your masters???"},
  {type: "dialogue", side: "character", speaker: "Micah", text: "I've been doing this for over a year now dude. Been prepping and studying, and whatnot."},
  {type: "thought", text: "Micah and I are two years apart. We grew up very close but of course drifted during my drinking and because of my actions... but also she fell victim to mental illness and bouts of depression, but I digress."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Why didn't you say anything?? I mean over a year??", impacts: {anesuGuard: 0.5}},
  {type: "action", text: "I pour some water into the plant next to the stove and boil the rest, clicking it quickly."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So? Why not say anything, man? I'm your sister."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Yeah but you haven't been around dude."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Haven't been around?? It's been 6 months!"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Yeah but he's saying before that. This all happened while you were drinking."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Okay, I understand that, but were you all just never going to say anything? I'm part of this family too."},
  {type: "action", text: "Mama crosses her arms, and purses her lips."},
  {type: "action", text: "The kettle continues to boil, the bubbles speeding up as the pressure in the room builds."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I mean you all talk about everything, why can't I be included?"},
  {type: "dialogue", side: "character", speaker: "Micah", text: "Well you weren't there, and I didn't bother to update you because there's a lot of backstory."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I did my amendments, how is this not enough?"},
  {type: "breathe", text: "The kitchen goes quiet for a moment.", duration: 2000},
  {type: "freeType", side: "character", speaker: "Higher Power", text: "I know, but sometimes it takes more time. You've grown and you keep growing — maybe they are still stuck from the day you went to rehab.", impacts: {familyAwareness: 1}},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Sisi, you weren't there when this all happened, and it's just kept going on and on."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "So what? I can't know anything? It's been so long and I've been sober for half the time of this happening."},
  {type: "dialogue", side: "character", speaker: "Micah", text: "You can know things, you just didn't ask."},
  {type: "action", text: "The kettle clicks off and steam billows up onto the cabinets."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "How am I supposed to ask about something I don't know about?"},
  {type: "breathe", text: "The room holds its breath.", duration: 2000},
  {type: "freeType", side: "character", speaker: "Higher Power", text: "Su, let's be mindful that it's 11am. We cannot come in hot like this."},
  {type: "action", text: "Should Anesu..."},
  {type: "choice", side: "player", speaker: "Anesu", text: "So what, it's 11am? My feelings are hurt!", dest: "V3_02_Opening_MyFeelingsHurt", impacts: {anesuGuard: 0.5}},
  {type: "action", text: "or..."},
  {type: "choice", side: "player", speaker: "Anesu", text: "Yeah I understand, but this isn't nice — why am I being left out?", dest: "V3_03_Opening_LeftOut", impacts: {familyAwareness: 0.5}},
  {type: "action", text: "or..."},
  {type: "choice", side: "player", speaker: "Anesu", text: "Whatever, I'm going to the gym.", dest: "V3_04_Opening_GoToGym", impacts: {anesuGuard: 1}}
]>>
<<set $beatIndex to 0>>

