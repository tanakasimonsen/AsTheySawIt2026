:: B1C2_03_MorningWithElias
<<set $currentDate to "Wed, 24 April 2024">>
<<set $currentTime to "7:45am">>
<<set $wentToElias to true>>
<<run updateAngelStatus()>>
<<set $sceneBeats to [
{type: "narrative", heading: "THE NEXT MORNING", text: "Anesu wakes in his bed to a wall of notifications.", night: false, time: "7:45am"},
{type: "action", text: "6 missed calls from Mama. 5 missed calls from Dad. A message from Micah."},

{type: "phoneMessages", messages: [
  {side: "them", sender: "Mama", text: "Where are you? Why are you not home?"},
  {side: "them", sender: "Mama", text: "Anesu, pick up the phone. Come home right now. Why is your location off? Who are you with? What are you hiding?"},
  {side: "them", sender: "Mama", text: "You better be home within 30 minutes or I am changing the locks."},
  {side: "them", sender: "Dad", text: "Why didn't you tell anyone you were going out last night? You have to tell us these things. You can't just disappear."},
  {side: "them", sender: "Dad", text: "Please just come home, Anesu. You know better than this. Come home right now."},
  {side: "them", sender: "Micah", text: "Bro mums crashing out. What did you do?"}
]},

{type: "action", text: "Anesu wakes groggily, far to the right of the bed, too far from his arms. Her eyes widen — she's in his bed, not her own."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Shit shit shit shit."},
{type: "action", text: "She shakes him awake, insisting she needs to be taken home right away. It's 8am — early, and her energy is rushed and frazzled.", time: "8:00am"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "I am so sorry to rush you, I just completely forgot I had an important event this morning."},
{type: "dialogue", side: "character", speaker: "Elias", text: "It's totally fine, don't gotta say sorry."},
{type: "action", text: "The car is silent apart from the clicking of gel nails on a phone screen. Anesu is furiously typing responses to the family."},
{type: "dialogue", side: "player", speaker: "Higher Power", text: "Now Anesu, you can't come in hot. Yes, we're somewhat in the wrong, but they don't really know that — we cannot come off defensive."},
{type: "thought", text: "Yes yes, I get that."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Sooo can I see you next week?"},
{type: "action", text: "Elias remains silent, staring ahead."},
{type: "dialogue", side: "character", speaker: "Elias", text: "Um, I'm not too sure, I'm very busy with work you know?"},
{type: "action", text: "Her heart falls a little, not realising she was holding her breath.", impacts: {anesuGuard: 1}},
{type: "dialogue", side: "player", speaker: "Anesu", text: "I mean yeah, I am too."},
{type: "dialogue", side: "player", speaker: "Higher Power", text: "Yet you can always make the time, can't you?"},
{type: "dialogue", side: "player", speaker: "Anesu", text: "We can always call or something? Doesn't always have to be in person, you know."},
{type: "action", text: "Anesu chuckles lightly and nudges Elias. He smiles weakly."},
{type: "dialogue", side: "character", speaker: "Elias", text: "Yeah, I'm not really a call type of guy."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Well, texting exists. We can always do that."},
{type: "dialogue", side: "character", speaker: "Elias", text: "Mhmmm."},
{type: "action", text: "He smiles softly once again, but the eyes don't have it."},
{type: "thought", text: "Anesu keeps her eyes trained to the nature strip to her left, nervous about... well, that's just it. About it all."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Oh, just pull up down here, I can walk up."},
{type: "action", text: "She quickly undoes her buckle and faces Elias, gleaming."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "I had such a wonderful time with you last night."},
{type: "dialogue", side: "player", speaker: "Higher Power", text: "Come on man, just smile at her."},
{type: "action", text: "Elias turns up the corners of his mouth. There's a difference.", impacts: {anesuGuard: 1}},
{type: "action", text: "Anesu leans in for a kiss, yet he is pursed. Tight."},
{type: "action", text: "She clambers out, grabbing her bag, making sure to look back at him one more time."},
{type: "dialogue", side: "player", speaker: "Anesu", text: "Drive safe!"},
{type: "action", text: "His eyes remain on the road as he responds."},
{type: "dialogue", side: "character", speaker: "Elias", text: "I will.", time: "8:14am", impacts: {familyAwareness: 0.5}, memoryEntry: {who: "Elias", text: "He's amazing. So sweet. I don't care what anyone says — last night was real."}},
{type: "thought", text: "This walk to the front door is long and dreadful. I fell asleep at his house. I wasn't meant to. It just happened..."},
{type: "choice", side: "player", speaker: "Anesu", text: "Well. Here we fucking go.", dest: "B1C2_04_Argument"}
]>>
