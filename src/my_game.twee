:: B1C1_04_TalkingtoMama {"position":"875,225"}
<<set $sceneBeats to [
  {type: "dialogue", side: "character", speaker: "Mama", text: "You went to a meeting?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Where else could I have possibly gone? I told you exactly where I went."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Just because you told me, it doesn't mean that you went.", impacts: {mamaTrust: -0.5}},
  {type: "action", text: "Her tone is cold, holding a scowl between her brows."},
  {type: "action", text: "Anesu stays fighting her second shoelace."},
  {type: "thought", text: "I shake my head disappointingly but I shouldn't be surprised. Of course she's fucking chastising me. It's only a matter of—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "You reek of cigarettes."},
  {type: "thought", text: "And there it is."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "That's what you came out of bed to tell me? You don't talk to me all day and this is what you say?"},
  {type: "action", text: "Dad appears behind Mama, glasses on the tip of his nose, earphones dangling from his left ear."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "People smoke at meetings all the time hun. She might not have even smoked. At least she is going.", impacts: {dadTrust: 0.5}},
  {type: "thought", text: "Dad always comes in clutch, see he gets it! And he knew I had a few cigarettes, he's not daft; he's just trying to keep the peace."},
  {type: "action", text: "Mama glares at Dad over her shoulder, still unhappy with how this conversation is going."},
  {type: "thought", text: "It's as almost as if we all knew that."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Drop your bag sisi, I'm getting the breathalyser."},
  {type: "action", text: "The air drops. Anesu's eyes dart to Dad, mentally begging him to stop this."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Are we still fucking on this?"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I don't think—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Language!"},
  {type: "dialogue", side: "character", speaker: "Dad", text: "—That is necessary Ruby, she just came back from a meeting. I saw Er—", interrupted: true},
  {type: "dialogue", side: "character", speaker: "Mama", text: "JUST BECAUSE she said she went, does NOT MEAN she did so."},
  {type: "action", text: "Mama trods off to get the breathalyser. Anesu and Dad stand in the hallway, blankly staring at one another."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I went to the meeting, Dad."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "I know you did... she's just worried about you."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No matter what I do, it's never gonna fucking matter, man. She's never gonna believe me. She doesn't even like me."},
  {type: "thought", text: "I think back to the drive to rehab, the longest and blurriest 67 minutes of my life. I do not recommend going to rehab in a hungover, drunken haze. Go with complete autonomy."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "You know that isn't true, come on now. She loves you."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "You didn't hear the way she said it, Dad. She said, \"I. Don't. Like. You.\""},
  {type: "action", text: "Mama comes back to the hallway with a fresh mouthpiece and a torch."},
  {type: "thought", text: "I roll my eyes and stand in a T position, looking Dad dead in the eyes while she frisks me for the 9th time this week. I watch her eyes judge me all over. Go on Ruby, breathe in that cigarette smoke."},
  {type: "dialogue", side: "character", speaker: "Dad", text: "Where the hell would she hide booze on her?"},
  {type: "thought", text: "I watch him squint once more, not because of the hour of the night, but to check if his eyes didn't deceive him. But yes, this is his wife. Frisking their 20 year old in a dark hallway. And unfortunately, I am their daughter."},
  {type: "dialogue", side: "character", speaker: "Mama", text: "Okay, now get ready to blow. Blow i—", interrupted: true},
  {type: "thought", text: "I don't want to fucking do this. \"Your mama loves you\", what the fuck does Erin know?"},
  {type: "action", text: "Should Anesu..."},
  {type: "choice", side: "character", speaker: "Higher Power", label: $playerName, text: "Deny?", dest: "B1C1_04_DenyReveal"},
  {type: "action", text: "or..."},
  {type: "choice", side: "character", speaker: "Higher Power", label: $playerName, text: "Comply?", dest: "B1C1_04_ComplyReveal"},
  {type: "action", text: "or..."},
  {type: "choice", side: "character", speaker: "Higher Power", label: $playerName, text: "Compromise?", dest: "B1C1_04_CompromiseReveal"}
]>>

