	"zoom": 1
}


:: Story Stylesheet [stylesheet]
/* ============================================================
   IMPORTS & PALETTE
   ============================================================ */
@import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

:root {
  --bg-main: #182d09;
  --bg-panel: #2a3d14;
  --text-main: #cdc19f;
  --text-muted: #a89f82;
  --accent-thought: #9fb8ad;
  --accent-thought-dim: #6d8078;
}

body.scene-night {
  --bg-main: #10151f;
  --bg-panel: #1b2433;
  --text-main: #c7ccd6;
  --text-muted: #8891a0;
}

/* ============================================================
   BASE / LAYOUT LOCK / CURSOR
   ============================================================ */
html, body {
  height: 100%;
  overflow: hidden;
}

body {
  background-color: var(--bg-main);
  color: var(--text-main);
  font-family: 'VT323', monospace;
  font-size: 1.4em;
  line-height: 1.6;
  cursor: url('https://i.imgur.com/wzWTLc0.png') 1 1, auto;
}

* {
  box-sizing: border-box;
}

a, .dialogue-prompt a, .chat-line a, .select-row a, .scene-nav a, .continue-link a {
  cursor: url('https://i.imgur.com/4IkfO8y.png') 8 2, pointer;
}

tw-story a.link-internal { text-decoration: none; }

/* ============================================================
   SIDEBAR / UI BAR / STORY TITLE
   ============================================================ */
#story-title {
  font-size: 1em;
  letter-spacing: 1px;
}

#story {
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  margin: 0 !important;
  margin-left: clamp(10em, 13vw, 15em) !important;
  padding: 0.5em clamp(1em, 2vw, 2em);
  transition: none !important;
}

#ui-bar-toggle {
  display: none !important;
}

#ui-bar {
  width: clamp(10em, 13vw, 15em) !important;
  background-color: #2b2420;
  border-right: 1px solid var(--text-main);
}

#angel-status {
  margin-top: 1.5em;
  padding-top: 1em;
  border-top: 1px solid var(--text-muted);
  text-align: left;
}

.status-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 0.8em;
}

.status-label {
  font-size: 0.7em;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
}

.status-value {
  font-size: 1em;
  color: var(--text-main);
}

.status-sub {
  font-size: 0.75em;
  color: var(--text-muted);
}

/* ============================================================
   TOP-RIGHT SCREEN CLOCK
   ============================================================ */
#screen-clock {
  position: fixed;
  top: 1em;
  right: 1.5em;
  text-align: right;
  z-index: 100;
  pointer-events: none;
}

#screen-clock .clock-time {
  font-size: 1.3em;
  color: var(--text-main);
  letter-spacing: 1px;
}

#screen-clock .clock-date {
  font-size: 0.75em;
  color: var(--text-muted);
  margin-top: 0.1em;
}

/* ============================================================
   TITLE / MENU SCREENS
   ============================================================ */
.menu-screen {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin-left: clamp(6em, 7.5vw, 10em);
  width: 90%;
  max-width: 700px;
}

.menu-text {
  min-height: 3em;
}

.menu-text p {
  max-width: 32em;
  margin: 0 0 1.2em 0;
}

.menu-title {
  font-size: 2em;
  letter-spacing: 1px;
  margin-bottom: 0.5em;
}

.menu-subtitle a, .continue-link a {
  font-size: 1.3em;
  color: var(--text-main);
}

.menu-subtitle a:hover, .continue-link a:hover {
  color: var(--text-muted);
}

.dialogue-box {
  width: 100%;
  max-width: 600px;
  min-height: 200px;
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: 2em;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

#dialogueLine {
  display: block;
  text-align: center;
}

#dialoguePrompt {
  display: block;
  text-align: center;
  margin-top: 1.5em;
}

/* ============================================================
   QUOTE BOX (AA Big Book passages)
   ============================================================ */
.quote-box {
  width: 100%;
  max-width: 750px;
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: 2.5em 3em;
  margin: 0 auto;
  text-align: left;
  line-height: 1.7;
}

.quote-box p {
  margin: 0 0 1.2em 0;
}

.quote-box .quote-prompt {
  text-align: center;
  margin-top: 1em;
}

/* ============================================================
   MEMBER SELECTION (split-screen carousel)
   ============================================================ */
.split-screen {
  display: flex;
  gap: clamp(0.5em, 1.5vw, 1.5em);
  justify-content: flex-start;
  align-items: flex-start;
  margin: clamp(1em, 2vh, 2em) 0 clamp(1em, 2vh, 2em) clamp(1em, 2vw, 2em);
}

.scene-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.scene-box {
  width: clamp(500px, 82vh, 950px);
  height: clamp(350px, 70vh, 820px);
  border: 3px dashed var(--text-main);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 1em;
  text-align: center;
}

.scene-box img, .speaker-box img {
  width: 80%;
  max-width: 200px;
  image-rendering: pixelated;
  margin-bottom: 0.5em;
}

.scene-nav {
  margin-top: 1em;
  display: flex;
  justify-content: center;
  gap: 3em;
}

.scene-nav a {
  font-size: 1.6em;
  color: var(--text-main);
  text-decoration: none;
}

.scene-nav a:hover {
  color: var(--text-muted);
}

.card-box {
  width: clamp(500px, 82vh, 950px);
  height: clamp(600px, 88vh, 950px);
  border: 3px dashed var(--text-main);
  padding: clamp(0.5em, 1vw, 0.8em);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
 
}

.card-box {
  overflow-y: auto;
  overflow-x: hidden;

}

.card-box .card-field {
  flex-shrink: 0;
  border-bottom: 1px dashed var(--text-muted);
  padding: 0.05em 0;
  margin: 0 -0.6em;
  padding-left: 0.3em;
  padding-right: 0.3em;
  color: var(--text-muted);
  font-size: 0.75em;
  line-height: 1.3;
}

.card-box .card-field br {
  display: none;
}

.card-box .card-story {
  flex-shrink: 1;
  min-height: 300px;
  flex-grow: 1;
  border-top: 1px dashed var(--text-muted);
  margin-top: 0.5em;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 0.8em;
  box-sizing: border-box;
}

.card-box .card-story::-webkit-scrollbar {
  width: 8px;
}

.card-box .card-story::-webkit-scrollbar-track {
  background: transparent;
}

.card-box .card-story::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
}

.card-label {
  font-size: 0.75em;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0em;
}

.select-row {
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 0.5em;
  text-align: center;
}

.select-row a {
  color: var(--text-main);
  font-size: 1.1em;
}

.select-row a:hover {
  color: var(--text-muted);
}

.locked-label {
  color: #666;
  font-size: 1em;
  letter-spacing: 1px;
}

.new-badge {
  display: inline-block;
  background-color: #c0453f;
  color: #fff;
  font-size: 0.65em;
  padding: 0.15em 0.5em;
  border-radius: 3px;
  letter-spacing: 1px;
  margin-left: 0.5em;
  vertical-align: middle;
}

/* ============================================================
   OPENING LAYOUT WRAPPER + NARRATIVE BOX (shared by scenes)
   ============================================================ */
.opening-layout {
  width: calc(100% - 2em);
  max-width: 1700px;
  height: calc(100vh - 1em);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

.opening-meeting {
  width: 95%;
  max-width: 1400px;
}

.narrative-box {
  width: 100%;
  max-width: 650px;
  margin: 0 auto 0.5em;
  flex-shrink: 0;
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: clamp(0.5em, 1.5vh, 1em) clamp(1em, 2vw, 2em);
  text-align: center;
  font-size: clamp(0.8em, 1.2vw, 1em);
}

.narrative-box .meeting-time {
  font-size: 0.9em;
  color: var(--text-muted);
  margin-bottom: 0.5em;
}

/* ============================================================
   CONVERSATION ROW (two-speaker face-to-face scenes)
   ============================================================ */
.conversation-row {
  display: flex;
  align-items: stretch;
  gap: clamp(0.5em, 1.5vw, 1.5em);
  flex: 1 1 auto;
  min-height: 0;
}

.conversation-row.solo {
  justify-content: center;
}

.conversation-row.solo .chat-log {
  width: 700px;
  flex-grow: 0;
}

.speaker-box {
  width: clamp(90px, 12vw, 260px);
  height: 100%;
  border: 3px dashed var(--text-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: clamp(0.65em, 1vw, 0.9em);
  text-align: center;
  flex-shrink: 0;
  opacity: 0.4;
  transition: opacity 0.3s ease;
}

.speaker-box.speaking {
  opacity: 1;
}

.speaker-name {
  color: inherit;
}

.chat-log {
  flex-grow: 1;
  height: 100%;
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: clamp(0.8em, 1.5vw, 1.5em);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  gap: 1em;
}

.chat-log::-webkit-scrollbar {
  width: 8px;
}

.chat-log::-webkit-scrollbar-track {
  background: transparent;
}

.chat-log::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
}

/* ============================================================
   CHAT LINE TYPES (dialogue / action / thought / spacer / citation)
   ============================================================ */
.chat-line {
  max-width: 85%;
  padding: 0.6em 1em;
  border-radius: 8px;
}

.chat-line a {
  color: inherit;
  text-decoration: none;
}

.chat-line a:hover {
  color: var(--text-muted);
}

.chat-line.player {
  align-self: flex-start;
  text-align: left;
  background-color: rgba(42, 61, 20, 0.6);
  border: 1px solid var(--text-main);
}

.chat-line.character {
  align-self: flex-end;
  text-align: right;
  background-color: rgba(205, 193, 159, 0.1);
}

.chat-choices {
  margin-top: 1em;
  text-align: center;
}

.chat-action {
  align-self: center;
  max-width: 90%;
  text-align: center;
  font-style: italic;
  color: var(--text-muted);
  font-size: 0.85em;
  margin: 0.3em 0;
}

.chat-spacer {
  height: 1.5em;
}

.chat-citation {
  align-self: center;
  max-width: 90%;
  text-align: center;
  font-style: italic;
  color: var(--text-muted);
  font-size: 0.75em;
  letter-spacing: 0.5px;
  margin: 1.5em 0 0 0;
}

.chat-timestamp {
  font-size: 0.65em;
  color: var(--text-muted);
  margin-top: 0.2em;
  opacity: 0.7;
}

.continue-link {
  align-self: center;
  text-align: center;
  margin-top: 1.5em;
  padding-top: 1em;
}

.continue-link a {
  color: var(--text-main);
  font-size: 1.1em;
  text-decoration: underline;
  text-decoration-color: var(--accent-thought-dim);
  text-underline-offset: 3px;
}

.continue-link a:hover {
  color: var(--text-muted);
}

/* ============================================================
  HYPERLINK COLOURS
   ============================================================ */
.chat-line a, .dialogue-prompt a {
  color: var(--text-main);
  text-decoration: underline;
  text-decoration-color: var(--accent-thought-dim);
  text-underline-offset: 3px;
}

.chat-line a:hover, .dialogue-prompt a:hover {
  color: var(--accent-thought);
}

.expand-text {
  border-bottom: 1px dotted var(--accent-thought-dim);
}

.choice-reveal-group {
  display: flex;
  flex-direction: column;
  gap: 0.3em;
}

.choice-summary {
  padding: 0.4em 0.8em;
  transition: opacity 0.5s ease;
}

/* ============================================================
   THOUGHT BUBBLES (wavy animation)
   ============================================================ */
.chat-thought {
  align-self: flex-start;
  text-align: left;
  font-style: italic;
  color: var(--accent-thought);
  max-width: 75%;
  padding: 0 1em;
  position: relative;
}

.chat-thought .thought-label {
  font-size: 0.75em;
  font-style: normal;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0.2em;
  display: block;
}

.chat-thought .thought-text {
  display: inline-block;
}

.chat-thought .thought-text span {
  display: inline-block;
  animation: thought-wave 2.2s ease-in-out infinite;
}

@keyframes thought-wave {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2px); }
}

/* ============================================================
   PHONE / TEXTING SCENE
   ============================================================ */
.phone-frame {
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 12px;
  padding: 2em 1.5em;
  display: flex;
  flex-direction: column;
  gap: 0.6em;
  min-height: 700px;
  max-height: 700px;
  overflow-y: auto;
}

.phone-frame::-webkit-scrollbar {
  width: 8px;
}

.phone-frame::-webkit-scrollbar-track {
  background: transparent;
}

.phone-frame::-webkit-scrollbar-thumb {
  background-color: var(--text-main);
  border-radius: 4px;
}

.text-sender {
  font-size: 0.65em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.15em;
}

.text-bubble {
  max-width: 65%;
  padding: 0.6em 1em;
  border-radius: 16px;
  font-size: 0.95em;
  line-height: 1.4;
}

.text-bubble.them {
  align-self: flex-start;
  background-color: rgba(205, 193, 159, 0.15);
  border-bottom-left-radius: 4px;
}

.text-bubble.them .text-sender {
  text-align: left;
}

.text-bubble.me {
  align-self: flex-end;
  background-color: rgba(42, 61, 20, 0.85);
  border: 1px solid var(--text-main);
  border-bottom-right-radius: 4px;
}

.text-bubble.me .text-sender {
  text-align: right;
}

.text-bubble .chat-timestamp {
  margin-top: 0.3em;
}

.text-bubble.me .chat-timestamp {
  text-align: right;
}

.ga-interject {
  align-self: center;
  max-width: 85%;
  text-align: center;
  font-style: italic;
  color: var(--accent-thought);
  font-size: 0.85em;
  margin: 0.5em 0;
  padding: 0.4em 0;
  border-top: 1px dashed var(--accent-thought-dim);
  border-bottom: 1px dashed var(--accent-thought-dim);
}

.ga-interject .ga-label {
  display: block;
  font-size: 0.75em;
  font-style: normal;
  letter-spacing: 1px;
  color: var(--accent-thought-dim);
  margin-bottom: 0.2em;
}

/* ============================================================
   TYPED CHOICE / FREE TYPE INPUT
   ============================================================ */
.type-input-row {
  display: flex;
  align-items: center;
  gap: 0.3em;
  padding: 0.6em 1em;
  align-self: flex-start;
  max-width: 85%;
}

.type-caret {
  color: var(--text-main);
  animation: caret-blink 1s step-end infinite;
}

@keyframes caret-blink {
  50% { opacity: 0; }
}

.type-preview {
  color: var(--text-main);
}

.type-hint {
  align-self: flex-start;
  font-size: 0.75em;
  color: var(--text-muted);
  font-style: italic;
  padding-left: 1em;
}

.dialogue-prompt {
  text-align: center;
  margin-top: auto;
  padding-top: 1em;
}

/* ============================================================
   EXPANDABLE (click-to-reveal truth)
   ============================================================ */

.expand-hint {
  font-size: 0.75em;
  color: var(--accent-thought-dim);
  font-style: italic;
}

.expand-text {
  cursor: pointer;
}

.expand-text.expand-locked {
  cursor: default;
  opacity: 0.85;
}

/* ============================================================
   BREATHING SCREEN
   ============================================================ */
@keyframes screen-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.015); }
}

.breathing {
  animation: screen-breathe 4s ease-in-out infinite;
}

/* ============================================================
   MEMORY BANK — TOAST, DIALOG, UNREAD DOT
   ============================================================ */
#memory-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.95);
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.6em 1.2em;
  border-radius: 6px;
  font-size: 0.9em;
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.4s ease;
  z-index: 9999;
}
#memory-toast.visible {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.unread-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  background-color: #c0453f;
  border-radius: 50%;
  margin-left: 0.4em;
  vertical-align: middle;
  animation: dot-pulse 1.5s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.memory-tabs {
  display: flex;
  gap: 1.5em;
  border-bottom: 1px solid var(--text-muted);
  margin-bottom: 1em;
  padding-bottom: 0.5em;
}

.memory-tab {
  cursor: pointer;
  color: var(--text-muted);
  font-size: 0.95em;
  letter-spacing: 0.5px;
}

.memory-tab.active {
  color: var(--text-main);
  border-bottom: 2px solid var(--text-main);
  padding-bottom: 0.3em;
}

#memory-bank-dialog .memory-person {
  border-bottom: 1px dashed var(--text-muted);
  padding: 1em 0;
}

#memory-bank-dialog .memory-person:last-child {
  border-bottom: none;
}

#memory-bank-dialog .memory-person-name {
  font-size: 1.1em;
  color: var(--text-main);
  margin-bottom: 0.3em;
}

#memory-bank-dialog .memory-entry {
  color: var(--text-main);
}

#memory-bank-dialog .memory-date {
  font-size: 0.7em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
}

#memory-bank-dialog .memory-text {
  margin-top: 0.2em;
  font-style: italic;
}

#memory-bank-dialog .memory-history-toggle {
  font-size: 0.75em;
  color: var(--accent-thought-dim);
  cursor: pointer;
  margin-top: 0.5em;
}

#memory-bank-dialog .memory-history {
  margin-top: 0.5em;
  padding-left: 1em;
  border-left: 1px dashed var(--text-muted);
}

#memory-bank-empty {
  color: var(--text-muted);
  font-style: italic;
}

#memory-bank-dialog .quote-entry {
  border-bottom: 1px dashed var(--text-muted);
  padding: 0.8em 0;
}

#memory-bank-dialog .quote-entry:last-child {
  border-bottom: none;
}

#memory-bank-dialog .quote-text {
  font-style: italic;
  color: var(--text-main);
}

#memory-bank-dialog .quote-source {
  font-size: 0.75em;
  color: var(--text-muted);
  margin-top: 0.3em;
}

#memory-bank-dialog .quote-entry {
  cursor: pointer;
}
#memory-bank-dialog .quote-entry:hover .quote-text {
  color: var(--accent-thought);
}
#quote-modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  transition: opacity 0.3s ease;
}
#quote-modal-overlay.visible {
  opacity: 1;
}
#quote-modal {
  background-color: var(--bg-panel);
  border: 3px solid var(--text-main);
  border-radius: 6px;
  padding: 2em 2.5em;
  max-width: 600px;
  width: 90%;
  text-align: left;
  line-height: 1.7;
  transform: scale(0.95);
  transition: transform 0.3s ease;
}
#quote-modal-overlay.visible #quote-modal {
  transform: scale(1);
}
.quote-modal-text {
  font-style: italic;
  color: var(--text-main);
  margin-bottom: 1em;
}
.quote-modal-source {
  font-size: 0.8em;
  color: var(--text-muted);
  margin-bottom: 0.3em;
}
.quote-modal-date {
  font-size: 0.7em;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 1.5em;
}
.quote-modal-close {
  cursor: pointer;
  text-align: center;
  color: var(--text-main);
  border-top: 1px dashed var(--text-muted);
  padding-top: 1em;
}
.quote-modal-close:hover {
  color: var(--text-muted);
}

/* ============================================================
   CLOCK SCENE (Meeting_SerenityPrayer time-skip)
   ============================================================ */
.clock-scene {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400px;
  gap: 1.5em;
}

.clock-label {
  font-size: 1.2em;
  color: var(--text-muted);
  letter-spacing: 1px;
}

.clock-face {
  width: 140px;
  height: 140px;
  border: 4px solid var(--text-main);
  background-color: var(--bg-panel);
  position: relative;
  image-rendering: pixelated;
  box-shadow:
    inset 0 0 0 2px var(--bg-main),
    inset 0 0 0 4px var(--text-main);
}

.clock-hand {
  position: absolute;
  bottom: 50%;
  left: 50%;
  transform-origin: bottom center;
  background-color: var(--text-main);
  image-rendering: pixelated;
}

.clock-hand.hour {
  width: 6px;
  height: 36px;
  margin-left: -3px;
  transform: rotate(210deg);
  transition: transform 2.5s steps(8, end);
}

.clock-hand.minute {
  width: 4px;
  height: 55px;
  margin-left: -2px;
  transform: rotate(90deg);
  transition: transform 2.5s steps(12, end);
}

.clock-hand.hour.advance {
  transform: rotate(240deg);
}

.clock-hand.minute.advance {
  transform: rotate(450deg);
}

.clock-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10px;
  height: 10px;
  background-color: var(--text-main);
  transform: translate(-50%, -50%);
}

.clock-tick {
  position: absolute;
  width: 4px;
  height: 4px;
  background-color: var(--text-muted);
}


/* ============================================================
  SKIP BUTTON (PLAYTESTING)
   ============================================================ */

#skip-toggle {
  position: fixed;
  bottom: 1em;
  right: 1.5em;
  background-color: var(--bg-panel);
  border: 2px solid var(--text-main);
  color: var(--text-main);
  padding: 0.4em 0.9em;
  border-radius: 6px;
  font-family: 'VT323', monospace;
  font-size: 0.85em;
  cursor: pointer;
  z-index: 9999;
  letter-spacing: 1px;
}

#skip-toggle.active {
  background-color: rgba(192, 69, 63, 0.3);
  border-color: #c0453f;
}

/* ============================================================
  AURA
   ============================================================ */
.speaker-box.anesu-glow-low {
  
  box-shadow: 0 0 12px 2px rgba(159, 184, 173, 0.4);
}

.speaker-box.anesu-glow-mid {
  box-shadow: 0 0 16px 4px rgba(192, 150, 80, 0.5);
}

.speaker-box.anesu-glow-high {
  box-shadow: 0 0 20px 6px rgba(192, 69, 63, 0.55);
}


:: Story JavaScript [script]
window.typewriterEffect = function(el, text, speed, onComplete) {
  speed = speed || 25;
  if (window.fastMode) {
    el.textContent = text;
    if (typeof onComplete === "function") onComplete();
    return;
  }
  var i = 0;
  el.textContent = "";
  (function tick() {
    if (i < text.length) {
      el.textContent += text.charAt(i);
      i++;
      setTimeout(tick, speed);
    } else if (typeof onComplete === "function") {
      onComplete();
    }
  })();
};
$(document).on('keydown.spacebarAdvance', function(e) {
  if (e.code === 'Space' || e.key === ' ') {
    var $prompt = $('.dialogue-prompt a, .type-input-row, [id^="freeTypeBubble"]');
    if ($('.dialogue-prompt a').length && !$('.type-input-row').length) {
      e.preventDefault();
      $('.dialogue-prompt a').first().trigger('click');
    }
  }
});
$(document).on(':scene-typing-done', function() {
  var $log = $('#chatLog');
  if (State.variables.beatIndex < State.variables.sceneBeats.length) {
    $log.append('<div class="dialogue-prompt"></div>');
    var $prompt = $log.find('.dialogue-prompt').last();
    var $link = $('<a class="link-internal">▼</a>').appendTo($prompt);
    $link.on('click', function() {
      $prompt.remove();
      Wikifier.wikifyEval('<<advanceScene>>');
    });
  } else if ($('#memberDisplay').length && $('#memberDisplay').css('display') === 'none') {
    $('#memberDisplay').slideDown(400, function() {
      $('html, body').animate({ scrollTop: $('#memberDisplay').offset().top }, 500);
    });
  }
  $log.scrollTop($log[0].scrollHeight);
});
$(document).on(':passagedisplay', function () {
  requestAnimationFrame(function() {
    document.body.style.zoom = 1.0001;
    requestAnimationFrame(function() {
      document.body.style.zoom = 1;
    });
  });
  updateScreenClock();
});
window.updateScreenClock = function() {
  if ($('#screen-clock').length === 0) {
    $('<div id="screen-clock"><div class="clock-time" id="clockTimeDisplay"></div><div class="clock-date" id="clockDateDisplay"></div></div>').appendTo('body');
  }
  $('#clockTimeDisplay').text(State.variables.currentTime || '');
  $('#clockDateDisplay').text(State.variables.currentDate || '');
};
window.updateAngelStatus = function () {
  if ($('#angel-status').length === 0) {
    $('<div id="angel-status"></div>').insertAfter('#menu');
  }
  if ($('#memory-bank-link').length === 0) {
    $('<a id="memory-bank-link" style="display:block; cursor:pointer; margin-top:0.5em;">📖 Memory Bank</a>').insertAfter('#menu');
  }
  var v = State.variables;
  var dot = v.memoryBankUnread ? '<span class="unread-dot"></span>' : '';
  $('#memory-bank-link').html('📖 Memory Bank' + dot);
  $('#memory-bank-link').off('click').on('click', function(){ openMemoryBank(); });
  var html = '';
  html += '<div class="status-row"><span class="status-label">Name</span><span class="status-value">' + (v.playerName || '—') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Assigned Meeting</span><span class="status-value">' + (v.assignedMeeting || '—') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">This Week\'s Person</span><span class="status-value">' + (v.weeksPerson || '—') + (v.weeksPersonSobriety ? ' <span class="status-sub">(' + v.weeksPersonSobriety + ')</span>' : '') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Report To</span><span class="status-value">' + (v.bossName || '????') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Angel Since</span><span class="status-value">\'' + (v.angelSince || '26') + '</span></div>';
  $('#angel-status').html(html);
  updateScreenClock();
};
window.showMemoryToast = function(message) {
  var $toast = $('<div id="memory-toast">' + (message || "The memory bank has been updated") + '</div>');
  $('body').append($toast);
  setTimeout(function(){ $toast.addClass('visible'); }, 10);
  setTimeout(function(){
    $toast.removeClass('visible');
    setTimeout(function(){ $toast.remove(); }, 400);
  }, 2800);
};
window.addMemory = function(who, textOrVariants) {
  if (!State.variables.memoryBank) State.variables.memoryBank = {};
  if (!State.variables.memoryBank[who]) State.variables.memoryBank[who] = [];
  var finalText = textOrVariants;
  if (typeof textOrVariants === "object") {
    var awareness = State.variables.familyAwareness || 0;
    if (awareness >= 6 && textOrVariants.aware) {
      finalText = textOrVariants.aware;
    } else if (awareness >= 3 && textOrVariants.uncertain) {
      finalText = textOrVariants.uncertain;
    } else {
      finalText = textOrVariants.blind;
    }
  }
  State.variables.memoryBank[who].push({
    date: State.variables.currentDate || "",
    time: State.variables.currentTime || "",
    text: finalText
  });
  State.variables.memoryBankUnread = true;
  updateAngelStatus();
  showMemoryToast();
};
window.addQuote = function(shortText, fullText, source) {
  if (!State.variables.quotesUnlocked) State.variables.quotesUnlocked = [];
  State.variables.quotesUnlocked.push({
    shortText: shortText,
    text: fullText,
    source: source,
    date: State.variables.currentDate || ""
  });
  State.variables.memoryBankUnread = true;
  updateAngelStatus();
  showMemoryToast("A quote has been unlocked");
};
function renderQuotesTab() {
  var quotes = State.variables.quotesUnlocked || [];
  if (quotes.length === 0) {
    return '<div id="memory-bank-empty">No quotes found yet.</div>';
  }
  var html = "";
  quotes.forEach(function(q, i){
    html += '<div class="quote-entry" data-index="' + i + '">';
    html += '<div class="quote-text">"' + q.shortText + '"</div>';
    html += '<div class="quote-source">' + q.source + '</div>';
    html += '<div class="memory-date">' + q.date + '</div>';
    html += '</div>';
  });
  return html;
}
window.openMemoryBank = function(startTab) {
  var activeTab = startTab || "people";
  function renderPeopleTab() {
    var bank = State.variables.memoryBank || {};
    var names = Object.keys(bank);
    if (names.length === 0) {
      return '<div id="memory-bank-empty">No one\'s made it into the file yet.</div>';
    }
    var html = "";
    names.forEach(function(who){
      var entries = bank[who];
      var latest = entries[entries.length - 1];
      html += '<div class="memory-person">';
      html += '<div class="memory-person-name">' + who + '</div>';
      html += '<div class="memory-entry latest">';
      html += '<div class="memory-date">' + latest.date + (latest.time ? ' — ' + latest.time : '') + '</div>';
      html += '<div class="memory-text">' + latest.text + '</div>';
      html += '</div>';
      if (entries.length > 1) {
        html += '<div class="memory-history-toggle" data-who="' + who + '">▸ earlier entries (' + (entries.length - 1) + ')</div>';
        html += '<div class="memory-history" id="history-' + who.replace(/\s/g,'') + '" style="display:none;">';
        for (var i = entries.length - 2; i >= 0; i--) {
          html += '<div class="memory-entry">';
          html += '<div class="memory-date">' + entries[i].date + (entries[i].time ? ' — ' + entries[i].time : '') + '</div>';
          html += '<div class="memory-text">' + entries[i].text + '</div>';
          html += '</div>';
        }
        html += '</div>';
      }
      html += '</div>';
    });
    return html;
  }
  function render() {
    var body = activeTab === "people" ? renderPeopleTab() : renderQuotesTab();
    var html = '<div class="memory-tabs">';
    html += '<span class="memory-tab' + (activeTab === "people" ? ' active' : '') + '" data-tab="people">People</span>';
    html += '<span class="memory-tab' + (activeTab === "quotes" ? ' active' : '') + '" data-tab="quotes">Quotes</span>';
    html += '</div>';
    html += '<div class="memory-tab-body">' + body + '</div>';
    Dialog.setup("Memory Bank", "memory-bank-dialog");
    Dialog.wiki(html);
    Dialog.open();
    $('.memory-tab').off('click').on('click', function(){
      activeTab = $(this).data('tab');
      render();
    });
    $('.memory-history-toggle').off('click').on('click', function(){
      $('#history-' + $(this).data('who').replace(/\s/g,'')).toggle();
    });
    $('.quote-entry').off('click').on('click', function(){
      var idx = $(this).data('index');
      openQuoteModal(State.variables.quotesUnlocked[idx]);
    });
  }
  render();
  State.variables.memoryBankUnread = false;
  updateAngelStatus();
};
window.openQuoteModal = function(q) {
  $('#quote-modal-overlay').remove();
  var $overlay = $('<div id="quote-modal-overlay"></div>');
  var $modal = $('<div id="quote-modal"></div>');
  $modal.append('<div class="quote-modal-text">"' + q.text + '"</div>');
  $modal.append('<div class="quote-modal-source">' + q.source + '</div>');
  $modal.append('<div class="quote-modal-date">' + q.date + '</div>');
  $modal.append('<div class="quote-modal-close">Close</div>');
  $overlay.append($modal);
  $('body').append($overlay);
  requestAnimationFrame(function(){ $overlay.addClass('visible'); });
  $overlay.on('click', function(e){
    if (e.target === this) closeQuoteModal();
  });
  $modal.find('.quote-modal-close').on('click', closeQuoteModal);
};
window.closeQuoteModal = function() {
  $('#quote-modal-overlay').removeClass('visible');
  setTimeout(function(){ $('#quote-modal-overlay').remove(); }, 300);
};
window.fastMode = false;
window.setupSkipToggle = function() {
  if ($('#skip-toggle').length) return;
  var $btn = $('<div id="skip-toggle">⏩ Fast Mode: OFF</div>');
  $('body').append($btn);
  $btn.on('click', function() {
    window.fastMode = !window.fastMode;
    $(this).text('⏩ Fast Mode: ' + (window.fastMode ? 'ON' : 'OFF'));
    $(this).toggleClass('active', window.fastMode);
  });
};
$(document).on(':passagedisplay', function() {
  setupSkipToggle();

});

window.clickSound = new Audio('audio/click.mp3');
window.clickSound.volume = 0.5;

$(document).on('click', 'a, .quote-entry, .memory-tab, .memory-history-toggle, .expand-text, #skip-toggle, #memory-bank-link', function() {
  window.clickSound.currentTime = 0;
  window.clickSound.play();
});


