<div id="dialoguePrompt"></div>
</div>

<<run setTimeout(function(){
  typeSequenceLines('titleLines', [
    "There's a place for us... For when our soul is lost to the wind. Where the will is weak and obligation slips away...",
    "They say there is something wrong with us, but we're just like them... like you.",
    "Nobody says it gets easier right away. But you're here and that's the part that counts.",
