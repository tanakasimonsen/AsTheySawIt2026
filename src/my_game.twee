:: 01_Opening_Monologue {"position":"375,75","size":"100,100"}
<<set $currentDate to "Sun, 21 Apr 2024">>
<<set $currentTime to "7:15pm">>
<<set $anesuGuard to 5>>
<<set $familyAwareness to 0>>
<<set $weeksPlayed to 0>>
<<set $elisBlocked to false>>

/*CHARACTER GIFS*/
<<set $characterImages to {
  "Anesu": "https://i.imgur.com/PE4PsVq.gif",
  "Erin": "https://i.imgur.com/A4YV3S2.gif",
  "Mama": "https://i.imgur.com/L16jEVN.gif",
  "Dad": "https://i.imgur.com/DSDJ6Y9.gif",
  "Micah": "https://i.imgur.com/bjzAo97.gif"
}>>

/*UI VARIABLES*/
<<set $playerName to "">>
<<set $assignedMeeting to "">>
<<set $weeksPerson to "—">>
<<set $bossName to "????">>
<<set $angelSince to "26">>

/*AA MEMBERS*/
<<set $members to [
  {name: "Anesu Song", age: "20", sobriety: "6 months", doc: "Alcohol", story: "Struggled with bullying in her childhood and shortly after graduation a short stint with binge drinking, unable to deal with the traumas of racial bullying and exclusion, emotional abuse and a multiple sexual assaults. Now about 6 months into her sobriety after a stint in rehab, Anesu is unsure about this whole sobriety thing, only promising her parents to stop for a year. The bridges are stilled pooled with smoke and rubble, not a rescue team in sight for the fire she flamed herself. Room still checked, bag still searched and any drop in mood sends a spark throughout the familial unit. They say the best part of sobriety is you get your feelings back, but then the worst thing is...you get your feelings back.", unlocked: true, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Martha Bonini", age: "39", sobriety: "3 weeks, 3rd relapse", doc: "Alcohol and prescribed morphine", story: "A full time round the clock carer for her son, Michael, who has just celebrated his 21st birthday.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Erin Ferguson", age: "56", sobriety: "4 years & 4 months", doc: "Alcohol", story: "A lonely widowed woman who doesn't hear from her adult children as she lost them through her addiction and by the time her fourth turned 18, all of them refused to speak to her. She lost her husband 9 years ago to a work related accident, crushed by an automatic roller door. This exacerbated her drinking. Now that she's sober, she wants to talk to her children again, although they couldn't think of anything worse.", unlocked: false, image: "https://i.imgur.com/A4YV3S2.gif", weeksKnown: 0},
  {name: "Franco Pitt", age: "24", sobriety: "Not currently sober", doc: "Alcohol and \"occasionally\" cocaine", story: "A young man new to the corporate world, more specfically, legal. He has spent his 2nd half of life studying trying to work at Australia's finest lawfirm, but once he gets there, he realises how genuinely clueless he is, how little life experience he has and how immature he is when it comes to adversity. He has found himself in a toxic relationship where he struggles to find balance with his percieved overbearing girlfriend, although true, it is excacerbated by his drinking. The girlfriend, more than anything wants Franco but displays her desire for a normal healthy relationship in toxic and self-sabotaging ways. Cheating on her boyfriend, engaging in risky behaviours which turned into a near death incident, causing tension in the home.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 5", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 6", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 7", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 8", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 9", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 10", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 11", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0},
  {name: "Member 12", age: "—", sobriety: "—", doc: "—", story: "Placeholder story.", unlocked: false, image: "https://i.imgur.com/PE4PsVq.gif", weeksKnown: 0}
]>>
<<set $memberIndex to 0>>
/* OPENING MONOLOGUE*/
<div class="menu-screen">
<div class="dialogue-box">
<div id="dialogueLine" class="menu-text">
There's a place for us... For when our soul is lost to the wind. Where the will is weak and obligation slips away...
</div>
<div id="dialoguePrompt">
<<link "▼">>\
<<replace "#dialogueLine">>They say there is something wrong with us, but we're just like them... like you. <</replace>>\
<<replace "#dialoguePrompt">>\
<<link "▼">>\
<<replace "#dialogueLine">>Nobody says it gets easier right away. But you're here and that's the part that counts.<</replace>>\
<<replace "#dialogueLine">>No one said it had to be forever. It only has to be a day..<</replace>>\
<<replace "#dialoguePrompt">>\
<div class="continue-link"><<link "continue" "02_Title_Screen">><</link>></div>\
<</replace>>\
<</link>>\
<</replace>>\
<</link>>
</div>
</div>
</div>


:: 00_Member_Widget [widget] {"position":"1225,0","size":"100,100"}
<<widget "showMembers">>
