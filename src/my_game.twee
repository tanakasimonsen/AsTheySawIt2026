:: V4_ErinCheckIn {"position":"1300,225","size":"100,100"}
<<run $('body').removeClass('scene-night')>>
<<set _matchAnswer to "">>
<<set _matchErinResp to "">>
<<if $v1Ending is "Comply">>
<<set _matchAnswer to "Well yeah, but she started it this time! I didn't say anything harsh or mean! But god damn it, it's infuriating. Then I'm staring at Dad like UM DO SOMETHING. SPEAK UP. HE'S FUCKING CRICKETS.">>
<<set _matchErinResp to "You know she loves you so much. You know that, yeah?">>
<<elseif $v1Ending is "Deny">>
<<set _matchAnswer to "Kind of? Ugh, I mean I denied the breathtest and now I'm kinda regretting it, but I stood up for myself!! It's my body!!">>
<<set _matchErinResp to "Oh honey, it's going to be okay. What did your dad say?">>
<<elseif $v1Ending is "Compromise">>
<<set _matchAnswer to "Not really, there was a little tiff at the door when you dropped me off, but we're chillin.">>
<<set _matchErinResp to "I'm glad you stood your ground, love. You did it in a respectful way... I'm assuming and hoping?">>
<</if>>

<<set $sceneBeats to [
  {type: "dialogue", side: "character", speaker: "Erin", text: "Sooo, how was your week, darlin'?"},
  {type: "thought", text: "She's always been so kind, so loving, yet she's always having an awful time."},
  {type: "expandable", side: "player", speaker: "Anesu", shortText: "Yeah it was good, it was alright.", layers: ["Yeah, fine, I guess.", "Hmmm.", "Mama sucks, Erin."], partialImpacts: {anesuGuard: -0.2}, nudgeImpacts: {anesuGuard: -0.5}, skipImpacts: {anesuGuard: 0.5}},
  {type: "action", text: "Erin faces Anesu, going 60km down the road."},
  {type: "interject", text: "Does she always drive so recklessly?"},
  {type: "thought", text: "Pretty much."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "Oh Su, baby, darlin'."},
  {type: "action", text: "She holds her hand tight, a gentle thumb soothing her."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "What happened?"},
  {type: "thought", text: "She's absolutely lost it, I genuinely do not understand what goes through that woman's mind and it fucks with me on a daily basis."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Ugh, she's too much, Erin, it's constant! When is she going to understand things are genuinely fucking changing! I mean, breath-testing me when I get back from work?"},
  {type: "action", text: "Erin nods deeply, humming in agreement, with care. With understanding."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "Did you end up in a screaming match again?"},
  {type: "action", text: "Anesu is silent, fiddling with her tongue ring."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: _matchAnswer},
  {type: "dialogue", side: "character", speaker: "Erin", text: _matchErinResp},
  {type: "interject", text: "It's time to be honest, Su. Erin is another mother to you."},
  {type: "thought", text: "She'll understand. I think we're all safe here."},
  {type: "expandable", side: "player", speaker: "Anesu", shortText: "Well yeah, I insulted her kinda...", layers: ["Yeah, I insulted her."], partialImpacts: {anesuGuard: -0.2}, nudgeImpacts: {anesuGuard: -0.5}, skipImpacts: {anesuGuard: 0.5}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I was just fucking pissed off. I gave up one of the best things I fucking loved and hauled off to rehab. I did that! I got sober and this is where we're at?!"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I mean, what the fuck, Erin? Why is it so difficult? I'm so tired! Why is being sober so fucking exhausting?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Why is this what people are signing up for??? This is too fucking much! My own mother fighting me about the sobriety she was fighting me about in the first fucking place!!!!", impacts: {familyAwareness: 1}},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "I mean, Dad's been cool, yeah. He tries to help out, but Mama cuts him off if there's a whiff of \"defiance.\""},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "He just speaks to me after the fact. Or tries to hug me or some shit."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "Do you hug him back?"},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "No. I mean, he won't stop, so I might do a light little something."},
  {type: "action", text: "Anesu demonstrates and holds a light grimace."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "You should try and hug him back, love. Of course he loves to hold you. You're his daughter."},
  {type: "dialogue", side: "player", speaker: "Anesu", text: "Hmmhhmm."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "At least do it for me, love. What I'd give to hold my children again. Too many years have gone by.", impacts: {familyAwareness: 0.5}, memoryEntry: {who: "Erin", text: "She said what she'd give to hold her own kids again. She never once made it about herself before. I think that's the first time she's let me see how much it actually costs her to sit in that car and be kind to me instead."}},
  {type: "action", text: "The pair stare at each other, holding longing gazes, reading one another."},
  {type: "typedChoice", options: [
    {text: "Okay. I'll try.", impacts: {anesuGuard: -0.5}},
    {text: "Fine, Erin, you got me.", impacts: {anesuGuard: -0.5}},
    {text: "Yeah okay, aunty, I got you.", impacts: {anesuGuard: -0.5}}
  ]},
  {type: "action", text: "[PLACEHOLDER — a beat resolving/landing the hug moment before Erin moves the conversation on. The scene currently jumps straight from the choice to \"anything else happen this week\" with no reaction shown.]"},
  {type: "dialogue", side: "character", speaker: "Erin", text: "Anything else happen this week??"},
  {type: "interject", text: "Are we mentioning Elias? I feel like that was pretty big..."},
{type: "choice", side: "player", speaker: "Anesu", text: "Yeah... there's actually something.", dest: "V4_ErinCheckIn_EliasReveal"},
{type: "action", text: "or..."},
{type: "choice", side: "player", speaker: "Anesu", text: "Nah, nothing much else.", dest: "V1_AAMessage_01P2"}
]>>
<<set $beatIndex to 0>>

