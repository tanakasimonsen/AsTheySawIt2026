  {type: "dialogue", side: "player", speaker: "Anesu", text: "I know, I know. And then I came home late and Mama—"},
  {type: "action", text: "Anesu stops. Her hand goes to her cheek, almost involuntarily."},
  {type: "dialogue", side: "character", speaker: "Erin", text: "She hit you?", impacts: {familyAwareness: 1}},
