<<if _beat.type is "dialogue">>
<<append _target>><div @class="'chat-line ' + _beat.side + ' font-' + _beat.speaker.toLowerCase().replace(/\s/g,'-')"><div class="chat-speaker">_label</div><span class="type-target"></span></div><</append>>
<<set $beatIndex += 1>>
<<run typewriterEffect($(_target + ' .type-target').last()[0], _beat.text, getTypeSpeed(_beat.speaker, _beat.speed), _beat.speaker, function() {
  if (_beat.interrupted) {
    setTimeout(function(){ Wikifier.wikifyEval('<<advanceScene>>'); }, 200);
  } else {
    $(document).trigger(':scene-typing-done');
  }
})>>

<<else>>
<<set _thisDest to _beat.dest>>
<<append _target>><div @class="'chat-line ' + _beat.side + ' font-' + _beat.speaker.toLowerCase().replace(/\s/g,'-')"><div class="chat-speaker">_label</div></div><</append>>
<<run (function(){
  var dest = _thisDest;
  var linkEl = $('<a class="link-internal">' + _beat.text + '</a>');
  linkEl.on('click', function(){ Engine.play(dest); });
  $(_target + ' .chat-line').last().append(linkEl);
})()>>
<<set $beatIndex += 1>>
