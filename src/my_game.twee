    });
  }
  scrollAllLogs();
});

$(document).on(':passagedisplay', function () {
  requestAnimationFrame(function() {
    document.body.style.zoom = 1.0001;
    requestAnimationFrame(function() {
      document.body.style.zoom = 1;
    });
  });
  updateScreenClock();
  stopAllSounds();
});

window.updateScreenClock = function() {
  if ($('#screen-clock').length === 0) {
    $('<div id="screen-clock"><div class="clock-time" id="clockTimeDisplay"></div><div class="clock-date" id="clockDateDisplay"></div></div>').appendTo('body');
  }
  $('#clockTimeDisplay').text(State.variables.currentTime || '');
  $('#clockDateDisplay').text(State.variables.currentDate || '');
};

window.updateAngelStatus = function () {
  if ($('#angel-status').length === 0) {
    $('<div id="angel-status"></div>').insertAfter('#menu');
  }
  if ($('#memory-bank-link').length === 0) {
   $('<a id="memory-bank-link" style="display:flex; align-items:center; cursor:pointer; margin-top:0.5em;">📖 Memory Bank</a>').insertAfter('#menu');
  }
  var v = State.variables;
  var dot = v.memoryBankUnread ? '<span class="unread-dot"></span>' : '';
  $('#memory-bank-link').html('📖 Memory Bank' + dot);
  $('#memory-bank-link').off('click').on('click', function(){ openMemoryBank(); });
  var html = '';
  html += '<div class="status-row"><span class="status-label">Name</span><span class="status-value">' + (v.playerName || '—') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Assigned Meeting</span><span class="status-value">' + (v.assignedMeeting || '—') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">This Week\'s Person</span><span class="status-value">' + (v.weeksPerson || '—') + (v.weeksPersonSobriety ? ' <span class="status-sub">(' + v.weeksPersonSobriety + ')</span>' : '') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Report To</span><span class="status-value">' + (v.bossName || '????') + '</span></div>';
  html += '<div class="status-row"><span class="status-label">Angel Since</span><span class="status-value">\'' + (v.angelSince || '26') + '</span></div>';
  $('#angel-status').html(html);
  updateScreenClock();
  updateDebugPanel();
};

window.showMemoryToast = function(message) {
  var $toast = $('<div id="memory-toast">' + (message || "The memory bank has been updated") + '</div>');
  $('body').append($toast);
  setTimeout(function(){ $toast.addClass('visible'); }, 10);
  setTimeout(function(){
    $toast.removeClass('visible');
    setTimeout(function(){ $toast.remove(); }, 400);
  }, 2800);
};
window.addMemory = function(who, textOrVariants) {
  if (!State.variables.memoryBank) State.variables.memoryBank = {};
  if (!State.variables.memoryBank[who]) State.variables.memoryBank[who] = [];
  var finalText = textOrVariants;
  if (typeof textOrVariants === "object") {
    var awareness = State.variables.familyAwareness || 0;
    if (awareness >= 6 && textOrVariants.aware) {
      finalText = textOrVariants.aware;
    } else if (awareness >= 3 && textOrVariants.uncertain) {
      finalText = textOrVariants.uncertain;
    } else {
      finalText = textOrVariants.blind;
    }
  }
  State.variables.memoryBank[who].push({
    date: State.variables.currentDate || "",
    time: State.variables.currentTime || "",
    text: finalText
  });
  State.variables.memoryBankUnread = true;
  updateAngelStatus();
  showMemoryToast();
};
window.addQuote = function(shortText, fullText, source) {
  if (!State.variables.quotesUnlocked) State.variables.quotesUnlocked = [];
  State.variables.quotesUnlocked.push({
    shortText: shortText,
    text: fullText,
    source: source,
    date: State.variables.currentDate || ""
  });
  State.variables.memoryBankUnread = true;
  updateAngelStatus();
  showMemoryToast("A quote has been unlocked");
};
function renderQuotesTab() {
  var quotes = State.variables.quotesUnlocked || [];
  if (quotes.length === 0) {
    return '<div id="memory-bank-empty">No quotes found yet.</div>';
  }
  var html = "";
  quotes.forEach(function(q, i){
    html += '<div class="quote-entry" data-index="' + i + '">';
    html += '<div class="quote-text">"' + q.shortText + '"</div>';
    html += '<div class="quote-source">' + q.source + '</div>';
    html += '<div class="memory-date">' + q.date + '</div>';
    html += '</div>';
  });
  return html;
}

function renderFamilyTab() {
  var people = [
    {name: "Mama", value: State.variables.mamaTrust},
    {name: "Dad", value: State.variables.dadTrust},
    {name: "Micah", value: State.variables.micahTrust}
  ];
  var html = "";
  people.forEach(function(p){
    var word = trustAdjective(p.value);
    html += '<div class="memory-person">';
    html += '<div class="memory-person-name">' + p.name + '</div>';
    html += '<div class="family-status">' + word + '</div>';
    html += '</div>';
  });
  return html;
}

window.openMemoryBank = function(startTab) {
  var activeTab = startTab || "people";
  function renderPeopleTab() {
  var bank = State.variables.memoryBank || {};
  var names = Object.keys(bank);
  if (names.length === 0) {
    return '<div id="memory-bank-empty">No one\'s made it into the file yet.</div>';
  }
  var html = "";
  names.forEach(function(who){
    var entries = bank[who];
    var latest = entries[entries.length - 1];
    html += '<div class="memory-person">';
    html += '<div class="memory-person-name">' + who + '</div>';
    html += '<div class="memory-entry latest">';
    html += '<div class="memory-date">' + latest.date + (latest.time ? ' — ' + latest.time : '') + '</div>';
    html += '<div class="memory-text">' + latest.text + '</div>';
    html += '</div>';
    if (entries.length > 1) {
      var previous = entries[entries.length - 2];
      html += '<div class="memory-entry superseded">';
      html += '<div class="memory-date">' + previous.date + (previous.time ? ' — ' + previous.time : '') + '</div>';
      html += '<div class="memory-text">' + previous.text + '</div>';
      html += '</div>';
    }
    if (entries.length > 2) {
      html += '<div class="memory-history-toggle" data-who="' + who + '">▸ earlier entries (' + (entries.length - 2) + ')</div>';
      html += '<div class="memory-history" id="history-' + who.replace(/\s/g,'') + '" style="display:none;">';
      for (var i = entries.length - 3; i >= 0; i--) {
        html += '<div class="memory-entry superseded">';
        html += '<div class="memory-date">' + entries[i].date + (entries[i].time ? ' — ' + entries[i].time : '') + '</div>';
        html += '<div class="memory-text">' + entries[i].text + '</div>';
        html += '</div>';
      }
      html += '</div>';
    }
    html += '</div>';
  });
  return html;
}
  function render() {
  var body = activeTab === "people" ? renderPeopleTab() : activeTab === "family" ? renderFamilyTab() : renderQuotesTab();
  var html = '<div class="memory-tabs">';
  html += '<span class="memory-tab' + (activeTab === "people" ? ' active' : '') + '" data-tab="people">People</span>';
  html += '<span class="memory-tab' + (activeTab === "family" ? ' active' : '') + '" data-tab="family">Family</span>';
  html += '<span class="memory-tab' + (activeTab === "quotes" ? ' active' : '') + '" data-tab="quotes">Quotes</span>';
  html += '</div>';
  html += '<div class="memory-tab-body">' + body + '</div>';
  Dialog.setup("Memory Bank", "memory-bank-dialog");
  Dialog.wiki(html);
  Dialog.open();
  $('.memory-tab').off('click').on('click', function(){
    activeTab = $(this).data('tab');
    render();
  });
  $('.memory-history-toggle').off('click').on('click', function(){
    $('#history-' + $(this).data('who').replace(/\s/g,'')).toggle();
  });
    $('.quote-entry').off('click').on('click', function(){
      var idx = $(this).data('index');
      openQuoteModal(State.variables.quotesUnlocked[idx]);
    });
  }
  render();
  State.variables.memoryBankUnread = false;
  updateAngelStatus();
};

window.openQuoteModal = function(q) {
  $('#quote-modal-overlay').remove();
  var $overlay = $('<div id="quote-modal-overlay"></div>');
  var $modal = $('<div id="quote-modal"></div>');
  $modal.append('<div class="quote-modal-text">"' + q.text + '"</div>');
  $modal.append('<div class="quote-modal-source">' + q.source + '</div>');
  $modal.append('<div class="quote-modal-date">' + q.date + '</div>');
  $modal.append('<div class="quote-modal-close">Close</div>');
  $overlay.append($modal);
  $('body').append($overlay);
  requestAnimationFrame(function(){ $overlay.addClass('visible'); });
  $overlay.on('click', function(e){
    if (e.target === this) closeQuoteModal();
  });
  $modal.find('.quote-modal-close').on('click', closeQuoteModal);
};
window.closeQuoteModal = function() {
  $('#quote-modal-overlay').removeClass('visible');
  setTimeout(function(){ $('#quote-modal-overlay').remove(); }, 300);
};
window.fastMode = false;
window.setupSkipToggle = function() {
  if ($('#skip-toggle').length) return;
  var $btn = $('<div id="skip-toggle">⏩</div>');
  $('body').append($btn);
  $btn.on('click', function() {
    window.fastMode = !window.fastMode;
    $(this).text('⏩' + (window.fastMode ? 'ON' : 'OFF'));
    $(this).toggleClass('active', window.fastMode);
  });
};
$(document).on(':passagedisplay', function() {
  setupSkipToggle();

});

window.gameVolumes = JSON.parse(localStorage.getItem('atsi_volumes') || '{}');
if (window.gameVolumes.sfx === undefined) window.gameVolumes.sfx = 0.6;
if (window.gameVolumes.ambience === undefined) window.gameVolumes.ambience = 0.3;
if (window.gameVolumes.score === undefined) window.gameVolumes.score = 0.5;

window.saveVolumes = function() {
  localStorage.setItem('atsi_volumes', JSON.stringify(window.gameVolumes));
};

window.applyLiveVolumes = function() {
  if (window.currentAmbience && window.currentAmbience._baseVolume !== undefined) {
    window.currentAmbience.volume = window.currentAmbience._baseVolume * window.gameVolumes.ambience;
  }
  if (window.currentScore && window.currentScore._baseVolume !== undefined) {
    window.currentScore.volume = window.currentScore._baseVolume * window.gameVolumes.score;
  }
};

window.setupVolumePanel = function() {
  if ($('#volume-panel').length) return;
  var html = '<div id="volume-panel">';
  html += '<div class="volume-row"><label>SFX</label><input type="range" id="vol-sfx" min="0" max="100" value="' + (gameVolumes.sfx * 100) + '"></div>';
  html += '<div class="volume-row"><label>Ambience</label><input type="range" id="vol-ambience" min="0" max="100" value="' + (gameVolumes.ambience * 100) + '"></div>';
  html += '<div class="volume-row"><label>Score</label><input type="range" id="vol-score" min="0" max="100" value="' + (gameVolumes.score * 100) + '"></div>';
  html += '</div>';
  $('#ui-bar').append(html);

  $('#vol-sfx').on('input', function(){
    gameVolumes.sfx = this.value / 100;
    saveVolumes();
  });
  $('#vol-ambience').on('input', function(){
    gameVolumes.ambience = this.value / 100;
    saveVolumes();
    applyLiveVolumes();
  });
  $('#vol-score').on('input', function(){
    gameVolumes.score = this.value / 100;
    saveVolumes();
    applyLiveVolumes();
  });
};

$(document).on(':passagedisplay', function(){
  setupVolumePanel();
});

window.clickSound = new Audio('audio/click.mp3');
window.clickSound.volume = 0.5;

$(document).on('click', 'a, .quote-entry, .memory-tab, .memory-history-toggle, .expand-text, #skip-toggle, #memory-bank-link', function() {
  window.clickSound.currentTime = 0;
  window.clickSound.volume = 0.5 * gameVolumes.sfx;
  window.clickSound.play();
});

window.activeSounds = [];
window.namedSounds = {};

window.playSound = function(src, volume, id, persist) {
  var sfx = new Audio(src);
  sfx.volume = (volume !== undefined ? volume : 0.6) * gameVolumes.sfx;
  sfx.addEventListener('ended', function() {
    var idx = window.activeSounds.indexOf(sfx);
    if (idx !== -1) window.activeSounds.splice(idx, 1);
    if (id && window.namedSounds[id] === sfx) delete window.namedSounds[id];
  });
  if (!persist) {
    window.activeSounds.push(sfx);
  }
  if (id) {
    window.namedSounds[id] = sfx;
  }
  sfx.play();
};

window.stopAllSounds = function() {
  window.activeSounds.forEach(function(sfx) {
    sfx.pause();
    sfx.currentTime = 0;
  });
  window.activeSounds = [];
};

window.stopNamedSound = function(id) {
  if (window.namedSounds[id]) {
    window.namedSounds[id].pause();
    window.namedSounds[id].currentTime = 0;
    delete window.namedSounds[id];
  }
};

window.currentAmbience = null;

window.setAmbience = function(src, volume) {
  var baseVolume = volume !== undefined ? volume : 0.3;
  if (window.currentAmbience && src && window.currentAmbience.src.indexOf(src) !== -1) {
    return;
  }
  var oldAudio = window.currentAmbience;
  var newAudio = src ? new Audio(src) : null;
  if (newAudio) {
    newAudio.loop = true;
    newAudio.volume = 0;
    newAudio._baseVolume = baseVolume;
    newAudio.addEventListener('ended', function() {
      newAudio.currentTime = 0;
      newAudio.play();
    });
    newAudio.play();
  }
  window.currentAmbience = newAudio;

  var steps = 30;
  var stepTime = 100;
  var i = 0;
  var fadeTimer = setInterval(function() {
    i++;
    if (oldAudio) oldAudio.volume = Math.max(0, (oldAudio._baseVolume || baseVolume) * gameVolumes.ambience * (1 - i / steps));
    if (newAudio) newAudio.volume = Math.min(baseVolume * gameVolumes.ambience, baseVolume * gameVolumes.ambience * (i / steps));
    if (i >= steps) {
      clearInterval(fadeTimer);
      if (oldAudio) { oldAudio.pause(); oldAudio.currentTime = 0; }
    }
  }, stepTime);
};

window.currentScore = null;

window.setScore = function(src, volume) {
  var baseVolume = volume !== undefined ? volume : 0.5;
  if (window.currentScore && src && window.currentScore.src.indexOf(src) !== -1) {
    return;
  }
  var oldAudio = window.currentScore;
  var newAudio = src ? new Audio(src) : null;
  if (newAudio) {
    newAudio.loop = true;
    newAudio.volume = 0;
    newAudio._baseVolume = baseVolume;
    newAudio.addEventListener('ended', function() {
      newAudio.currentTime = 0;
      newAudio.play();
    });
    newAudio.play();
  }
  window.currentScore = newAudio;

  var steps = 30;
  var stepTime = 100;
  var i = 0;
  var fadeTimer = setInterval(function() {
    i++;
    if (oldAudio) oldAudio.volume = Math.max(0, (oldAudio._baseVolume || baseVolume) * gameVolumes.score * (1 - i / steps));
    if (newAudio) newAudio.volume = Math.min(baseVolume * gameVolumes.score, baseVolume * gameVolumes.score * (i / steps));
    if (i >= steps) {
      clearInterval(fadeTimer);
      if (oldAudio) { oldAudio.pause(); oldAudio.currentTime = 0; }
    }
  }, stepTime);
};

window.stopScore = function() {
  setScore(null);
};

window.stopAmbience = function() {
  setAmbience(null);
};

window.getEndingZone = function() {
  var g = State.variables.anesuGuard || 0;
  var a = State.variables.familyAwareness || 0;

  if (g >= 4 && g <= 6) return "middle";
  if (g > 6 && a < 6) return "shutdown";
  if (g > 6 && a >= 6) return "guarded_honest";
  if (g < 4 && a >= 6) return "open_clear";
  if (g < 4 && a < 6) return "open_unsettled";
  return "middle";
};

