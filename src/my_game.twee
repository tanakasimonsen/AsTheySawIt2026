:: SceneEngine [widget] {"position":"1350,0","size":"100,100"}
<<widget "advanceScene">>
<<if $beatIndex lt $sceneBeats.length>>
<<set _beat to $sceneBeats[$beatIndex]>>
<<run $('.dialogue-prompt').remove()>>
<<if _beat.impacts>>
<<run (function(){
  var imp = _beat.impacts;
  for (var key in imp) {
    if (key === "wobble") continue;
    var current = State.variables[key] || 0;
    var wobble = imp.wobble ? (Math.random() * 1.4 - 0.7) : 0;
    var next = current + imp[key] + wobble;
    State.variables[key] = Math.max(0, Math.min(10, next));
  }
  updateAngelStatus();
  var g = State.variables.anesuGuard || 0;
  var leftBoxEl = $('.speaker-box').first();
  leftBoxEl.removeClass('anesu-glow-low anesu-glow-mid anesu-glow-high');
  if (g >= 7) { leftBoxEl.addClass('anesu-glow-high'); }
  else if (g >= 4) { leftBoxEl.addClass('anesu-glow-mid'); }
  else { leftBoxEl.addClass('anesu-glow-low'); }
})()>>
<</if>>
<<if _beat.time>>
<<run (function(){
  State.variables.currentTime = _beat.time;
  updateAngelStatus();
})()>>
<</if>>


<<if _beat.sound>>
